{
  "name": "boxstar-omc-bootstrap",
  "version": "0.1.0",
  "description": "Sovereign Roblox Bootstrap - Contract-First Agentic Governance",
  "main": "bin/ag-skills.cjs",
  "type": "module",
  "scripts": {
    "test": "mocha --config .mocharc.json",
    "report:mocha": "mocha --reporter mochawesome --reporter-options reportDir=docs/reports/mocha,reportFilename=mochawesome",
    "bridge:start": "cd bridge && npm start",
    "skills:list": "node bin/ag-skills.cjs list",
    "bootstrap": "bash bootstrap.sh"
  },
  "dependencies": {
    "ajv": "^8.12.0",
    "zod": "^3.22.4",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "mocha": "^11.0.1",
    "chai": "^4.3.10",
    "mochawesome": "^7.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "@types/node": "^20.11.0",
    "@types/mocha": "^10.0.6",
    "@types/chai": "^4.3.11"
  }
}
