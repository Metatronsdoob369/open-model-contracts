# Open Notebook - Local Memory Spine Configuration (Patched for Internal Auth)

# API Configuration
API_URL=http://localhost:5055
INTERNAL_API_URL=http://localhost:5055

# Database (SQLite for local deployment)
DATABASE_URL=sqlite:///data/open_notebook.db

# SurrealDB Handshake 
SURREALDB_URL=surrealdb://localhost:8000
SURREALDB_NS=notebook
SURREALDB_DB=notebook

# AI Providers
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b

# Vector Search
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text

# Storage
STORAGE_PATH=/data
MAX_UPLOAD_SIZE=500

# Security (Auth intentionally omitted for internal socket trust)
SECRET_KEY=640f4553366511fd4f21dd6d70e1619b84efdd9897aba5d6f0049bfde5b99062
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5055

# Features
ENABLE_PODCAST_GENERATION=true
TARS_MEMORY_ENABLED=true
LOG_LEVEL=info
