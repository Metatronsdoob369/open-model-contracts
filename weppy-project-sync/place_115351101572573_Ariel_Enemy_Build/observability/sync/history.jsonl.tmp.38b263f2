{"timestamp":"2026-05-07T08:00:40.356Z","type":"write","direction":"forward","source":"studio","path":"game.ServerScriptService.SetDuskLighting","details":"script:Script","diff":{"type":"script","scriptMeta":{"beforeLines":21,"afterLines":30},"scriptDiff":{"beforeSource":"-- Temporary dusk lighting for hawk visibility testing\n-- Runs after a delay to override MetropolisLighting (ClockTime=0)\nlocal Lighting = game:GetService(\"Lighting\")\n\nlocal function setDusk()\n\tLighting.ClockTime      = 18.5\n\tLighting.Brightness     = 3\n\tLighting.Ambient        = Color3.fromRGB(80, 60, 90)\n\tLighting.OutdoorAmbient = Color3.fromRGB(140, 100, 70)\n\tLighting.FogEnd         = 100000  -- push fog out to eliminate horizon band\n\tLighting.FogStart       = 90000\n\t-- Remove midnight skybox so default dusk sky shows\n\tlocal sky = Lighting:FindFirstChildOfClass(\"Sky\")\n\tif sky then sky:Destroy() end\n\tprint(\"[LIGHTING] Dusk set — ClockTime 18.5\")\nend\n\n-- Run immediately and again after 2s to beat MetropolisLighting\nsetDusk()\ntask.delay(2, setDusk)\n","afterSource":"-- Dusk lighting — overrides MetropolisLighting midnight setting\nlocal Lighting = game:GetService(\"Lighting\")\n\nlocal function setDusk()\n\tLighting.ClockTime      = 18.5\n\tLighting.Brightness     = 2\n\tLighting.Ambient        = Color3.fromRGB(80, 60, 90)\n\tLighting.OutdoorAmbient = Color3.fromRGB(140, 100, 70)\n\tLighting.FogEnd         = 100000\n\tLighting.FogStart       = 90000\n\tLighting.FogColor       = Color3.fromRGB(10, 10, 20)  -- match night sky, kills orange band\n\n\t-- Tame bloom — neon dance floor was blowing out the scene\n\tfor _, effect in ipairs(Lighting:GetChildren()) do\n\t\tif effect:IsA(\"BloomEffect\") then\n\t\t\teffect.Intensity = 0.3\n\t\t\teffect.Size      = 14\n\t\t\teffect.Threshold = 2.5  -- only bloom very bright emissives\n\t\tend\n\tend\n\n\t-- Remove midnight skybox\n\tlocal sky = Lighting:FindFirstChildOfClass(\"Sky\")\n\tif sky then sky:Destroy() end\n\tprint(\"[LIGHTING] Dusk set — bloom tamed\")\nend\n\nsetDusk()\ntask.delay(2, setDusk)\n"}},"contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
{"timestamp":"2026-05-07T08:02:50.328Z","type":"write","direction":"forward","source":"studio","path":"game.ServerScriptService.__TMP_WhereAmI","details":"props","contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
{"timestamp":"2026-05-07T08:02:50.329Z","type":"write","direction":"forward","source":"studio","path":"game.ServerScriptService.__TMP_WhereAmI","details":"script:Script","diff":{"type":"script","scriptMeta":{"beforeLines":null,"afterLines":20},"scriptDiff":{"beforeSource":null,"afterSource":"local Players = game:GetService(\"Players\")\ntask.wait(4)\nfor _, p in ipairs(Players:GetPlayers()) do\n\tlocal hrp = p.Character and p.Character:FindFirstChild(\"HumanoidRootPart\")\n\tif hrp then\n\t\tprint(string.format(\"[POS] %s at (%.0f, %.0f, %.0f)\", p.Name, hrp.Position.X, hrp.Position.Y, hrp.Position.Z))\n\tend\nend\nfor _, obj in ipairs(workspace:GetDescendants()) do\n\tif obj:IsA(\"Model\") and (obj.Name == \"AerialHawk\" or obj.Name == \"Crawler\" or obj.Name == \"Titan\") then\n\t\tlocal hrp = obj:FindFirstChild(\"HumanoidRootPart\")\n\t\tif hrp then\n\t\t\tprint(string.format(\"[ENEMY] %s at (%.0f, %.0f, %.0f)\", obj.Name, hrp.Position.X, hrp.Position.Y, hrp.Position.Z))\n\t\tend\n\tend\n\tif obj:IsA(\"Part\") and string.sub(obj.Name, 1, 7) == \"Pickup_\" then\n\t\tprint(string.format(\"[PICKUP] %s at (%.0f, %.0f, %.0f)\", obj.Name, obj.Position.X, obj.Position.Y, obj.Position.Z))\n\tend\nend\n"}},"contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
