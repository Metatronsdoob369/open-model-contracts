{"timestamp":"2026-05-07T07:36:40.340Z","type":"write","direction":"forward","source":"studio","path":"game.ServerScriptService.OMC_Ignition.Source.MetropolisGovernance","details":"script:ModuleScript","diff":{"type":"script","scriptMeta":{"beforeLines":null,"afterLines":42},"scriptDiff":{"beforeSource":null,"afterSource":"--[=[\n    MetropolisGovernance.luau\n    Status: PROTOCOL | Diamond-Stable\n    OMC Room: OMC_Governance\n    Law Compliance: Scheduler §3, Contract Mirroring §1\n    \n    The Central Governance Engine for the Metropolis Intelligence Hub.\n    Handles error registration, state validation, and \"Shatter\" detection.\n]=]\n\nlocal MetropolisGovernance = {}\n\nlocal IssueLog = {}\n\n-- [SCHEDULER] Law §3: Errors must surface to OMC_Governance\nfunction MetropolisGovernance.RegisterIssue(category, description, severity)\n    local timestamp = os.date(\"%Y-%m-%dT%H:%M:%S\")\n    local entry = {\n        Timestamp = timestamp,\n        Category = category,\n        Description = description,\n        Severity = severity or \"LOW\"\n    }\n    \n    table.insert(IssueLog, entry)\n    \n    -- Print to console as spectral telemetry\n    print(string.format(\"● [GOVERNANCE:%s] %s | %s\", entry.Severity, entry.Category, entry.Description))\nend\n\nfunction MetropolisGovernance.GetRecentIssues()\n    return IssueLog\nend\n\n-- Monitor for \"Shatter\" conditions\nfunction MetropolisGovernance.AuditState(roomName, stateTable)\n    -- Compare against 3072-D IntentSignatures\n    -- Placeholder for Qdrant validation logic\nend\n\nreturn MetropolisGovernance\n"}},"contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
{"timestamp":"2026-05-07T07:36:40.341Z","type":"write","direction":"forward","source":"studio","path":"game.ServerScriptService.OMC_Ignition.Source.SovereignClientRouter","details":"props","contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
{"timestamp":"2026-05-07T07:36:40.342Z","type":"write","direction":"forward","source":"studio","path":"game.ServerScriptService.OMC_Ignition.Source.SovereignClientRouter","details":"script:ModuleScript","diff":{"type":"script","scriptMeta":{"beforeLines":null,"afterLines":205},"scriptDiff":{"beforeSource":null,"afterSource":"--[=[\n    SovereignClientRouter.luau\n    Status: PROTOCOL | Governed-Bridge\n    OMC Room: OMC_Governance -> Client_Visual\n    Law Compliance: Contract Mirroring §1, Bridge Throttling §4\n    \n    Hardened 4D-compliant bridge for executing queries on the client.\n    Handles player lifecycles, execution contracts, and governance reporting.\n]=]\n\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal HttpService = game:GetService(\"HttpService\")\n\n-- Infrastructure Anchors\nlocal OMC = ReplicatedStorage:WaitForChild(\"OMC\")\nlocal Generated = OMC:WaitForChild(\"Generated\")\nlocal Telemetry = require(Generated:WaitForChild(\"Telemetry\"))\nlocal Governance = require(script.Parent:WaitForChild(\"MetropolisGovernance\"))\n\nlocal PREFIX = \"🏮 [SOVEREIGN-BRIDGE]\"\nlocal MIN_LEAVE_TIME_MS = 500 -- 4D QuadMap Guard: Enforce minimum hold on disconnect\n\nlocal SovereignClientRouter = {}\nSovereignClientRouter.__index = SovereignClientRouter\n\nfunction SovereignClientRouter.new(remoteFunction)\n\tlocal self = setmetatable({}, SovereignClientRouter)\n\t\n\t-- Establish consistent relay identity\n\tself._remoteFunction = remoteFunction or ReplicatedStorage:FindFirstChild(\"SovereignRelay\")\n\tif not self._remoteFunction then\n\t\tself._remoteFunction = Instance.new(\"RemoteFunction\")\n\t\tself._remoteFunction.Name = \"SovereignRelay\"\n\t\tself._remoteFunction.Parent = ReplicatedStorage\n\tend\n\t\n\tself._pendingRequests = {} -- [requestId] = { thread, player }\n\tself._lastExecutionTime = {} -- [player] = os.clock() temporal anchor\n\tself._executiveClient = nil\n\t\n\t-- Lifecycle Monitoring: Sweep fractures when players disconnect\n\tPlayers.PlayerRemoving:Connect(function(player)\n\t\t-- 4D Temporal Guard: If player has pending requests, enforce a minimum leave window \n\t\t-- to allow near-simultaneous bridge resolution to land.\n\t\ttask.spawn(function()\n\t\t\tlocal hasPending = false\n\t\t\tfor _, info in pairs(self._pendingRequests) do\n\t\t\t\tif info.player == player then\n\t\t\t\t\thasPending = true\n\t\t\t\t\tbreak\n\t\t\t\tend\n\t\t\tend\n\n\t\t\tif hasPending then\n\t\t\t\ttask.wait(MIN_LEAVE_TIME_MS / 1000)\n\t\t\tend\n\n\t\t\tif self._executiveClient == player then\n\t\t\t\tself._executiveClient = nil\n\t\t\t\tGovernance.RegisterIssue(\"BRIDGE_FRACTURE\", \"Executive Client disconnected: \" .. player.Name, \"MEDIUM\")\n\t\t\tend\n\t\t\t\n\t\t\tself:_sweepPlayer(player)\n\t\tend)\n\tend)\n\n\tprint(PREFIX, \"Governed Bridge Established. Room: OMC_Governance -> Client_Visual\")\n\treturn self\nend\n\n-- Set the authoritative client for governor queries\nfunction SovereignClientRouter:setExecutiveClient(player)\n\tself._executiveClient = player\n\tprint(PREFIX, \"Executive Client anchored to: \" .. player.Name)\nend\n\n-- internal: sweep requests for a specific player\nfunction SovereignClientRouter:_sweepPlayer(player)\n\tfor requestId, info in pairs(self._pendingRequests) do\n\t\tif info.player == player then\n\t\t\twarn(PREFIX, \"Force-terminating request \" .. requestId .. \" (Player Disconnected)\")\n\t\t\tself._pendingRequests[requestId] = nil\n\t\tend\n\tend\n\tself._lastExecutionTime[player] = nil\nend\n\n-- Execute a client-side expression via Governed Bridge.\n-- Enforces Contract Mirroring §1\nfunction SovereignClientRouter:execute(code, targetPlayer, timeout)\n\t-- 1. Selection & Validation\n\tlocal player = targetPlayer or self._executiveClient or Players:GetPlayers()[1]\n\t\n\tif not player then\n\t\tGovernance.RegisterIssue(\"BRIDGE_FAILURE\", \"No connected clients found for bridging\", \"HIGH\")\n\t\treturn { success = false, error = \"NO_CLIENT_CONNECTED\" }\n\tend\n\n\t-- 2. Contract Check (Sanity)\n\tif type(code) ~= \"string\" or #code == 0 then\n\t\treturn { success = false, error = \"CONTRACT_VIOLATION: Empty or invalid code\" }\n\tend\n\n\t-- 2.5 4D Temporal Throttling Guard\n\tlocal now = os.clock()\n\tlocal lastExec = self._lastExecutionTime[player] or 0\n\tlocal THROTTLE_RATE = 0.45 -- 450ms minimum temporal spacing\n\t\n\tif (now - lastExec) < THROTTLE_RATE then\n\t\tGovernance.RegisterIssue(\"TEMPORAL_FRACTURE\", \"Bridge rate exceeded for \" .. player.Name .. \". AI Hallucination detected (Span < \" .. THROTTLE_RATE .. \"s)\", \"HIGH\")\n\t\treturn { success = false, error = \"THROTTLE_VIOLATION: Temporal overlap detected. Code rejected.\" }\n\tend\n\t\n\tself._lastExecutionTime[player] = now\n\n\tlocal requestId = HttpService:GenerateGUID(false)\n\ttimeout = timeout or 10\n\n\t-- 3. Pre-flight Telemetry\n\tTelemetry.dispatchPulse({\n\t\tevent = \"Bridge_Query_Start\",\n\t\trequestId = requestId,\n\t\tsourceRoom = \"OMC_Governance\",\n\t\ttargetRoom = \"Client_Visual\",\n\t\ttargetPlayer = player.Name\n\t})\n\n\tlocal finished = false\n\tlocal clientResult = nil\n\tlocal signal = Instance.new(\"BindableEvent\")\n\tlocal currentThread = task.spawn(function()\n\t\tlocal ok, result = pcall(function()\n\t\t\treturn self._remoteFunction:InvokeClient(player, {\n\t\t\t\trequestId = requestId,\n\t\t\t\tcode = code,\n\t\t\t})\n\t\tend)\n\n\t\tif finished then return end\n\n\t\tif ok then\n\t\t\tclientResult = result\n\t\telse\n\t\t\tclientResult = { success = false, error = \"INVOKE_FAILURE: \" .. tostring(result) }\n\t\tend\n\n\t\tfinished = true\n\t\tsignal:Fire()\n\tend)\n\n\t-- Register for lifecycle tracking\n\tself._pendingRequests[requestId] = { thread = currentThread, player = player }\n\n\t-- 4. Governed Timeout\n\ttask.delay(timeout, function()\n\t\tif not finished then\n\t\t\tfinished = true\n\t\t\tGovernance.RegisterIssue(\"BRIDGE_TIMEOUT\", \"Client query timed out for \" .. requestId, \"MEDIUM\")\n\t\t\tclientResult = { success = false, error = \"TIMEOUT_EXCEEDED\" }\n\t\t\tsignal:Fire()\n\t\tend\n\tend)\n\n\t-- Wait for resolution\n\tsignal.Event:Wait()\n\tsignal:Destroy()\n\t\n\t-- Cleanup\n\tself._pendingRequests[requestId] = nil\n\n\t-- 5. Normalize & Log Result\n\tlocal finalResponse = self:_normalizeResult(clientResult)\n\t\n\tTelemetry.dispatchPulse({\n\t\tevent = \"Bridge_Query_End\",\n\t\trequestId = requestId,\n\t\tsuccess = finalResponse.success,\n\t\tlatency = finalResponse.data.executionTime\n\t})\n\n\tif not finalResponse.success then\n\t\tGovernance.RegisterIssue(\"CLIENT_ERROR\", finalResponse.error, \"LOW\")\n\tend\n\n\treturn finalResponse\nend\n\nfunction SovereignClientRouter:_normalizeResult(res)\n\tif type(res) ~= \"table\" then\n\t\treturn { success = false, error = \"MALFORMED_RESPONSE\", data = { output = tostring(res), executionTime = 0 } }\n\tend\n\t\n\treturn {\n\t\tsuccess = res.success == true,\n\t\tdata = {\n\t\t\toutput = res.output or res.data or \"\",\n\t\t\texecutionTime = res.data and res.data.executionTime or res.executionTime or 0,\n\t\t},\n\t\terror = res.error\n\t}\nend\n\nreturn SovereignClientRouter\n"}},"contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
{"timestamp":"2026-05-07T07:36:40.343Z","type":"write","direction":"forward","source":"studio","path":"game.ServerScriptService.OMC_Ignition.Source.TagControl","details":"props","contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
{"timestamp":"2026-05-07T07:36:40.344Z","type":"write","direction":"forward","source":"studio","path":"game.ServerScriptService.OMC_Ignition.Source.TagControl","details":"script:ModuleScript","diff":{"type":"script","scriptMeta":{"beforeLines":null,"afterLines":112},"scriptDiff":{"beforeSource":null,"afterSource":"--[=[\n    TagControl.luau\n    Status: MANIFESTED | Diamond-Stable\n    OMC Room: ROOM-01_LocalState / OMC_Governance\n    Law Compliance: Scheduler §1, Contract Mirroring §1\n    \n    The Sovereign Gameplay Mechanic: TAG.\n    Handles 'It' state management and distance-based resonance.\n]=]\n\nlocal game = game\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal ServerScriptService = game:GetService(\"ServerScriptService\")\n\nlocal Global = require(ServerScriptService:WaitForChild(\"Global\"))\nlocal Debug = require(ReplicatedStorage:WaitForChild(\"Debug\"))\nlocal Utils = ReplicatedStorage:WaitForChild(\"Utils\")\nlocal traceCapture = require(Utils:WaitForChild(\"TraceCapture\"))\n\n-- [TRACE] Start load sequence\ntraceCapture:record(\"scriptLoad\")\n\nlocal TagControl = {\n    _CURRENT_IT = nil,\n    _TAG_COOLDOWN = 1.5,\n    _TAG_RADIUS = 6.0,\n    _LAST_TAG_TIME = 0\n}\n\n-- [OMC BRIDGE] SafeFire Injection for Tag Persistence\nlocal function RegisterTagEvent(attacker, victim)\n    -- This is where the 4D Sequencer would normally inject the SafeFire wrapper. \n    -- For this assembly, we implement the hardened bridge directly.\n    local payload = {\n        type = \"playerAction\",\n        timestamp = os.clock(),\n        playerId = attacker.UserId,\n        action = \"tag_success\",\n        payload = {\n            victimId = victim.UserId,\n            location = (attacker.Character and attacker.Character.PrimaryPart.Position) or Vector3.new(0,0,0)\n        }\n    }\n    \n    -- Simulate the SafeFire call to the OMC bridge\n    Debug.Log(string.format(\"[TagControl] CROSS-ROOM SIGNAL: %s tagged %s\", attacker.Name, victim.Name))\n    traceCapture:record(\"tag_event_sent\")\n    -- Bridge_PlayerAction:SafeFire(payload)\nend\n\nfunction TagControl.SetNewIt(player)\n    if TagControl._CURRENT_IT == player then return end\n    \n    TagControl._CURRENT_IT = player\n    Debug.Log(string.format(\"[TagControl] Manifested New 'It': %s\", player.Name))\n    \n    -- Visual Feedback Infill (Placeholder)\n    if player.Character then\n        local highlight = Instance.new(\"Highlight\")\n        highlight.Name = \"ShatterHighlight\"\n        highlight.FillColor = Color3.fromRGB(255, 0, 0)\n        highlight.Parent = player.Character\n    end\nend\n\nfunction TagControl.CheckProximity(itPlayer)\n    if not itPlayer.Character or not itPlayer.Character:FindFirstChild(\"HumanoidRootPart\") then return end\n    \n    local now = os.clock()\n    if now - TagControl._LAST_TAG_TIME < TagControl._TAG_COOLDOWN then return end\n    \n    local itPos = itPlayer.Character.HumanoidRootPart.Position\n    \n    for _, player in ipairs(Players:GetPlayers()) do\n        if player ~= itPlayer and player.Character and player.Character:FindFirstChild(\"HumanoidRootPart\") then\n            local pPos = player.Character.HumanoidRootPart.Position\n            local dist = (itPos - pPos).Magnitude\n            \n            if dist <= TagControl._TAG_RADIUS then\n                TagControl.ProcessTag(itPlayer, player)\n                break\n            end\n        end\n    end\nend\n\nfunction TagControl.ProcessTag(attacker, victim)\n    TagControl._LAST_TAG_TIME = os.clock()\n    \n    -- Perform the state rotation\n    TagControl.SetNewIt(victim)\n    \n    -- Canonical Governance Logging\n    traceCapture:record(\"tag_processed\")\n    RegisterTagEvent(attacker, victim)\nend\n\n-- [SCHEDULER] Monitor proximity on Heartbeat (15 Hz logic cap)\nlocal lastUpdate = 0\ngame:GetService(\"RunService\").Heartbeat:Connect(function()\n    local now = os.clock()\n    if now - lastUpdate < (1 / 15) then return end\n    lastUpdate = now\n    \n    if TagControl._CURRENT_IT and TagControl._CURRENT_IT.Parent then\n        TagControl.CheckProximity(TagControl._CURRENT_IT)\n    end\nend)\n\nreturn TagControl\n"}},"contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
{"timestamp":"2026-05-07T07:36:40.345Z","type":"write","direction":"forward","source":"studio","path":"game.ServerScriptService.OMC_Ignition.Source.TagGameService","details":"props","contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
{"timestamp":"2026-05-07T07:36:40.347Z","type":"write","direction":"forward","source":"studio","path":"game.ServerScriptService.OMC_Ignition.Source.TagGameService","details":"script:ModuleScript","diff":{"type":"script","scriptMeta":{"beforeLines":null,"afterLines":416},"scriptDiff":{"beforeSource":null,"afterSource":"local Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\nlocal ServerScriptService = game:GetService(\"ServerScriptService\")\n\nlocal OMC = ReplicatedStorage:WaitForChild(\"OMC\")\nlocal Generated = OMC:WaitForChild(\"Generated\")\nlocal Telemetry = require(Generated:WaitForChild(\"Telemetry\"))\nlocal VictimService = require(script.Parent:WaitForChild(\"VictimService\"))\n\nlocal function CreateBridge(name)\n\tlocal remote = ReplicatedStorage:FindFirstChild(name) or Instance.new(\"RemoteEvent\")\n\tremote.Name = name\n\tremote.Parent = ReplicatedStorage\n\treturn {\n\t\tFireAll = function(...) remote:FireAllClients(...) end,\n\t\t_remote = remote,\n\t}\nend\n\nlocal TagGameService = {\n\tName = \"TagGameService\",\n\tConfig = {\n\t\tROUND_DURATION = 300,\n\t\tINTERMISSION = 3,\n\t\tMONSTER_TAG_DISTANCE = 6.8,\n\t\tPLAYER_TAG_DISTANCE = 9,\n\t\tPLAYER_TAG_COOLDOWN = 0.4,\n\t\tMONSTER_TAG_COOLDOWN = 0.85,\n\t\tPOST_ROUND_DELAY = 8,\n\t},\n\tBridges = {\n\t\tGameUpdate = CreateBridge(\"OMC_TagUpdate\"),\n\t},\n\tState = {\n\t\tactive = false,\n\t\tparticipants = {},\n\t\talivePlayers = {},\n\t\troundEndAt = 0,\n\t\theartbeatConn = nil,\n\t\tlastMonsterTagAt = {},\n\t\tlastPlayerTagAt = {},\n\t},\n}\n\nlocal function getRootFromModel(model)\n\tif not model then return nil end\n\tif model:IsA(\"Model\") then\n\t\treturn model:FindFirstChild(\"HumanoidRootPart\") or model.PrimaryPart\n\tend\n\treturn nil\nend\n\nlocal function getPlayerRoot(player)\n\tlocal character = player and player.Character\n\tif not character then return nil end\n\treturn character:FindFirstChild(\"HumanoidRootPart\")\nend\n\nlocal function monsterKey(monster)\n\tlocal id = monster and monster:GetAttribute(\"MonsterId\")\n\tif id then\n\t\treturn tostring(id)\n\tend\n\treturn monster and monster.Name or \"unknown\"\nend\n\nlocal function formatTime(seconds)\n\tlocal sec = math.max(0, math.floor(seconds))\n\tlocal m = math.floor(sec / 60)\n\tlocal s = sec % 60\n\treturn string.format(\"%d:%02d\", m, s)\nend\n\nlocal function showStatusUI(text)\n\tfor _, player in ipairs(Players:GetPlayers()) do\n\t\tlocal gui = player:FindFirstChild(\"PlayerGui\")\n\t\tif gui then\n\t\t\tlocal sg = gui:FindFirstChild(\"Sovereign_GameUI\")\n\t\t\tif not sg then\n\t\t\t\tsg = Instance.new(\"ScreenGui\")\n\t\t\t\tsg.Name = \"Sovereign_GameUI\"\n\t\t\t\tsg.ResetOnSpawn = false\n\t\t\t\tsg.Parent = gui\n\t\t\t\tlocal txt = Instance.new(\"TextLabel\")\n\t\t\t\ttxt.Name = \"Status\"\n\t\t\t\ttxt.Size = UDim2.new(0, 220, 0, 46)\n\t\t\t\ttxt.Position = UDim2.new(1, -232, 0, 20)\n\t\t\t\ttxt.BackgroundTransparency = 0.25\n\t\t\t\ttxt.BackgroundColor3 = Color3.fromRGB(15, 15, 25)\n\t\t\t\ttxt.TextColor3 = Color3.fromRGB(245, 245, 245)\n\t\t\t\ttxt.TextSize = 20\n\t\t\t\ttxt.Font = Enum.Font.GothamBold\n\t\t\t\ttxt.Parent = sg\n\t\t\t\tInstance.new(\"UICorner\", txt).CornerRadius = UDim.new(0, 8)\n\t\t\t\tlocal stroke = Instance.new(\"UIStroke\", txt)\n\t\t\t\tstroke.Color = Color3.fromRGB(200, 30, 30)\n\t\t\t\tstroke.Thickness = 1.5\n\t\t\tend\n\t\t\tsg.Enabled = true\n\t\t\tsg.Status.Text = text\n\t\tend\n\tend\nend\n\nlocal function clearStatusUI()\n\tfor _, player in ipairs(Players:GetPlayers()) do\n\t\tlocal gui = player:FindFirstChild(\"PlayerGui\")\n\t\tif gui then\n\t\t\tlocal sg = gui:FindFirstChild(\"Sovereign_GameUI\")\n\t\t\tif sg then\n\t\t\t\tsg:Destroy()\n\t\t\tend\n\t\tend\n\tend\nend\n\nlocal function showResultsUI(titleText, survivors)\n\tfor _, player in ipairs(Players:GetPlayers()) do\n\t\tlocal gui = player:FindFirstChild(\"PlayerGui\")\n\t\tif not gui then continue end\n\n\t\tlocal old = gui:FindFirstChild(\"Sovereign_ResultsUI\")\n\t\tif old then old:Destroy() end\n\n\t\tlocal sg = Instance.new(\"ScreenGui\")\n\t\tsg.Name = \"Sovereign_ResultsUI\"\n\t\tsg.ResetOnSpawn = false\n\t\tsg.Parent = gui\n\n\t\tlocal panel = Instance.new(\"Frame\")\n\t\tpanel.Size = UDim2.new(0, 420, 0, 320)\n\t\tpanel.Position = UDim2.new(0.5, 0, 0.5, 0)\n\t\tpanel.AnchorPoint = Vector2.new(0.5, 0.5)\n\t\tpanel.BackgroundColor3 = Color3.fromRGB(10, 10, 20)\n\t\tpanel.BackgroundTransparency = 0.08\n\t\tpanel.Parent = sg\n\t\tInstance.new(\"UICorner\", panel).CornerRadius = UDim.new(0, 12)\n\t\tlocal stroke = Instance.new(\"UIStroke\", panel)\n\t\tstroke.Color = Color3.fromRGB(255, 80, 80)\n\t\tstroke.Thickness = 2\n\n\t\tlocal title = Instance.new(\"TextLabel\")\n\t\ttitle.Size = UDim2.new(1, 0, 0, 56)\n\t\ttitle.Position = UDim2.new(0, 0, 0, 12)\n\t\ttitle.BackgroundTransparency = 1\n\t\ttitle.Text = titleText\n\t\ttitle.TextColor3 = Color3.fromRGB(255, 220, 220)\n\t\ttitle.TextSize = 28\n\t\ttitle.Font = Enum.Font.GothamBold\n\t\ttitle.Parent = panel\n\n\t\tlocal header = Instance.new(\"TextLabel\")\n\t\theader.Size = UDim2.new(1, -20, 0, 26)\n\t\theader.Position = UDim2.new(0, 10, 0, 78)\n\t\theader.BackgroundTransparency = 1\n\t\theader.Text = #survivors > 0 and \"Survivors:\" or \"No survivors.\"\n\t\theader.TextColor3 = Color3.fromRGB(220, 220, 220)\n\t\theader.TextSize = 16\n\t\theader.Font = Enum.Font.GothamMedium\n\t\theader.TextXAlignment = Enum.TextXAlignment.Left\n\t\theader.Parent = panel\n\n\t\tfor i, name in ipairs(survivors) do\n\t\t\tlocal row = Instance.new(\"TextLabel\")\n\t\t\trow.Size = UDim2.new(1, -30, 0, 24)\n\t\t\trow.Position = UDim2.new(0, 15, 0, 104 + ((i - 1) * 26))\n\t\t\trow.BackgroundTransparency = 1\n\t\t\trow.Text = \"- \" .. name\n\t\t\trow.TextColor3 = Color3.fromRGB(170, 255, 170)\n\t\t\trow.TextSize = 16\n\t\t\trow.Font = Enum.Font.Gotham\n\t\t\trow.TextXAlignment = Enum.TextXAlignment.Left\n\t\t\trow.Parent = panel\n\t\tend\n\tend\nend\n\nlocal function clearResultsUI()\n\tfor _, player in ipairs(Players:GetPlayers()) do\n\t\tlocal gui = player:FindFirstChild(\"PlayerGui\")\n\t\tif gui then\n\t\t\tlocal sg = gui:FindFirstChild(\"Sovereign_ResultsUI\")\n\t\t\tif sg then sg:Destroy() end\n\t\tend\n\tend\nend\n\nfunction TagGameService:_setPlayerRoundAlive(player, alive)\n\tplayer:SetAttribute(\"OMC_RoundAlive\", alive and true or false)\n\tif alive then\n\t\tself.State.alivePlayers[player.UserId] = true\n\telse\n\t\tself.State.alivePlayers[player.UserId] = nil\n\tend\nend\n\nfunction TagGameService:_getAlivePlayers()\n\tlocal alive = {}\n\tfor userId in pairs(self.State.alivePlayers) do\n\t\tlocal player = Players:GetPlayerByUserId(userId)\n\t\tif player and player.Parent == Players then\n\t\t\tlocal root = getPlayerRoot(player)\n\t\t\tif root then\n\t\t\t\ttable.insert(alive, player)\n\t\t\telse\n\t\t\t\tself:_setPlayerRoundAlive(player, false)\n\t\t\tend\n\t\tend\n\tend\n\treturn alive\nend\n\nfunction TagGameService:_killPlayer(player)\n\tif not player or not self.State.alivePlayers[player.UserId] then return end\n\tself:_setPlayerRoundAlive(player, false)\n\tlocal hum = player.Character and player.Character:FindFirstChildOfClass(\"Humanoid\")\n\tif hum then\n\t\thum.Health = 0\n\tend\n\tself.Bridges.GameUpdate:FireAll(\"PLAYER_DOWN\", player.Name)\nend\n\nfunction TagGameService:_killMonster(monster)\n\tif not monster or monster:GetAttribute(\"Alive\") == false then return end\n\tVictimService:KillMonster(monster)\n\tself.Bridges.GameUpdate:FireAll(\"MONSTER_DOWN\", monster.Name)\nend\n\nfunction TagGameService:_evaluateContacts()\n\tlocal alivePlayers = self:_getAlivePlayers()\n\tlocal aliveMonsters = VictimService:GetAliveMonsters()\n\tif #alivePlayers == 0 or #aliveMonsters == 0 then return end\n\n\tlocal now = os.clock()\n\tfor _, monster in ipairs(aliveMonsters) do\n\t\tlocal mRoot = getRootFromModel(monster)\n\t\tif mRoot then\n\t\t\tfor _, player in ipairs(alivePlayers) do\n\t\t\t\tlocal pRoot = getPlayerRoot(player)\n\t\t\t\tif pRoot then\n\t\t\t\t\tlocal dist = (mRoot.Position - pRoot.Position).Magnitude\n\t\t\t\t\tif dist <= self.Config.PLAYER_TAG_DISTANCE then\n\t\t\t\t\t\tlocal pKey = string.format(\"%d:%s\", player.UserId, monsterKey(monster))\n\t\t\t\t\t\tlocal lastPlayerTag = self.State.lastPlayerTagAt[pKey] or 0\n\t\t\t\t\t\tif (now - lastPlayerTag) >= self.Config.PLAYER_TAG_COOLDOWN then\n\t\t\t\t\t\t\tself.State.lastPlayerTagAt[pKey] = now\n\t\t\t\t\t\t\tself:_killMonster(monster)\n\t\t\t\t\t\t\tbreak\n\t\t\t\t\t\tend\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\n\taliveMonsters = VictimService:GetAliveMonsters()\n\tfor _, monster in ipairs(aliveMonsters) do\n\t\tlocal mRoot = getRootFromModel(monster)\n\t\tif mRoot then\n\t\t\tfor _, player in ipairs(self:_getAlivePlayers()) do\n\t\t\t\tlocal pRoot = getPlayerRoot(player)\n\t\t\t\tif pRoot then\n\t\t\t\t\tlocal dist = (mRoot.Position - pRoot.Position).Magnitude\n\t\t\t\t\tif dist <= self.Config.MONSTER_TAG_DISTANCE then\n\t\t\t\t\t\tlocal mKey = string.format(\"%s:%d\", monsterKey(monster), player.UserId)\n\t\t\t\t\t\tlocal lastMonsterTag = self.State.lastMonsterTagAt[mKey] or 0\n\t\t\t\t\t\tif (now - lastMonsterTag) >= self.Config.MONSTER_TAG_COOLDOWN then\n\t\t\t\t\t\t\tself.State.lastMonsterTagAt[mKey] = now\n\t\t\t\t\t\t\tself:_killPlayer(player)\n\t\t\t\t\t\tend\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\nend\n\nfunction TagGameService:_collectSurvivors()\n\tlocal survivors = {}\n\tfor _, player in ipairs(Players:GetPlayers()) do\n\t\tif player:GetAttribute(\"OMC_RoundAlive\") then\n\t\t\ttable.insert(survivors, player.Name)\n\t\tend\n\tend\n\treturn survivors\nend\n\nfunction TagGameService:_endRound(result)\n\tif not self.State.active then return end\n\tself.State.active = false\n\tlocal survivors = self:_collectSurvivors()\n\n\tif self.State.heartbeatConn then\n\t\tself.State.heartbeatConn:Disconnect()\n\t\tself.State.heartbeatConn = nil\n\tend\n\n\tVictimService:StopRound()\n\n\tfor _, player in ipairs(Players:GetPlayers()) do\n\t\tself:_setPlayerRoundAlive(player, false)\n\tend\n\n\tclearStatusUI()\n\tshowResultsUI(result, survivors)\n\n\tself.Bridges.GameUpdate:FireAll(\"ROUND_END\", result)\n\tTelemetry.dispatchPulse({ event = \"RoundEnd\", result = result })\n\n\tlocal roundEndedEvent = ServerScriptService:FindFirstChild(\"OMC_RoundEnded\")\n\tif roundEndedEvent and roundEndedEvent:IsA(\"BindableEvent\") then\n\t\troundEndedEvent:Fire(result)\n\tend\n\n\ttask.delay(self.Config.POST_ROUND_DELAY, function()\n\t\tclearResultsUI()\n\t\tfor _, player in ipairs(Players:GetPlayers()) do\n\t\t\tlocal char = player.Character\n\t\t\tlocal root = char and char:FindFirstChild(\"HumanoidRootPart\")\n\t\t\tif root then\n\t\t\t\troot.CFrame = _G.LobbySpawnCF or CFrame.new(0, 40, 0)\n\t\t\tend\n\t\tend\n\tend)\nend\n\nfunction TagGameService:_tickRound()\n\tif not self.State.active then return end\n\n\tself:_evaluateContacts()\n\n\tif VictimService:AreAllMonstersDead() then\n\t\tself:_endRound(\"Survivors Win - All Monsters Eliminated\")\n\t\treturn\n\tend\n\n\tlocal alivePlayers = self:_getAlivePlayers()\n\tif #alivePlayers == 0 then\n\t\tself:_endRound(\"Monsters Win - All Players Eliminated\")\n\t\treturn\n\tend\n\n\tlocal remaining = math.max(0, self.State.roundEndAt - os.clock())\n\tshowStatusUI(\"Survive: \" .. formatTime(remaining))\n\tif remaining <= 0 then\n\t\tself:_endRound(\"Survivors Win - Time Expired\")\n\tend\nend\n\nfunction TagGameService:StartRound(launchedUserIds)\n\tif self.State.active then return end\n\n\tself.State.participants = {}\n\tself.State.alivePlayers = {}\n\tself.State.lastMonsterTagAt = {}\n\tself.State.lastPlayerTagAt = {}\n\n\tfor _, player in ipairs(Players:GetPlayers()) do\n\t\tlocal include = true\n\t\tif type(launchedUserIds) == \"table\" then\n\t\t\tinclude = false\n\t\t\tfor _, userId in ipairs(launchedUserIds) do\n\t\t\t\tif userId == player.UserId then\n\t\t\t\t\tinclude = true\n\t\t\t\t\tbreak\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\t\tif include then\n\t\t\tself.State.participants[player.UserId] = true\n\t\t\tself:_setPlayerRoundAlive(player, true)\n\t\telse\n\t\t\tself:_setPlayerRoundAlive(player, false)\n\t\tend\n\tend\n\n\tself.State.active = true\n\tself.State.roundEndAt = os.clock() + self.Config.ROUND_DURATION\n\n\tshowStatusUI(\"Round Starting...\")\n\ttask.wait(self.Config.INTERMISSION)\n\n\tVictimService:StartRound()\n\n\tif self.State.heartbeatConn then\n\t\tself.State.heartbeatConn:Disconnect()\n\tend\n\tself.State.heartbeatConn = RunService.Heartbeat:Connect(function()\n\t\tself:_tickRound()\n\tend)\n\n\tself.Bridges.GameUpdate:FireAll(\"ROUND_START\", self.Config.ROUND_DURATION)\n\tTelemetry.dispatchPulse({ event = \"RoundStart\", duration = self.Config.ROUND_DURATION })\n\tprint(\"[TAG] Round started.\")\nend\n\nfunction TagGameService:Init()\n\tprint(\"[TAG] Service initialized.\")\nend\n\nfunction TagGameService:Start()\n\tlocal gameBegin = ServerScriptService:WaitForChild(\"OMC_Lobby_GameBegin\", 30)\n\tif gameBegin and gameBegin:IsA(\"BindableEvent\") then\n\t\tgameBegin.Event:Connect(function(launchedUserIds)\n\t\t\tif not self.State.active then\n\t\t\t\ttask.spawn(function()\n\t\t\t\t\tself:StartRound(launchedUserIds)\n\t\t\t\tend)\n\t\t\tend\n\t\tend)\n\tend\nend\n\nreturn TagGameService\n"}},"contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
