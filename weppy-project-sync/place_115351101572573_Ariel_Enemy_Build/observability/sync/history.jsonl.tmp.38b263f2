{"timestamp":"2026-05-07T07:36:39.220Z","type":"write","direction":"forward","source":"studio","path":"game.ServerStorage.MonsterTemplate.Health","details":"props","contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
{"timestamp":"2026-05-07T07:36:39.220Z","type":"write","direction":"forward","source":"studio","path":"game.ServerStorage.MonsterTemplate.Health","details":"script:Script","diff":{"type":"script","scriptMeta":{"beforeLines":null,"afterLines":21},"scriptDiff":{"beforeSource":null,"afterSource":"-- Gradually regenerates the Humanoid's Health over time.\n\nlocal REGEN_RATE = 1 / 100 -- Regenerate this fraction of MaxHealth per second.\nlocal REGEN_STEP = 1 -- Wait this long between each regeneration step.\n\n--------------------------------------------------------------------------------\n\nlocal Character = script.Parent\nlocal Humanoid = Character:WaitForChild(\"Humanoid\")\n\n--------------------------------------------------------------------------------\n\nwhile true do\n\twhile Humanoid.Health < Humanoid.MaxHealth and Humanoid.Health > 0 and Humanoid:GetState() ~= Enum.HumanoidStateType.Dead do\n\t\tlocal dt = wait(REGEN_STEP)\n\t\tlocal dh = dt * REGEN_RATE * Humanoid.MaxHealth\n\t\tHumanoid.Health = math.min(Humanoid.Health + dh, Humanoid.MaxHealth)\n\tend\n\tHumanoid.HealthChanged:Wait()\nend\n"}},"contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
{"timestamp":"2026-05-07T07:36:39.221Z","type":"write","direction":"forward","source":"studio","path":"game.ServerStorage.MonsterTemplate.Humanoid","details":"props","diff":{"type":"props","changedProperties":{"RigType":{"before":null,"after":"Enum.HumanoidRigType.R15"},"WalkSpeed":{"before":null,"after":8},"BreakJointsOnDeath":{"before":null,"after":false},"NameDisplayDistance":{"before":null,"after":0},"DisplayDistanceType":{"before":null,"after":"Enum.HumanoidDisplayDistanceType.Subject"},"HipHeight":{"before":null,"after":3}}},"contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
