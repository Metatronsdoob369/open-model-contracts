{"timestamp":"2026-05-07T07:36:40.362Z","type":"write","direction":"forward","source":"studio","path":"game.ServerScriptService.__TMP_SetDusk","details":"script:Script","diff":{"type":"script","scriptMeta":{"beforeLines":null,"afterLines":9},"scriptDiff":{"beforeSource":null,"afterSource":"local Lighting = game:GetService(\"Lighting\")\nLighting.ClockTime = 18.5\nLighting.Brightness = 2\nLighting.Ambient = Color3.fromRGB(80, 60, 90)\nLighting.OutdoorAmbient = Color3.fromRGB(120, 80, 60)\nLighting.FogColor = Color3.fromRGB(180, 120, 80)\nLighting.FogEnd = 2000\nprint(\"[LIGHTING] Dusk set — ClockTime 18.5\")\n"}},"contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
