{"timestamp":"2026-05-07T07:52:29.677Z","type":"write","direction":"forward","source":"studio","path":"game.ServerScriptService.SpitballService~4","details":"script:Script","diff":{"type":"script","scriptMeta":{"beforeLines":null,"afterLines":140},"scriptDiff":{"beforeSource":null,"afterSource":"-- =============================================================================\n-- SpitballService\n-- Handles spitball projectile firing. Arcing projectile, AOE on impact.\n-- Damages enemies only (no PvP). Consumes OMC_SpitballCharges attribute.\n-- =============================================================================\n\nlocal Players    = game:GetService(\"Players\")\nlocal Debris     = game:GetService(\"Debris\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal SPITBALL_CFG = {\n\tspeed      = 60,    -- studs/s launch speed\n\tgravity    = 35,    -- arc gravity\n\tradius     = 6,     -- AOE blast radius studs\n\tdamage     = 45,    -- damage per hit\n\tsize       = 1.2,   -- ball size\n\tlifetime   = 8,     -- seconds before cleanup\n}\n\nlocal function ensureRemote(name, class)\n\tlocal evts = ReplicatedStorage:FindFirstChild(\"OMC\")\n\t\tand ReplicatedStorage.OMC:FindFirstChild(\"Events\")\n\tif not evts then return end\n\tlocal r = evts:FindFirstChild(name)\n\tif r then return r end\n\tr = Instance.new(class)\n\tr.Name = name\n\tr.Parent = evts\n\treturn r\nend\n\n-- Wait for OMC events folder\nlocal eventsFolder\nlocal attempts = 0\nrepeat\n\ttask.wait(0.5)\n\tattempts += 1\n\tlocal omc = ReplicatedStorage:FindFirstChild(\"OMC\")\n\teventsFolder = omc and omc:FindFirstChild(\"Events\")\nuntil eventsFolder or attempts > 20\n\nif not eventsFolder then\n\twarn(\"[SPITBALL] Events folder not found — service aborted\")\n\treturn\nend\n\nlocal SpitballFire = Instance.new(\"RemoteEvent\")\nSpitballFire.Name   = \"SpitballFire\"\nSpitballFire.Parent = eventsFolder\n\nSpitballFire.OnServerEvent:Connect(function(player, origin, direction)\n\tlocal char = player.Character\n\tlocal hum  = char and char:FindFirstChildOfClass(\"Humanoid\")\n\tif not hum then return end\n\n\t-- Check charges\n\tlocal charges = hum:GetAttribute(\"OMC_SpitballCharges\") or 0\n\tif charges <= 0 then return end\n\thum:SetAttribute(\"OMC_SpitballCharges\", charges - 1)\n\n\t-- Create projectile\n\tlocal ball = Instance.new(\"Part\")\n\tball.Name        = \"Spitball\"\n\tball.Shape       = Enum.PartType.Ball\n\tball.Size        = Vector3.new(SPITBALL_CFG.size, SPITBALL_CFG.size, SPITBALL_CFG.size)\n\tball.BrickColor  = BrickColor.new(\"Bright green\")\n\tball.Material    = Enum.Material.Neon\n\tball.Transparency = 0.2\n\tball.CanCollide  = true\n\tball.Anchored    = false\n\tball.CFrame      = CFrame.new(origin)\n\tball.Parent      = workspace\n\n\tDebris:AddItem(ball, SPITBALL_CFG.lifetime)\n\n\t-- Launch with arc\n\tlocal bv = Instance.new(\"BodyVelocity\")\n\tbv.Velocity  = direction.Unit * SPITBALL_CFG.speed\n\tbv.MaxForce  = Vector3.new(1e4, 1e4, 1e4)\n\tbv.Parent    = ball\n\n\t-- Apply gravity arc\n\tlocal bg = Instance.new(\"BodyForce\")\n\tbg.Force  = Vector3.new(0, -workspace.Gravity * ball:GetMass() * (SPITBALL_CFG.gravity / workspace.Gravity), 0)\n\tbg.Parent = ball\n\n\tlocal hit = false\n\tball.Touched:Connect(function(other)\n\t\tif hit then return end\n\t\t-- Ignore the shooter\n\t\tif other:IsDescendantOf(char) then return end\n\t\t-- Ignore other players\n\t\tlocal otherPlayer = Players:GetPlayerFromCharacter(other.Parent)\n\t\tif otherPlayer then return end\n\n\t\thit = true\n\t\tball:Destroy()\n\n\t\t-- AOE blast — damage all enemies within radius\n\t\tlocal blastPos = ball.Position\n\t\tfor _, obj in ipairs(workspace:GetDescendants()) do\n\t\t\tif obj:IsA(\"Humanoid\") and obj.Health > 0 then\n\t\t\t\tlocal rootPart = obj.Parent and obj.Parent:FindFirstChild(\"HumanoidRootPart\")\n\t\t\t\tif rootPart then\n\t\t\t\t\tlocal dist = (rootPart.Position - blastPos).Magnitude\n\t\t\t\t\tif dist <= SPITBALL_CFG.radius then\n\t\t\t\t\t\t-- Don't damage players\n\t\t\t\t\t\tlocal isPlayer = false\n\t\t\t\t\t\tfor _, p in ipairs(Players:GetPlayers()) do\n\t\t\t\t\t\t\tif p.Character == obj.Parent then\n\t\t\t\t\t\t\t\tisPlayer = true\n\t\t\t\t\t\t\t\tbreak\n\t\t\t\t\t\t\tend\n\t\t\t\t\t\tend\n\t\t\t\t\t\tif not isPlayer then\n\t\t\t\t\t\t\tobj:TakeDamage(SPITBALL_CFG.damage)\n\t\t\t\t\t\t\tprint(string.format(\"[SPITBALL] Hit %s for %d damage\", obj.Parent.Name, SPITBALL_CFG.damage))\n\t\t\t\t\t\tend\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\n\t\t-- Visual blast effect\n\t\tlocal blast = Instance.new(\"Part\")\n\t\tblast.Shape       = Enum.PartType.Ball\n\t\tblast.Size        = Vector3.new(SPITBALL_CFG.radius * 2, SPITBALL_CFG.radius * 2, SPITBALL_CFG.radius * 2)\n\t\tblast.Anchored    = true\n\t\tblast.CanCollide  = false\n\t\tblast.Material    = Enum.Material.Neon\n\t\tblast.BrickColor  = BrickColor.new(\"Bright green\")\n\t\tblast.Transparency = 0.5\n\t\tblast.CFrame      = CFrame.new(blastPos)\n\t\tblast.Parent      = workspace\n\t\tDebris:AddItem(blast, 0.3)\n\tend)\nend)\n\nprint(\"[SPITBALL] Service initialized\")\n"}},"contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
{"timestamp":"2026-05-07T07:52:56.045Z","type":"write","direction":"forward","source":"studio","path":"game.ServerScriptService.JetpackThrowService","details":"props","contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
{"timestamp":"2026-05-07T07:52:56.045Z","type":"write","direction":"forward","source":"studio","path":"game.ServerScriptService.JetpackThrowService","details":"script:Script","diff":{"type":"script","scriptMeta":{"beforeLines":null,"afterLines":163},"scriptDiff":{"beforeSource":null,"afterSource":"-- =============================================================================\n-- JetpackThrowService\n-- Jetpack teammate throw mechanic.\n-- Thrower selects a teammate (private select OR broadcast offer).\n-- First responder to broadcast is selected.\n-- Thrown player becomes a projectile — 1-shot kills AerialHawk on contact.\n-- =============================================================================\n\nlocal Players    = game:GetService(\"Players\")\nlocal Debris     = game:GetService(\"Debris\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal THROW_CFG = {\n\tspeed         = 120,   -- studs/s throw speed\n\thawkKillRange = 8,     -- studs — contact range to 1-shot hawk\n\tofferTimeout  = 5,     -- seconds broadcast offer stays open\n}\n\n-- Wait for events folder\nlocal eventsFolder\nlocal attempts = 0\nrepeat\n\ttask.wait(0.5)\n\tattempts += 1\n\tlocal omc = ReplicatedStorage:FindFirstChild(\"OMC\")\n\teventsFolder = omc and omc:FindFirstChild(\"Events\")\nuntil eventsFolder or attempts > 20\n\nif not eventsFolder then\n\twarn(\"[JETPACK-THROW] Events folder not found\")\n\treturn\nend\n\n-- RemoteEvents\nlocal function makeRemote(name)\n\tlocal r = eventsFolder:FindFirstChild(name)\n\tif r then return r end\n\tr = Instance.new(\"RemoteEvent\")\n\tr.Name = name; r.Parent = eventsFolder\n\treturn r\nend\n\nlocal ThrowOffer    = makeRemote(\"JetpackThrowOffer\")     -- server→all: broadcast offer\nlocal ThrowAccept   = makeRemote(\"JetpackThrowAccept\")    -- client→server: teammate accepts\nlocal ThrowExecute  = makeRemote(\"JetpackThrowExecute\")   -- server→client: you are being thrown\nlocal ThrowRequest  = makeRemote(\"JetpackThrowRequest\")   -- client→server: thrower initiates\n\n-- Pending offers: thrower → { target=player|nil, timer }\nlocal pendingOffers = {}\n\nThrowRequest.OnServerEvent:Connect(function(thrower, targetPlayer)\n\t-- targetPlayer = specific player (private) or nil (broadcast)\n\tlocal throwerChar = thrower.Character\n\tlocal throwerHRP  = throwerChar and throwerChar:FindFirstChild(\"HumanoidRootPart\")\n\tif not throwerHRP then return end\n\n\tif pendingOffers[thrower] then return end  -- already has active offer\n\n\tlocal offer = {\n\t\tthrower  = thrower,\n\t\ttarget   = targetPlayer,\n\t\taccepted = false,\n\t}\n\tpendingOffers[thrower] = offer\n\n\tif targetPlayer then\n\t\t-- Private offer — send only to target\n\t\tThrowOffer:FireClient(targetPlayer, thrower.Name, false)\n\telse\n\t\t-- Broadcast offer — send to all other players\n\t\tfor _, p in ipairs(Players:GetPlayers()) do\n\t\t\tif p ~= thrower then\n\t\t\t\tThrowOffer:FireClient(p, thrower.Name, true)\n\t\t\tend\n\t\tend\n\tend\n\n\t-- Timeout\n\ttask.delay(THROW_CFG.offerTimeout, function()\n\t\tif pendingOffers[thrower] and not pendingOffers[thrower].accepted then\n\t\t\tpendingOffers[thrower] = nil\n\t\t\tprint(string.format(\"[JETPACK-THROW] %s offer timed out\", thrower.Name))\n\t\tend\n\tend)\nend)\n\nThrowAccept.OnServerEvent:Connect(function(accepter)\n\t-- Find which thrower offered to this player\n\tlocal offer = nil\n\tlocal offerThrower = nil\n\tfor thrower, o in pairs(pendingOffers) do\n\t\tif o.accepted then continue end\n\t\tif o.target == accepter or o.target == nil then\n\t\t\toffer = o\n\t\t\tofferThrower = thrower\n\t\t\tbreak\n\t\tend\n\tend\n\tif not offer then return end\n\toffer.accepted = true\n\tpendingOffers[offerThrower] = nil\n\n\tlocal throwerChar = offerThrower.Character\n\tlocal throwerHRP  = throwerChar and throwerChar:FindFirstChild(\"HumanoidRootPart\")\n\tlocal accepterChar = accepter.Character\n\tlocal accepterHRP  = accepterChar and accepterChar:FindFirstChild(\"HumanoidRootPart\")\n\tlocal accepterHum  = accepterChar and accepterChar:FindFirstChildOfClass(\"Humanoid\")\n\n\tif not (throwerHRP and accepterHRP and accepterHum) then return end\n\n\t-- Direction: thrower → nearest aerial enemy, fallback to thrower LookVector\n\tlocal throwDir = throwerChar.HumanoidRootPart.CFrame.LookVector\n\tlocal nearest, nearestDist = nil, math.huge\n\tfor _, obj in ipairs(workspace:GetDescendants()) do\n\t\tif obj.Name == \"AerialHawk\" and obj:IsA(\"Model\") then\n\t\t\tlocal hr = obj:FindFirstChild(\"HumanoidRootPart\")\n\t\t\tif hr then\n\t\t\t\tlocal d = (hr.Position - throwerHRP.Position).Magnitude\n\t\t\t\tif d < nearestDist then nearest = obj; nearestDist = d end\n\t\t\tend\n\t\tend\n\tend\n\tif nearest then\n\t\tlocal hawkHRP = nearest:FindFirstChild(\"HumanoidRootPart\")\n\t\tthrowDir = (hawkHRP.Position - throwerHRP.Position).Unit\n\tend\n\n\tprint(string.format(\"[JETPACK-THROW] %s throwing %s\", offerThrower.Name, accepter.Name))\n\tThrowExecute:FireClient(accepter, throwDir)\n\n\t-- Apply throw velocity server-side\n\tlocal bv = Instance.new(\"BodyVelocity\")\n\tbv.Velocity  = throwDir * THROW_CFG.speed\n\tbv.MaxForce  = Vector3.new(1e5, 1e5, 1e5)\n\tbv.Parent    = accepterHRP\n\tDebris:AddItem(bv, 0.8)\n\n\t-- Collision check: did we hit the hawk?\n\tlocal checkStart = tick()\n\ttask.spawn(function()\n\t\twhile tick() - checkStart < 3 do\n\t\t\ttask.wait(0.05)\n\t\t\tif not accepterHRP or not accepterHRP.Parent then break end\n\t\t\tfor _, obj in ipairs(workspace:GetDescendants()) do\n\t\t\t\tif obj.Name == \"AerialHawk\" and obj:IsA(\"Model\") then\n\t\t\t\t\tlocal hr = obj:FindFirstChild(\"HumanoidRootPart\")\n\t\t\t\t\tlocal hum = obj:FindFirstChildOfClass(\"Humanoid\")\n\t\t\t\t\tif hr and hum then\n\t\t\t\t\t\tlocal dist = (hr.Position - accepterHRP.Position).Magnitude\n\t\t\t\t\t\tif dist < THROW_CFG.hawkKillRange then\n\t\t\t\t\t\t\thum.Health = 0  -- 1-shot kill\n\t\t\t\t\t\t\tprint(string.format(\"[JETPACK-THROW] HAWK KILLED by %s throw!\", accepter.Name))\n\t\t\t\t\t\t\tbreak\n\t\t\t\t\t\tend\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend)\nend)\n\nprint(\"[JETPACK-THROW] Service initialized — private + broadcast throw, 1-shot hawk kill\")\n"}},"contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
{"timestamp":"2026-05-07T07:52:58.553Z","type":"write","direction":"forward","source":"studio","path":"game.ServerScriptService.JetpackThrowService~2","details":"props","contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
{"timestamp":"2026-05-07T07:52:58.554Z","type":"write","direction":"forward","source":"studio","path":"game.ServerScriptService.JetpackThrowService~2","details":"script:Script","diff":{"type":"script","scriptMeta":{"beforeLines":null,"afterLines":163},"scriptDiff":{"beforeSource":null,"afterSource":"-- =============================================================================\n-- JetpackThrowService\n-- Jetpack teammate throw mechanic.\n-- Thrower selects a teammate (private select OR broadcast offer).\n-- First responder to broadcast is selected.\n-- Thrown player becomes a projectile — 1-shot kills AerialHawk on contact.\n-- =============================================================================\n\nlocal Players    = game:GetService(\"Players\")\nlocal Debris     = game:GetService(\"Debris\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal THROW_CFG = {\n\tspeed         = 120,   -- studs/s throw speed\n\thawkKillRange = 8,     -- studs — contact range to 1-shot hawk\n\tofferTimeout  = 5,     -- seconds broadcast offer stays open\n}\n\n-- Wait for events folder\nlocal eventsFolder\nlocal attempts = 0\nrepeat\n\ttask.wait(0.5)\n\tattempts += 1\n\tlocal omc = ReplicatedStorage:FindFirstChild(\"OMC\")\n\teventsFolder = omc and omc:FindFirstChild(\"Events\")\nuntil eventsFolder or attempts > 20\n\nif not eventsFolder then\n\twarn(\"[JETPACK-THROW] Events folder not found\")\n\treturn\nend\n\n-- RemoteEvents\nlocal function makeRemote(name)\n\tlocal r = eventsFolder:FindFirstChild(name)\n\tif r then return r end\n\tr = Instance.new(\"RemoteEvent\")\n\tr.Name = name; r.Parent = eventsFolder\n\treturn r\nend\n\nlocal ThrowOffer    = makeRemote(\"JetpackThrowOffer\")     -- server→all: broadcast offer\nlocal ThrowAccept   = makeRemote(\"JetpackThrowAccept\")    -- client→server: teammate accepts\nlocal ThrowExecute  = makeRemote(\"JetpackThrowExecute\")   -- server→client: you are being thrown\nlocal ThrowRequest  = makeRemote(\"JetpackThrowRequest\")   -- client→server: thrower initiates\n\n-- Pending offers: thrower → { target=player|nil, timer }\nlocal pendingOffers = {}\n\nThrowRequest.OnServerEvent:Connect(function(thrower, targetPlayer)\n\t-- targetPlayer = specific player (private) or nil (broadcast)\n\tlocal throwerChar = thrower.Character\n\tlocal throwerHRP  = throwerChar and throwerChar:FindFirstChild(\"HumanoidRootPart\")\n\tif not throwerHRP then return end\n\n\tif pendingOffers[thrower] then return end  -- already has active offer\n\n\tlocal offer = {\n\t\tthrower  = thrower,\n\t\ttarget   = targetPlayer,\n\t\taccepted = false,\n\t}\n\tpendingOffers[thrower] = offer\n\n\tif targetPlayer then\n\t\t-- Private offer — send only to target\n\t\tThrowOffer:FireClient(targetPlayer, thrower.Name, false)\n\telse\n\t\t-- Broadcast offer — send to all other players\n\t\tfor _, p in ipairs(Players:GetPlayers()) do\n\t\t\tif p ~= thrower then\n\t\t\t\tThrowOffer:FireClient(p, thrower.Name, true)\n\t\t\tend\n\t\tend\n\tend\n\n\t-- Timeout\n\ttask.delay(THROW_CFG.offerTimeout, function()\n\t\tif pendingOffers[thrower] and not pendingOffers[thrower].accepted then\n\t\t\tpendingOffers[thrower] = nil\n\t\t\tprint(string.format(\"[JETPACK-THROW] %s offer timed out\", thrower.Name))\n\t\tend\n\tend)\nend)\n\nThrowAccept.OnServerEvent:Connect(function(accepter)\n\t-- Find which thrower offered to this player\n\tlocal offer = nil\n\tlocal offerThrower = nil\n\tfor thrower, o in pairs(pendingOffers) do\n\t\tif o.accepted then continue end\n\t\tif o.target == accepter or o.target == nil then\n\t\t\toffer = o\n\t\t\tofferThrower = thrower\n\t\t\tbreak\n\t\tend\n\tend\n\tif not offer then return end\n\toffer.accepted = true\n\tpendingOffers[offerThrower] = nil\n\n\tlocal throwerChar = offerThrower.Character\n\tlocal throwerHRP  = throwerChar and throwerChar:FindFirstChild(\"HumanoidRootPart\")\n\tlocal accepterChar = accepter.Character\n\tlocal accepterHRP  = accepterChar and accepterChar:FindFirstChild(\"HumanoidRootPart\")\n\tlocal accepterHum  = accepterChar and accepterChar:FindFirstChildOfClass(\"Humanoid\")\n\n\tif not (throwerHRP and accepterHRP and accepterHum) then return end\n\n\t-- Direction: thrower → nearest aerial enemy, fallback to thrower LookVector\n\tlocal throwDir = throwerChar.HumanoidRootPart.CFrame.LookVector\n\tlocal nearest, nearestDist = nil, math.huge\n\tfor _, obj in ipairs(workspace:GetDescendants()) do\n\t\tif obj.Name == \"AerialHawk\" and obj:IsA(\"Model\") then\n\t\t\tlocal hr = obj:FindFirstChild(\"HumanoidRootPart\")\n\t\t\tif hr then\n\t\t\t\tlocal d = (hr.Position - throwerHRP.Position).Magnitude\n\t\t\t\tif d < nearestDist then nearest = obj; nearestDist = d end\n\t\t\tend\n\t\tend\n\tend\n\tif nearest then\n\t\tlocal hawkHRP = nearest:FindFirstChild(\"HumanoidRootPart\")\n\t\tthrowDir = (hawkHRP.Position - throwerHRP.Position).Unit\n\tend\n\n\tprint(string.format(\"[JETPACK-THROW] %s throwing %s\", offerThrower.Name, accepter.Name))\n\tThrowExecute:FireClient(accepter, throwDir)\n\n\t-- Apply throw velocity server-side\n\tlocal bv = Instance.new(\"BodyVelocity\")\n\tbv.Velocity  = throwDir * THROW_CFG.speed\n\tbv.MaxForce  = Vector3.new(1e5, 1e5, 1e5)\n\tbv.Parent    = accepterHRP\n\tDebris:AddItem(bv, 0.8)\n\n\t-- Collision check: did we hit the hawk?\n\tlocal checkStart = tick()\n\ttask.spawn(function()\n\t\twhile tick() - checkStart < 3 do\n\t\t\ttask.wait(0.05)\n\t\t\tif not accepterHRP or not accepterHRP.Parent then break end\n\t\t\tfor _, obj in ipairs(workspace:GetDescendants()) do\n\t\t\t\tif obj.Name == \"AerialHawk\" and obj:IsA(\"Model\") then\n\t\t\t\t\tlocal hr = obj:FindFirstChild(\"HumanoidRootPart\")\n\t\t\t\t\tlocal hum = obj:FindFirstChildOfClass(\"Humanoid\")\n\t\t\t\t\tif hr and hum then\n\t\t\t\t\t\tlocal dist = (hr.Position - accepterHRP.Position).Magnitude\n\t\t\t\t\t\tif dist < THROW_CFG.hawkKillRange then\n\t\t\t\t\t\t\thum.Health = 0  -- 1-shot kill\n\t\t\t\t\t\t\tprint(string.format(\"[JETPACK-THROW] HAWK KILLED by %s throw!\", accepter.Name))\n\t\t\t\t\t\t\tbreak\n\t\t\t\t\t\tend\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend)\nend)\n\nprint(\"[JETPACK-THROW] Service initialized — private + broadcast throw, 1-shot hawk kill\")\n"}},"contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
{"timestamp":"2026-05-07T07:53:30.010Z","type":"write","direction":"forward","source":"studio","path":"game.StarterPlayer.StarterPlayerScripts.JetpackThrowClient","details":"props","contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
{"timestamp":"2026-05-07T07:53:30.011Z","type":"write","direction":"forward","source":"studio","path":"game.StarterPlayer.StarterPlayerScripts.JetpackThrowClient","details":"script:LocalScript","diff":{"type":"script","scriptMeta":{"beforeLines":null,"afterLines":197},"scriptDiff":{"beforeSource":null,"afterSource":"-- =============================================================================\n-- JetpackThrowClient\n-- Handles the thrown player's experience:\n-- - Slight veer control via WASD while airborne\n-- - If thrown player has a JETPACK in inventory, they can boost mid-flight\n--   to increase collision speed for hawk kill\n-- =============================================================================\n\nlocal Players         = game:GetService(\"Players\")\nlocal UserInputService = game:GetService(\"UserInputService\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService      = game:GetService(\"RunService\")\n\nlocal player = Players.LocalPlayer\n\n-- Wait for remotes\nlocal eventsFolder\nrepeat task.wait(0.3)\n\tlocal omc = ReplicatedStorage:FindFirstChild(\"OMC\")\n\teventsFolder = omc and omc:FindFirstChild(\"Events\")\nuntil eventsFolder\n\nlocal ThrowOffer   = eventsFolder:WaitForChild(\"JetpackThrowOffer\", 10)\nlocal ThrowAccept  = eventsFolder:WaitForChild(\"JetpackThrowAccept\", 10)\nlocal ThrowExecute = eventsFolder:WaitForChild(\"JetpackThrowExecute\", 10)\nlocal InventoryUpdate = eventsFolder:WaitForChild(\"InventoryUpdate\", 10)\nlocal UseItem      = eventsFolder:WaitForChild(\"UseItem\", 10)\n\n-- Track local inventory\nlocal localInventory = { nil, nil, nil }\nif InventoryUpdate then\n\tInventoryUpdate.OnClientEvent:Connect(function(inv)\n\t\tlocalInventory = inv\n\tend)\nend\n\nlocal function hasJetpack()\n\tfor _, item in ipairs(localInventory) do\n\t\tif item == \"JETPACK\" then return true end\n\tend\n\treturn false\nend\n\nlocal function getJetpackSlot()\n\tfor i, item in ipairs(localInventory) do\n\t\tif item == \"JETPACK\" then return i end\n\tend\n\treturn nil\nend\n\n-- ── Throw offer UI ────────────────────────────────────────────────────────────\n\nlocal offerGui = nil\n\nlocal function showOffer(throwerName, isBroadcast)\n\tif offerGui then offerGui:Destroy() end\n\n\tlocal screenGui = Instance.new(\"ScreenGui\")\n\tscreenGui.Name = \"ThrowOfferGui\"\n\tscreenGui.ResetOnSpawn = false\n\tscreenGui.Parent = player.PlayerGui\n\tofferGui = screenGui\n\n\tlocal frame = Instance.new(\"Frame\", screenGui)\n\tframe.Size            = UDim2.new(0, 300, 0, 100)\n\tframe.Position        = UDim2.new(0.5, -150, 0.15, 0)\n\tframe.BackgroundColor3 = Color3.fromRGB(20, 20, 40)\n\tframe.BorderSizePixel = 0\n\n\tlocal corner = Instance.new(\"UICorner\", frame)\n\tcorner.CornerRadius = UDim.new(0, 8)\n\n\tlocal label = Instance.new(\"TextLabel\", frame)\n\tlabel.Size = UDim2.new(1, 0, 0.5, 0)\n\tlabel.BackgroundTransparency = 1\n\tlabel.Text = (isBroadcast and \"📡 \" or \"🎯 \") .. throwerName .. \" wants to throw you!\"\n\tlabel.TextColor3 = Color3.new(1, 1, 1)\n\tlabel.TextScaled = true\n\tlabel.Font = Enum.Font.GothamBold\n\n\tlocal acceptBtn = Instance.new(\"TextButton\", frame)\n\tacceptBtn.Size     = UDim2.new(0.6, 0, 0.4, 0)\n\tacceptBtn.Position = UDim2.new(0.2, 0, 0.55, 0)\n\tacceptBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 80)\n\tacceptBtn.Text     = \"ACCEPT THROW [E]\"\n\tacceptBtn.TextColor3 = Color3.new(1,1,1)\n\tacceptBtn.TextScaled = true\n\tacceptBtn.Font     = Enum.Font.GothamBold\n\n\tlocal function accept()\n\t\tif offerGui then offerGui:Destroy(); offerGui = nil end\n\t\tThrowAccept:FireServer()\n\tend\n\n\tacceptBtn.Activated:Connect(accept)\n\n\t-- Keyboard shortcut E\n\tlocal conn\n\tconn = UserInputService.InputBegan:Connect(function(input, gpe)\n\t\tif gpe then return end\n\t\tif input.KeyCode == Enum.KeyCode.E then\n\t\t\tconn:Disconnect()\n\t\t\taccept()\n\t\tend\n\tend)\n\n\t-- Auto-dismiss after 5s\n\ttask.delay(5, function()\n\t\tif offerGui then offerGui:Destroy(); offerGui = nil end\n\t\tif conn then conn:Disconnect() end\n\tend)\nend\n\nif ThrowOffer then\n\tThrowOffer.OnClientEvent:Connect(showOffer)\nend\n\n-- ── Thrown flight control ─────────────────────────────────────────────────────\n\nif ThrowExecute then\n\tThrowExecute.OnClientEvent:Connect(function(throwDir)\n\t\tlocal char = player.Character\n\t\tlocal hrp  = char and char:FindFirstChild(\"HumanoidRootPart\")\n\t\tif not hrp then return end\n\n\t\tprint(\"[JETPACK-THROW] You are being thrown! Veer with WASD.\")\n\n\t\tlocal inFlight    = true\n\t\tlocal flightStart = tick()\n\t\tlocal maxFlight   = 3  -- seconds of veer control\n\n\t\t-- Veer control loop\n\t\tlocal conn = RunService.RenderStepped:Connect(function()\n\t\t\tif not inFlight then return end\n\t\t\tif not hrp or not hrp.Parent then inFlight = false; return end\n\t\t\tif tick() - flightStart > maxFlight then inFlight = false; return end\n\n\t\t\tlocal cam    = workspace.CurrentCamera\n\t\t\tlocal camCF  = cam.CFrame\n\t\t\tlocal right  = camCF.RightVector\n\t\t\tlocal fwd    = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z).Unit\n\n\t\t\tlocal veer = Vector3.new(0, 0, 0)\n\t\t\tif UserInputService:IsKeyDown(Enum.KeyCode.W) or UserInputService:IsKeyDown(Enum.KeyCode.Up) then\n\t\t\t\tveer += fwd * 12\n\t\t\tend\n\t\t\tif UserInputService:IsKeyDown(Enum.KeyCode.S) or UserInputService:IsKeyDown(Enum.KeyCode.Down) then\n\t\t\t\tveer -= fwd * 8\n\t\t\tend\n\t\t\tif UserInputService:IsKeyDown(Enum.KeyCode.A) or UserInputService:IsKeyDown(Enum.KeyCode.Left) then\n\t\t\t\tveer -= right * 10\n\t\t\tend\n\t\t\tif UserInputService:IsKeyDown(Enum.KeyCode.D) or UserInputService:IsKeyDown(Enum.KeyCode.Right) then\n\t\t\t\tveer += right * 10\n\t\t\tend\n\n\t\t\tif veer.Magnitude > 0 then\n\t\t\t\tlocal bv = Instance.new(\"BodyVelocity\")\n\t\t\t\tbv.Velocity  = hrp.AssemblyLinearVelocity + veer\n\t\t\t\tbv.MaxForce  = Vector3.new(1e4, 0, 1e4)  -- horizontal only, preserve vertical arc\n\t\t\t\tbv.Parent    = hrp\n\t\t\t\tgame:GetService(\"Debris\"):AddItem(bv, 0.05)\n\t\t\tend\n\t\tend)\n\n\t\t-- Jetpack boost mid-flight: press Space if you have jetpack\n\t\tlocal boostConn\n\t\tboostConn = UserInputService.InputBegan:Connect(function(input, gpe)\n\t\t\tif gpe or not inFlight then return end\n\t\t\tif input.KeyCode == Enum.KeyCode.Space and hasJetpack() then\n\t\t\t\t-- Boost toward current velocity direction = hawkward\n\t\t\t\tlocal vel = hrp.AssemblyLinearVelocity\n\t\t\t\tlocal boostDir = vel.Magnitude > 1 and vel.Unit or throwDir\n\t\t\t\tlocal bv = Instance.new(\"BodyVelocity\")\n\t\t\t\tbv.Velocity  = boostDir * 160  -- boost speed for kill collision\n\t\t\t\tbv.MaxForce  = Vector3.new(1e5, 1e5, 1e5)\n\t\t\t\tbv.Parent    = hrp\n\t\t\t\tgame:GetService(\"Debris\"):AddItem(bv, 0.5)\n\n\t\t\t\t-- Consume jetpack slot\n\t\t\t\tlocal slot = getJetpackSlot()\n\t\t\t\tif slot then UseItem:FireServer(slot) end\n\n\t\t\t\tprint(\"[JETPACK-THROW] Mid-flight boost activated!\")\n\t\t\t\tboostConn:Disconnect()\n\t\t\tend\n\t\tend)\n\n\t\t-- End flight\n\t\ttask.delay(maxFlight, function()\n\t\t\tinFlight = false\n\t\t\tif conn then conn:Disconnect() end\n\t\t\tif boostConn then boostConn:Disconnect() end\n\t\tend)\n\tend)\nend\n"}},"contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
{"timestamp":"2026-05-07T07:54:18.093Z","type":"write","direction":"forward","source":"studio","path":"game.ServerScriptService.SOVEREIGN_MANIFEST.BuildGroundEnemies","details":"props","contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
{"timestamp":"2026-05-07T07:54:18.094Z","type":"write","direction":"forward","source":"studio","path":"game.ServerScriptService.SOVEREIGN_MANIFEST.BuildGroundEnemies","details":"script:Script","diff":{"type":"script","scriptMeta":{"beforeLines":null,"afterLines":302},"scriptDiff":{"beforeSource":null,"afterSource":"-- =============================================================================\n-- BuildGroundEnemies\n-- Spawns two ground enemy types:\n--   CRAWLER — fast, low, swarms players, weak (60HP)\n--   TITAN   — slow, heavy, high damage, requires 2 players to stagger (300HP)\n-- FSM: PATROL → CHASE → ATTACK → STAGGER → DEAD\n-- Titan co-op stagger gate: requires 2 players within 15 studs to knock back\n-- =============================================================================\n\nlocal ENABLE_ON_BOOT = true\nprint(\"[GROUND-ENEMIES] Script loaded\")\n\nlocal RunService    = game:GetService(\"RunService\")\nlocal Players       = game:GetService(\"Players\")\nlocal ServerStorage = game:GetService(\"ServerStorage\")\n\nif not ENABLE_ON_BOOT then return end\n\nlocal ARENA_CENTER = Vector3.new(1012, 60, 1007)\nlocal ARENA_RADIUS = 50\n\nlocal ENEMY_CFG = {\n\tCRAWLER = {\n\t\tname          = \"Crawler\",\n\t\tmaxHealth     = 60,\n\t\twalkSpeed     = 24,\n\t\tdamage        = 10,\n\t\tattackRange   = 4,\n\t\tchaseRange    = 50,\n\t\tattackCooldown = 0.8,\n\t\tsize          = Vector3.new(3, 1.5, 4),\n\t\tcolor         = BrickColor.new(\"Reddish brown\"),\n\t\tcoopRequired  = 1,   -- solo kill OK\n\t\tcount         = 3,   -- spawn 3 crawlers\n\t},\n\tTITAN = {\n\t\tname          = \"Titan\",\n\t\tmaxHealth     = 300,\n\t\twalkSpeed     = 10,\n\t\tdamage        = 40,\n\t\tattackRange   = 6,\n\t\tchaseRange    = 40,\n\t\tattackCooldown = 2.0,\n\t\tsize          = Vector3.new(5, 6, 4),\n\t\tcolor         = BrickColor.new(\"Dark orange\"),\n\t\tcoopRequired  = 2,   -- requires 2 players to stagger\n\t\tstaggerRadius = 15,  -- both players must be within this\n\t\tcount         = 1,\n\t},\n}\n\n-- ── Helpers ───────────────────────────────────────────────────────────────────\n\nlocal function randomSpawnPoint(yOffset)\n\tlocal angle  = math.random() * math.pi * 2\n\tlocal radius = 20 + math.random() * ARENA_RADIUS\n\treturn Vector3.new(\n\t\tARENA_CENTER.X + math.cos(angle) * radius,\n\t\tARENA_CENTER.Y + (yOffset or 0),\n\t\tARENA_CENTER.Z + math.sin(angle) * radius\n\t)\nend\n\nlocal function getNearestPlayer(pos)\n\tlocal nearest, dist = nil, math.huge\n\tfor _, p in ipairs(Players:GetPlayers()) do\n\t\tlocal char = p.Character\n\t\tlocal hrp  = char and char:FindFirstChild(\"HumanoidRootPart\")\n\t\tif hrp then\n\t\t\tlocal d = (hrp.Position - pos).Magnitude\n\t\t\tif d < dist then nearest = p; dist = d end\n\t\tend\n\tend\n\treturn nearest, dist\nend\n\nlocal function getPlayersWithin(pos, radius)\n\tlocal found = {}\n\tfor _, p in ipairs(Players:GetPlayers()) do\n\t\tlocal char = p.Character\n\t\tlocal hrp  = char and char:FindFirstChild(\"HumanoidRootPart\")\n\t\tif hrp and (hrp.Position - pos).Magnitude <= radius then\n\t\t\ttable.insert(found, p)\n\t\tend\n\tend\n\treturn found\nend\n\nlocal function isCloaked(player)\n\tlocal char = player.Character\n\tlocal hum  = char and char:FindFirstChildOfClass(\"Humanoid\")\n\treturn hum and hum:GetAttribute(\"OMC_Cloaked\") == true\nend\n\n-- ── Build enemy model ─────────────────────────────────────────────────────────\n\nlocal function buildEnemy(cfg, spawnPos)\n\tlocal model = Instance.new(\"Model\")\n\tmodel.Name  = cfg.name\n\n\tlocal root = Instance.new(\"Part\")\n\troot.Name        = \"HumanoidRootPart\"\n\troot.Size        = cfg.size\n\troot.BrickColor  = cfg.color\n\troot.Material    = Enum.Material.SmoothPlastic\n\troot.Anchored    = false\n\troot.CanCollide  = true\n\troot.CFrame      = CFrame.new(spawnPos)\n\troot.Parent      = model\n\n\t-- Eyes\n\tlocal eyeL = Instance.new(\"Part\")\n\teyeL.Name = \"EyeL\"; eyeL.Size = Vector3.new(0.4,0.4,0.2)\n\teyeL.BrickColor = BrickColor.new(\"Bright red\")\n\teyeL.Material = Enum.Material.Neon\n\teyeL.Anchored = false; eyeL.CanCollide = false\n\teyeL.Parent = model\n\tlocal wL = Instance.new(\"Weld\")\n\twL.Part0=root; wL.Part1=eyeL\n\twL.C1 = CFrame.new(-0.5, cfg.size.Y*0.3, -cfg.size.Z*0.5)\n\twL.Parent = root\n\n\tlocal eyeR = eyeL:Clone()\n\teyeR.Name = \"EyeR\"; eyeR.Parent = model\n\tlocal wR = Instance.new(\"Weld\")\n\twR.Part0=root; wR.Part1=eyeR\n\twR.C1 = CFrame.new(0.5, cfg.size.Y*0.3, -cfg.size.Z*0.5)\n\twR.Parent = root\n\n\tlocal hum = Instance.new(\"Humanoid\")\n\thum.RigType    = Enum.HumanoidRigType.R6\n\thum.MaxHealth  = cfg.maxHealth\n\thum.Health     = cfg.maxHealth\n\thum.WalkSpeed  = cfg.walkSpeed\n\thum.Parent     = model\n\n\tmodel.PrimaryPart = root\n\n\t-- OMC attributes\n\tmodel:SetAttribute(\"OMC_Archetype\",    \"ground_\" .. string.lower(cfg.name))\n\tmodel:SetAttribute(\"OMC_MaxHealth\",    cfg.maxHealth)\n\tmodel:SetAttribute(\"OMC_CoopRequired\", cfg.coopRequired)\n\n\tmodel.Parent = workspace\n\treturn model, root, hum\nend\n\n-- ── FSM ───────────────────────────────────────────────────────────────────────\n\nlocal function runEnemyFSM(model, root, hum, cfg)\n\tlocal state         = \"PATROL\"\n\tlocal patrolAngle   = math.random() * math.pi * 2\n\tlocal patrolOrigin  = root.Position\n\tlocal lastAttack    = 0\n\tlocal staggerTimer  = 0\n\n\tmodel:SetAttribute(\"OMC_FSMState\", state)\n\n\tRunService.Heartbeat:Connect(function(dt)\n\t\tif not model.Parent then return end\n\t\tif hum.Health <= 0 then\n\t\t\tmodel:SetAttribute(\"OMC_FSMState\", \"DEAD\")\n\t\t\t-- Respawn after 10s\n\t\t\ttask.delay(10, function()\n\t\t\t\tif model.Parent then model:Destroy() end\n\t\t\t\ttask.wait(1)\n\t\t\t\tbuildAndRunEnemy(cfg)\n\t\t\tend)\n\t\t\tmodel:Destroy()\n\t\t\treturn\n\t\tend\n\n\t\tlocal rootPos = root.Position\n\n\t\t-- Skip cloaked players in targeting\n\t\tlocal nearest, dist = nil, math.huge\n\t\tfor _, p in ipairs(Players:GetPlayers()) do\n\t\t\tif not isCloaked(p) then\n\t\t\t\tlocal char = p.Character\n\t\t\t\tlocal hrp  = char and char:FindFirstChild(\"HumanoidRootPart\")\n\t\t\t\tif hrp then\n\t\t\t\t\tlocal d = (hrp.Position - rootPos).Magnitude\n\t\t\t\t\tif d < dist then nearest = p; dist = d end\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\n\t\tif state == \"PATROL\" then\n\t\t\tpatrolAngle += dt * 0.3\n\t\t\tlocal tx = patrolOrigin.X + math.cos(patrolAngle) * 20\n\t\t\tlocal tz = patrolOrigin.Z + math.sin(patrolAngle) * 20\n\t\t\tlocal dir = Vector3.new(tx - rootPos.X, 0, tz - rootPos.Z)\n\t\t\tif dir.Magnitude > 0.1 then\n\t\t\t\troot.CFrame = root.CFrame:Lerp(\n\t\t\t\t\tCFrame.new(rootPos, rootPos + dir),\n\t\t\t\t\tdt * 3\n\t\t\t\t)\n\t\t\t\thum:MoveTo(Vector3.new(tx, rootPos.Y, tz))\n\t\t\tend\n\t\t\tif nearest and dist < cfg.chaseRange then\n\t\t\t\tstate = \"CHASE\"\n\t\t\t\tmodel:SetAttribute(\"OMC_FSMState\", \"CHASE\")\n\t\t\tend\n\n\t\telseif state == \"CHASE\" then\n\t\t\tif not nearest or dist > cfg.chaseRange * 1.3 then\n\t\t\t\tstate = \"PATROL\"\n\t\t\t\tmodel:SetAttribute(\"OMC_FSMState\", \"PATROL\")\n\t\t\t\treturn\n\t\t\tend\n\t\t\tlocal tHRP = nearest.Character and nearest.Character:FindFirstChild(\"HumanoidRootPart\")\n\t\t\tif tHRP then\n\t\t\t\thum:MoveTo(tHRP.Position)\n\t\t\tend\n\t\t\tif dist <= cfg.attackRange then\n\t\t\t\tstate = \"ATTACK\"\n\t\t\t\tmodel:SetAttribute(\"OMC_FSMState\", \"ATTACK\")\n\t\t\tend\n\n\t\telseif state == \"ATTACK\" then\n\t\t\tif not nearest or dist > cfg.attackRange * 1.5 then\n\t\t\t\tstate = \"CHASE\"\n\t\t\t\tmodel:SetAttribute(\"OMC_FSMState\", \"CHASE\")\n\t\t\t\treturn\n\t\t\tend\n\n\t\t\tlocal now = tick()\n\t\t\tif now - lastAttack >= cfg.attackCooldown then\n\t\t\t\tlastAttack = now\n\t\t\t\tlocal tChar = nearest.Character\n\t\t\t\tlocal tHum  = tChar and tChar:FindFirstChildOfClass(\"Humanoid\")\n\n\t\t\t\t-- Titan co-op stagger gate\n\t\t\t\tif cfg.name == \"TITAN\" then\n\t\t\t\t\tlocal nearby = getPlayersWithin(rootPos, cfg.staggerRadius or 15)\n\t\t\t\t\tmodel:SetAttribute(\"OMC_CoopStaggerReady\", #nearby >= 2)\n\t\t\t\tend\n\n\t\t\t\tif tHum and tHum:GetAttribute(\"OMC_Cloaked\") ~= true then\n\t\t\t\t\ttHum:TakeDamage(cfg.damage)\n\t\t\t\tend\n\t\t\tend\n\n\t\telseif state == \"STAGGER\" then\n\t\t\tstaggerTimer -= dt\n\t\t\thum.WalkSpeed = 0\n\t\t\tif staggerTimer <= 0 then\n\t\t\t\thum.WalkSpeed = cfg.walkSpeed\n\t\t\t\tstate = \"CHASE\"\n\t\t\t\tmodel:SetAttribute(\"OMC_FSMState\", \"CHASE\")\n\t\t\tend\n\t\tend\n\tend)\n\n\t-- Titan stagger trigger — 2 players nearby deal bonus knockback\n\tif cfg.name == \"TITAN\" then\n\t\tRunService.Heartbeat:Connect(function(dt)\n\t\t\tif not model.Parent then return end\n\t\t\tlocal rootPos = root.Position\n\t\t\tlocal nearby = getPlayersWithin(rootPos, cfg.staggerRadius or 15)\n\t\t\tif #nearby >= 2 and state == \"ATTACK\" then\n\t\t\t\tstate = \"STAGGER\"\n\t\t\t\tstaggerTimer = 2.5\n\t\t\t\tmodel:SetAttribute(\"OMC_FSMState\", \"STAGGER\")\n\t\t\t\t-- Knockback\n\t\t\t\tlocal bv = Instance.new(\"BodyVelocity\")\n\t\t\t\tbv.Velocity  = Vector3.new(math.random(-20,20), 15, math.random(-20,20))\n\t\t\t\tbv.MaxForce  = Vector3.new(1e4,1e4,1e4)\n\t\t\t\tbv.Parent    = root\n\t\t\t\tgame:GetService(\"Debris\"):AddItem(bv, 0.4)\n\t\t\t\tprint(\"[TITAN] Staggered by co-op attack!\")\n\t\t\tend\n\t\tend)\n\tend\nend\n\n-- ── Spawn wrapper (needed for respawn reference) ──────────────────────────────\n\nfunction buildAndRunEnemy(cfg)\n\tlocal spawnPos = randomSpawnPoint(cfg.size.Y / 2)\n\tlocal model, root, hum = buildEnemy(cfg, spawnPos)\n\trunEnemyFSM(model, root, hum, cfg)\n\tprint(string.format(\"[GROUND] %s spawned at (%.0f, %.0f, %.0f)\",\n\t\tcfg.name, spawnPos.X, spawnPos.Y, spawnPos.Z))\nend\n\n-- ── Initial spawn ─────────────────────────────────────────────────────────────\n\ntask.wait(2)\n\nfor i = 1, ENEMY_CFG.CRAWLER.count do\n\tbuildAndRunEnemy(ENEMY_CFG.CRAWLER)\n\ttask.wait(0.2)\nend\n\nfor i = 1, ENEMY_CFG.TITAN.count do\n\tbuildAndRunEnemy(ENEMY_CFG.TITAN)\nend\n\nprint(string.format(\"[GROUND] %d Crawlers + %d Titan spawned\",\n\tENEMY_CFG.CRAWLER.count, ENEMY_CFG.TITAN.count))\n"}},"contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
{"timestamp":"2026-05-07T07:54:21.958Z","type":"write","direction":"forward","source":"studio","path":"game.ServerScriptService.SOVEREIGN_MANIFEST.BuildGroundEnemies~2","details":"props","contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
{"timestamp":"2026-05-07T07:54:21.958Z","type":"write","direction":"forward","source":"studio","path":"game.ServerScriptService.SOVEREIGN_MANIFEST.BuildGroundEnemies~2","details":"script:Script","diff":{"type":"script","scriptMeta":{"beforeLines":null,"afterLines":302},"scriptDiff":{"beforeSource":null,"afterSource":"-- =============================================================================\n-- BuildGroundEnemies\n-- Spawns two ground enemy types:\n--   CRAWLER — fast, low, swarms players, weak (60HP)\n--   TITAN   — slow, heavy, high damage, requires 2 players to stagger (300HP)\n-- FSM: PATROL → CHASE → ATTACK → STAGGER → DEAD\n-- Titan co-op stagger gate: requires 2 players within 15 studs to knock back\n-- =============================================================================\n\nlocal ENABLE_ON_BOOT = true\nprint(\"[GROUND-ENEMIES] Script loaded\")\n\nlocal RunService    = game:GetService(\"RunService\")\nlocal Players       = game:GetService(\"Players\")\nlocal ServerStorage = game:GetService(\"ServerStorage\")\n\nif not ENABLE_ON_BOOT then return end\n\nlocal ARENA_CENTER = Vector3.new(1012, 60, 1007)\nlocal ARENA_RADIUS = 50\n\nlocal ENEMY_CFG = {\n\tCRAWLER = {\n\t\tname          = \"Crawler\",\n\t\tmaxHealth     = 60,\n\t\twalkSpeed     = 24,\n\t\tdamage        = 10,\n\t\tattackRange   = 4,\n\t\tchaseRange    = 50,\n\t\tattackCooldown = 0.8,\n\t\tsize          = Vector3.new(3, 1.5, 4),\n\t\tcolor         = BrickColor.new(\"Reddish brown\"),\n\t\tcoopRequired  = 1,   -- solo kill OK\n\t\tcount         = 3,   -- spawn 3 crawlers\n\t},\n\tTITAN = {\n\t\tname          = \"Titan\",\n\t\tmaxHealth     = 300,\n\t\twalkSpeed     = 10,\n\t\tdamage        = 40,\n\t\tattackRange   = 6,\n\t\tchaseRange    = 40,\n\t\tattackCooldown = 2.0,\n\t\tsize          = Vector3.new(5, 6, 4),\n\t\tcolor         = BrickColor.new(\"Dark orange\"),\n\t\tcoopRequired  = 2,   -- requires 2 players to stagger\n\t\tstaggerRadius = 15,  -- both players must be within this\n\t\tcount         = 1,\n\t},\n}\n\n-- ── Helpers ───────────────────────────────────────────────────────────────────\n\nlocal function randomSpawnPoint(yOffset)\n\tlocal angle  = math.random() * math.pi * 2\n\tlocal radius = 20 + math.random() * ARENA_RADIUS\n\treturn Vector3.new(\n\t\tARENA_CENTER.X + math.cos(angle) * radius,\n\t\tARENA_CENTER.Y + (yOffset or 0),\n\t\tARENA_CENTER.Z + math.sin(angle) * radius\n\t)\nend\n\nlocal function getNearestPlayer(pos)\n\tlocal nearest, dist = nil, math.huge\n\tfor _, p in ipairs(Players:GetPlayers()) do\n\t\tlocal char = p.Character\n\t\tlocal hrp  = char and char:FindFirstChild(\"HumanoidRootPart\")\n\t\tif hrp then\n\t\t\tlocal d = (hrp.Position - pos).Magnitude\n\t\t\tif d < dist then nearest = p; dist = d end\n\t\tend\n\tend\n\treturn nearest, dist\nend\n\nlocal function getPlayersWithin(pos, radius)\n\tlocal found = {}\n\tfor _, p in ipairs(Players:GetPlayers()) do\n\t\tlocal char = p.Character\n\t\tlocal hrp  = char and char:FindFirstChild(\"HumanoidRootPart\")\n\t\tif hrp and (hrp.Position - pos).Magnitude <= radius then\n\t\t\ttable.insert(found, p)\n\t\tend\n\tend\n\treturn found\nend\n\nlocal function isCloaked(player)\n\tlocal char = player.Character\n\tlocal hum  = char and char:FindFirstChildOfClass(\"Humanoid\")\n\treturn hum and hum:GetAttribute(\"OMC_Cloaked\") == true\nend\n\n-- ── Build enemy model ─────────────────────────────────────────────────────────\n\nlocal function buildEnemy(cfg, spawnPos)\n\tlocal model = Instance.new(\"Model\")\n\tmodel.Name  = cfg.name\n\n\tlocal root = Instance.new(\"Part\")\n\troot.Name        = \"HumanoidRootPart\"\n\troot.Size        = cfg.size\n\troot.BrickColor  = cfg.color\n\troot.Material    = Enum.Material.SmoothPlastic\n\troot.Anchored    = false\n\troot.CanCollide  = true\n\troot.CFrame      = CFrame.new(spawnPos)\n\troot.Parent      = model\n\n\t-- Eyes\n\tlocal eyeL = Instance.new(\"Part\")\n\teyeL.Name = \"EyeL\"; eyeL.Size = Vector3.new(0.4,0.4,0.2)\n\teyeL.BrickColor = BrickColor.new(\"Bright red\")\n\teyeL.Material = Enum.Material.Neon\n\teyeL.Anchored = false; eyeL.CanCollide = false\n\teyeL.Parent = model\n\tlocal wL = Instance.new(\"Weld\")\n\twL.Part0=root; wL.Part1=eyeL\n\twL.C1 = CFrame.new(-0.5, cfg.size.Y*0.3, -cfg.size.Z*0.5)\n\twL.Parent = root\n\n\tlocal eyeR = eyeL:Clone()\n\teyeR.Name = \"EyeR\"; eyeR.Parent = model\n\tlocal wR = Instance.new(\"Weld\")\n\twR.Part0=root; wR.Part1=eyeR\n\twR.C1 = CFrame.new(0.5, cfg.size.Y*0.3, -cfg.size.Z*0.5)\n\twR.Parent = root\n\n\tlocal hum = Instance.new(\"Humanoid\")\n\thum.RigType    = Enum.HumanoidRigType.R6\n\thum.MaxHealth  = cfg.maxHealth\n\thum.Health     = cfg.maxHealth\n\thum.WalkSpeed  = cfg.walkSpeed\n\thum.Parent     = model\n\n\tmodel.PrimaryPart = root\n\n\t-- OMC attributes\n\tmodel:SetAttribute(\"OMC_Archetype\",    \"ground_\" .. string.lower(cfg.name))\n\tmodel:SetAttribute(\"OMC_MaxHealth\",    cfg.maxHealth)\n\tmodel:SetAttribute(\"OMC_CoopRequired\", cfg.coopRequired)\n\n\tmodel.Parent = workspace\n\treturn model, root, hum\nend\n\n-- ── FSM ───────────────────────────────────────────────────────────────────────\n\nlocal function runEnemyFSM(model, root, hum, cfg)\n\tlocal state         = \"PATROL\"\n\tlocal patrolAngle   = math.random() * math.pi * 2\n\tlocal patrolOrigin  = root.Position\n\tlocal lastAttack    = 0\n\tlocal staggerTimer  = 0\n\n\tmodel:SetAttribute(\"OMC_FSMState\", state)\n\n\tRunService.Heartbeat:Connect(function(dt)\n\t\tif not model.Parent then return end\n\t\tif hum.Health <= 0 then\n\t\t\tmodel:SetAttribute(\"OMC_FSMState\", \"DEAD\")\n\t\t\t-- Respawn after 10s\n\t\t\ttask.delay(10, function()\n\t\t\t\tif model.Parent then model:Destroy() end\n\t\t\t\ttask.wait(1)\n\t\t\t\tbuildAndRunEnemy(cfg)\n\t\t\tend)\n\t\t\tmodel:Destroy()\n\t\t\treturn\n\t\tend\n\n\t\tlocal rootPos = root.Position\n\n\t\t-- Skip cloaked players in targeting\n\t\tlocal nearest, dist = nil, math.huge\n\t\tfor _, p in ipairs(Players:GetPlayers()) do\n\t\t\tif not isCloaked(p) then\n\t\t\t\tlocal char = p.Character\n\t\t\t\tlocal hrp  = char and char:FindFirstChild(\"HumanoidRootPart\")\n\t\t\t\tif hrp then\n\t\t\t\t\tlocal d = (hrp.Position - rootPos).Magnitude\n\t\t\t\t\tif d < dist then nearest = p; dist = d end\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\n\t\tif state == \"PATROL\" then\n\t\t\tpatrolAngle += dt * 0.3\n\t\t\tlocal tx = patrolOrigin.X + math.cos(patrolAngle) * 20\n\t\t\tlocal tz = patrolOrigin.Z + math.sin(patrolAngle) * 20\n\t\t\tlocal dir = Vector3.new(tx - rootPos.X, 0, tz - rootPos.Z)\n\t\t\tif dir.Magnitude > 0.1 then\n\t\t\t\troot.CFrame = root.CFrame:Lerp(\n\t\t\t\t\tCFrame.new(rootPos, rootPos + dir),\n\t\t\t\t\tdt * 3\n\t\t\t\t)\n\t\t\t\thum:MoveTo(Vector3.new(tx, rootPos.Y, tz))\n\t\t\tend\n\t\t\tif nearest and dist < cfg.chaseRange then\n\t\t\t\tstate = \"CHASE\"\n\t\t\t\tmodel:SetAttribute(\"OMC_FSMState\", \"CHASE\")\n\t\t\tend\n\n\t\telseif state == \"CHASE\" then\n\t\t\tif not nearest or dist > cfg.chaseRange * 1.3 then\n\t\t\t\tstate = \"PATROL\"\n\t\t\t\tmodel:SetAttribute(\"OMC_FSMState\", \"PATROL\")\n\t\t\t\treturn\n\t\t\tend\n\t\t\tlocal tHRP = nearest.Character and nearest.Character:FindFirstChild(\"HumanoidRootPart\")\n\t\t\tif tHRP then\n\t\t\t\thum:MoveTo(tHRP.Position)\n\t\t\tend\n\t\t\tif dist <= cfg.attackRange then\n\t\t\t\tstate = \"ATTACK\"\n\t\t\t\tmodel:SetAttribute(\"OMC_FSMState\", \"ATTACK\")\n\t\t\tend\n\n\t\telseif state == \"ATTACK\" then\n\t\t\tif not nearest or dist > cfg.attackRange * 1.5 then\n\t\t\t\tstate = \"CHASE\"\n\t\t\t\tmodel:SetAttribute(\"OMC_FSMState\", \"CHASE\")\n\t\t\t\treturn\n\t\t\tend\n\n\t\t\tlocal now = tick()\n\t\t\tif now - lastAttack >= cfg.attackCooldown then\n\t\t\t\tlastAttack = now\n\t\t\t\tlocal tChar = nearest.Character\n\t\t\t\tlocal tHum  = tChar and tChar:FindFirstChildOfClass(\"Humanoid\")\n\n\t\t\t\t-- Titan co-op stagger gate\n\t\t\t\tif cfg.name == \"TITAN\" then\n\t\t\t\t\tlocal nearby = getPlayersWithin(rootPos, cfg.staggerRadius or 15)\n\t\t\t\t\tmodel:SetAttribute(\"OMC_CoopStaggerReady\", #nearby >= 2)\n\t\t\t\tend\n\n\t\t\t\tif tHum and tHum:GetAttribute(\"OMC_Cloaked\") ~= true then\n\t\t\t\t\ttHum:TakeDamage(cfg.damage)\n\t\t\t\tend\n\t\t\tend\n\n\t\telseif state == \"STAGGER\" then\n\t\t\tstaggerTimer -= dt\n\t\t\thum.WalkSpeed = 0\n\t\t\tif staggerTimer <= 0 then\n\t\t\t\thum.WalkSpeed = cfg.walkSpeed\n\t\t\t\tstate = \"CHASE\"\n\t\t\t\tmodel:SetAttribute(\"OMC_FSMState\", \"CHASE\")\n\t\t\tend\n\t\tend\n\tend)\n\n\t-- Titan stagger trigger — 2 players nearby deal bonus knockback\n\tif cfg.name == \"TITAN\" then\n\t\tRunService.Heartbeat:Connect(function(dt)\n\t\t\tif not model.Parent then return end\n\t\t\tlocal rootPos = root.Position\n\t\t\tlocal nearby = getPlayersWithin(rootPos, cfg.staggerRadius or 15)\n\t\t\tif #nearby >= 2 and state == \"ATTACK\" then\n\t\t\t\tstate = \"STAGGER\"\n\t\t\t\tstaggerTimer = 2.5\n\t\t\t\tmodel:SetAttribute(\"OMC_FSMState\", \"STAGGER\")\n\t\t\t\t-- Knockback\n\t\t\t\tlocal bv = Instance.new(\"BodyVelocity\")\n\t\t\t\tbv.Velocity  = Vector3.new(math.random(-20,20), 15, math.random(-20,20))\n\t\t\t\tbv.MaxForce  = Vector3.new(1e4,1e4,1e4)\n\t\t\t\tbv.Parent    = root\n\t\t\t\tgame:GetService(\"Debris\"):AddItem(bv, 0.4)\n\t\t\t\tprint(\"[TITAN] Staggered by co-op attack!\")\n\t\t\tend\n\t\tend)\n\tend\nend\n\n-- ── Spawn wrapper (needed for respawn reference) ──────────────────────────────\n\nfunction buildAndRunEnemy(cfg)\n\tlocal spawnPos = randomSpawnPoint(cfg.size.Y / 2)\n\tlocal model, root, hum = buildEnemy(cfg, spawnPos)\n\trunEnemyFSM(model, root, hum, cfg)\n\tprint(string.format(\"[GROUND] %s spawned at (%.0f, %.0f, %.0f)\",\n\t\tcfg.name, spawnPos.X, spawnPos.Y, spawnPos.Z))\nend\n\n-- ── Initial spawn ─────────────────────────────────────────────────────────────\n\ntask.wait(2)\n\nfor i = 1, ENEMY_CFG.CRAWLER.count do\n\tbuildAndRunEnemy(ENEMY_CFG.CRAWLER)\n\ttask.wait(0.2)\nend\n\nfor i = 1, ENEMY_CFG.TITAN.count do\n\tbuildAndRunEnemy(ENEMY_CFG.TITAN)\nend\n\nprint(string.format(\"[GROUND] %d Crawlers + %d Titan spawned\",\n\tENEMY_CFG.CRAWLER.count, ENEMY_CFG.TITAN.count))\n"}},"contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
