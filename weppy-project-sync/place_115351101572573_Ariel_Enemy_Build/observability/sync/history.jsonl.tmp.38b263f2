{"timestamp":"2026-05-07T08:41:59.546Z","type":"write","direction":"forward","source":"studio","path":"game.ServerScriptService.SOVEREIGN_MANIFEST.BuildArenaFloor","details":"props","contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
{"timestamp":"2026-05-07T08:41:59.546Z","type":"write","direction":"forward","source":"studio","path":"game.ServerScriptService.SOVEREIGN_MANIFEST.BuildArenaFloor","details":"script:Script","diff":{"type":"script","scriptMeta":{"beforeLines":null,"afterLines":35},"scriptDiff":{"beforeSource":null,"afterSource":"-- BuildArenaFloor.server.luau\n-- Creates the arena floor if it doesn't already exist.\n-- Runs first — no dependencies, no waits.\n-- Floor top surface = Y=59, spawn scripts target Y=64 (5 studs above).\n\nlocal FLOOR_NAME   = \"ArenaFloor\"\nlocal FLOOR_CX     = 1012\nlocal FLOOR_Y      = 58   -- center Y; top surface = 59\nlocal FLOOR_CZ     = 1007\nlocal FLOOR_SIZE_X = 140\nlocal FLOOR_SIZE_Z = 140\nlocal FLOOR_THICK  = 2\n\n-- Idempotent: skip if already present (e.g. placed in Studio edit mode)\nif workspace:FindFirstChild(FLOOR_NAME) then\n\tprint(\"[ARENA-FLOOR] Already present — skipping\")\n\treturn\nend\n\nlocal floor = Instance.new(\"Part\")\nfloor.Name         = FLOOR_NAME\nfloor.Size         = Vector3.new(FLOOR_SIZE_X, FLOOR_THICK, FLOOR_SIZE_Z)\nfloor.CFrame       = CFrame.new(FLOOR_CX, FLOOR_Y, FLOOR_CZ)\nfloor.Anchored     = true\nfloor.CanCollide   = true\nfloor.Locked       = true\nfloor.Material     = Enum.Material.SmoothPlastic\nfloor.BrickColor   = BrickColor.new(\"Dark grey metallic\")\nfloor.TopSurface   = Enum.SurfaceType.Smooth\nfloor.BottomSurface = Enum.SurfaceType.Smooth\nfloor.Parent       = workspace\n\nprint(string.format(\"[ARENA-FLOOR] Created — top surface Y=%d, size %dx%d\",\n\tFLOOR_Y + FLOOR_THICK/2, FLOOR_SIZE_X, FLOOR_SIZE_Z))\n"}},"contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
{"timestamp":"2026-05-07T08:42:01.568Z","type":"write","direction":"forward","source":"studio","path":"game.ServerScriptService.SOVEREIGN_MANIFEST.BuildArenaFloor~2","details":"props","contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
{"timestamp":"2026-05-07T08:42:01.569Z","type":"write","direction":"forward","source":"studio","path":"game.ServerScriptService.SOVEREIGN_MANIFEST.BuildArenaFloor~2","details":"script:Script","diff":{"type":"script","scriptMeta":{"beforeLines":null,"afterLines":35},"scriptDiff":{"beforeSource":null,"afterSource":"-- BuildArenaFloor.server.luau\n-- Creates the arena floor if it doesn't already exist.\n-- Runs first — no dependencies, no waits.\n-- Floor top surface = Y=59, spawn scripts target Y=64 (5 studs above).\n\nlocal FLOOR_NAME   = \"ArenaFloor\"\nlocal FLOOR_CX     = 1012\nlocal FLOOR_Y      = 58   -- center Y; top surface = 59\nlocal FLOOR_CZ     = 1007\nlocal FLOOR_SIZE_X = 140\nlocal FLOOR_SIZE_Z = 140\nlocal FLOOR_THICK  = 2\n\n-- Idempotent: skip if already present (e.g. placed in Studio edit mode)\nif workspace:FindFirstChild(FLOOR_NAME) then\n\tprint(\"[ARENA-FLOOR] Already present — skipping\")\n\treturn\nend\n\nlocal floor = Instance.new(\"Part\")\nfloor.Name         = FLOOR_NAME\nfloor.Size         = Vector3.new(FLOOR_SIZE_X, FLOOR_THICK, FLOOR_SIZE_Z)\nfloor.CFrame       = CFrame.new(FLOOR_CX, FLOOR_Y, FLOOR_CZ)\nfloor.Anchored     = true\nfloor.CanCollide   = true\nfloor.Locked       = true\nfloor.Material     = Enum.Material.SmoothPlastic\nfloor.BrickColor   = BrickColor.new(\"Dark grey metallic\")\nfloor.TopSurface   = Enum.SurfaceType.Smooth\nfloor.BottomSurface = Enum.SurfaceType.Smooth\nfloor.Parent       = workspace\n\nprint(string.format(\"[ARENA-FLOOR] Created — top surface Y=%d, size %dx%d\",\n\tFLOOR_Y + FLOOR_THICK/2, FLOOR_SIZE_X, FLOOR_SIZE_Z))\n"}},"contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
