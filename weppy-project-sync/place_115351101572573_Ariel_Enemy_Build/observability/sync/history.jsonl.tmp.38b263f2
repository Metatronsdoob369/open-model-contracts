{"timestamp":"2026-05-07T08:02:56.549Z","type":"write","direction":"forward","source":"studio","path":"game.ServerScriptService.__TMP_WhereAmI~4","details":"script:Script","diff":{"type":"script","scriptMeta":{"beforeLines":null,"afterLines":20},"scriptDiff":{"beforeSource":null,"afterSource":"local Players = game:GetService(\"Players\")\ntask.wait(4)\nfor _, p in ipairs(Players:GetPlayers()) do\n\tlocal hrp = p.Character and p.Character:FindFirstChild(\"HumanoidRootPart\")\n\tif hrp then\n\t\tprint(string.format(\"[POS] %s at (%.0f, %.0f, %.0f)\", p.Name, hrp.Position.X, hrp.Position.Y, hrp.Position.Z))\n\tend\nend\nfor _, obj in ipairs(workspace:GetDescendants()) do\n\tif obj:IsA(\"Model\") and (obj.Name == \"AerialHawk\" or obj.Name == \"Crawler\" or obj.Name == \"Titan\") then\n\t\tlocal hrp = obj:FindFirstChild(\"HumanoidRootPart\")\n\t\tif hrp then\n\t\t\tprint(string.format(\"[ENEMY] %s at (%.0f, %.0f, %.0f)\", obj.Name, hrp.Position.X, hrp.Position.Y, hrp.Position.Z))\n\t\tend\n\tend\n\tif obj:IsA(\"Part\") and string.sub(obj.Name, 1, 7) == \"Pickup_\" then\n\t\tprint(string.format(\"[PICKUP] %s at (%.0f, %.0f, %.0f)\", obj.Name, obj.Position.X, obj.Position.Y, obj.Position.Z))\n\tend\nend\n"}},"contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
{"timestamp":"2026-05-07T08:04:21.312Z","type":"write","direction":"forward","source":"studio","path":"game.ServerScriptService.OMC_Ignition.Source.CharacterService","details":"script:ModuleScript","diff":{"type":"script","scriptMeta":{"beforeLines":107,"afterLines":107},"scriptDiff":{"beforeSource":"--[=[\n    CharacterService.luau\n    Status: VAULT-READY | 4D-Hardened | Sovereign Blueprint\n    Governance: State Stewardship §4, Spatio-Temporal Anchoring §3\n]=]\n\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\n-- Sovereign Anchors\nlocal OMC = ReplicatedStorage:WaitForChild(\"OMC\")\nlocal Generated = OMC:WaitForChild(\"Generated\")\nlocal Telemetry = require(Generated:WaitForChild(\"Telemetry\"))\nlocal Governance = require(script.Parent:WaitForChild(\"MetropolisGovernance\"))\n\n-- Native Bridge Factory (SafeFire)\nlocal function CreateBridge(name)\n\tlocal remote = ReplicatedStorage:FindFirstChild(name) or Instance.new(\"RemoteEvent\")\n\tremote.Name = name\n\tremote.Parent = ReplicatedStorage\n\treturn {\n\t\tFireAll = function(...) remote:FireAllClients(...) end,\n\t\t_remote = remote\n\t}\nend\n\nlocal CharacterService = {\n\tName = \"CharacterService\",\n\tConfig = {\n\t\tAPPLY_APPEARANCE = true,\n\t\tLOAD_TIMEOUT = 10,\n\t\tMANIFEST_Y = 501, -- Lobby floor level\n\t\tMANIFEST_X = 0,   -- Lobby spawn pad X\n\t\tMANIFEST_Z = 20,  -- Lobby spawn pad Z (back half, near back wall)\n\t},\n\tBridges = {\n\t\tManifest = CreateBridge(\"OMC_CharacterManifest\"),\n\t},\n\tState = { players = {} },\n}\n\n-- [[ MANIFESTATION LOGIC ]]\n\nfunction CharacterService:_applyAppearance(player, character)\n\tif not self.Config.APPLY_APPEARANCE then return end\n\tlocal humanoid = character:WaitForChild(\"Humanoid\", self.Config.LOAD_TIMEOUT)\n\tif not humanoid then return end\n\t\n\tlocal success, description = pcall(function()\n\t\treturn Players:GetHumanoidDescriptionFromUserId(player.UserId)\n\tend)\n\t\n\tif success and description then\n\t\tpcall(function() humanoid:ApplyDescription(description) end)\n\tend\nend\n\n-- [[ LIFECYCLE IGNITION ]]\n\nfunction CharacterService:Start()\n\tlocal function handlePlayer(player)\n\t\tplayer.CharacterAdded:Connect(function(char)\n\t\t\tlocal humanoid = char:WaitForChild(\"Humanoid\", 10)\n\t\t\tlocal hrp = char:WaitForChild(\"HumanoidRootPart\", 5)\n\t\t\t\n\t\t\tif humanoid then\n\t\t\t\thumanoid.WalkSpeed = 32 -- Sovereign Speed\n\t\t\t\thumanoid.JumpPower = 100 -- Cybernetic Jump\n\t\t\t\thumanoid.UseJumpPower = true\n\t\t\tend\n\t\t\t\n\t\t\tif hrp then\n\t\t\t\tlocal spawnCF = _G.LobbySpawnCF\n\t\t\t\t\tor CFrame.new(self.Config.MANIFEST_X, self.Config.MANIFEST_Y, self.Config.MANIFEST_Z)\n\t\t\t\thrp.CFrame = spawnCF\n\t\t\tend\n\t\t\t\n\t\t\tself:_applyAppearance(player, char)\n\t\t\tself.Bridges.Manifest:FireAll(\"LOADED\", player.Name)\n\t\t\tTelemetry.dispatchPulse({ event = \"Character_Manifest\", player = player.Name })\n\t\tend)\n\t\t\n\t\t-- Also handle the current character if it already exists\n\t\tif player.Character then\n\t\t\ttask.spawn(function()\n\t\t\t\tlocal hrp = player.Character:WaitForChild(\"HumanoidRootPart\", 5)\n\t\t\t\tif hrp then\n\t\t\t\t\tlocal spawnCF = _G.LobbySpawnCF\n\t\t\t\t\t\tor CFrame.new(self.Config.MANIFEST_X, self.Config.MANIFEST_Y, self.Config.MANIFEST_Z)\n\t\t\t\t\thrp.CFrame = spawnCF\n\t\t\t\tend\n\t\t\tend)\n\t\tend\n\tend\n\n\tPlayers.PlayerAdded:Connect(handlePlayer)\n\tfor _, player in ipairs(Players:GetPlayers()) do\n\t\ttask.spawn(handlePlayer, player)\n\tend\nend\n\nfunction CharacterService:Init()\n\tprint(\"🏮 [CHAR] 4D Manifest Bridge Fixed.\")\nend\n\nreturn CharacterService\n","afterSource":"--[=[\n    CharacterService.luau\n    Status: VAULT-READY | 4D-Hardened | Sovereign Blueprint\n    Governance: State Stewardship §4, Spatio-Temporal Anchoring §3\n]=]\n\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\n-- Sovereign Anchors\nlocal OMC = ReplicatedStorage:WaitForChild(\"OMC\")\nlocal Generated = OMC:WaitForChild(\"Generated\")\nlocal Telemetry = require(Generated:WaitForChild(\"Telemetry\"))\nlocal Governance = require(script.Parent:WaitForChild(\"MetropolisGovernance\"))\n\n-- Native Bridge Factory (SafeFire)\nlocal function CreateBridge(name)\n\tlocal remote = ReplicatedStorage:FindFirstChild(name) or Instance.new(\"RemoteEvent\")\n\tremote.Name = name\n\tremote.Parent = ReplicatedStorage\n\treturn {\n\t\tFireAll = function(...) remote:FireAllClients(...) end,\n\t\t_remote = remote\n\t}\nend\n\nlocal CharacterService = {\n\tName = \"CharacterService\",\n\tConfig = {\n\t\tAPPLY_APPEARANCE = true,\n\t\tLOAD_TIMEOUT = 10,\n\t\tMANIFEST_Y = 62,   -- Arena floor level (fallback if LobbySpawnCF not ready)\n\t\tMANIFEST_X = 1012, -- Arena center X\n\t\tMANIFEST_Z = 1007, -- Arena center Z\n\t},\n\tBridges = {\n\t\tManifest = CreateBridge(\"OMC_CharacterManifest\"),\n\t},\n\tState = { players = {} },\n}\n\n-- [[ MANIFESTATION LOGIC ]]\n\nfunction CharacterService:_applyAppearance(player, character)\n\tif not self.Config.APPLY_APPEARANCE then return end\n\tlocal humanoid = character:WaitForChild(\"Humanoid\", self.Config.LOAD_TIMEOUT)\n\tif not humanoid then return end\n\t\n\tlocal success, description = pcall(function()\n\t\treturn Players:GetHumanoidDescriptionFromUserId(player.UserId)\n\tend)\n\t\n\tif success and description then\n\t\tpcall(function() humanoid:ApplyDescription(description) end)\n\tend\nend\n\n-- [[ LIFECYCLE IGNITION ]]\n\nfunction CharacterService:Start()\n\tlocal function handlePlayer(player)\n\t\tplayer.CharacterAdded:Connect(function(char)\n\t\t\tlocal humanoid = char:WaitForChild(\"Humanoid\", 10)\n\t\t\tlocal hrp = char:WaitForChild(\"HumanoidRootPart\", 5)\n\t\t\t\n\t\t\tif humanoid then\n\t\t\t\thumanoid.WalkSpeed = 32 -- Sovereign Speed\n\t\t\t\thumanoid.JumpPower = 100 -- Cybernetic Jump\n\t\t\t\thumanoid.UseJumpPower = true\n\t\t\tend\n\t\t\t\n\t\t\tif hrp then\n\t\t\t\tlocal spawnCF = _G.LobbySpawnCF\n\t\t\t\t\tor CFrame.new(self.Config.MANIFEST_X, self.Config.MANIFEST_Y, self.Config.MANIFEST_Z)\n\t\t\t\thrp.CFrame = spawnCF\n\t\t\tend\n\t\t\t\n\t\t\tself:_applyAppearance(player, char)\n\t\t\tself.Bridges.Manifest:FireAll(\"LOADED\", player.Name)\n\t\t\tTelemetry.dispatchPulse({ event = \"Character_Manifest\", player = player.Name })\n\t\tend)\n\t\t\n\t\t-- Also handle the current character if it already exists\n\t\tif player.Character then\n\t\t\ttask.spawn(function()\n\t\t\t\tlocal hrp = player.Character:WaitForChild(\"HumanoidRootPart\", 5)\n\t\t\t\tif hrp then\n\t\t\t\t\tlocal spawnCF = _G.LobbySpawnCF\n\t\t\t\t\t\tor CFrame.new(self.Config.MANIFEST_X, self.Config.MANIFEST_Y, self.Config.MANIFEST_Z)\n\t\t\t\t\thrp.CFrame = spawnCF\n\t\t\t\tend\n\t\t\tend)\n\t\tend\n\tend\n\n\tPlayers.PlayerAdded:Connect(handlePlayer)\n\tfor _, player in ipairs(Players:GetPlayers()) do\n\t\ttask.spawn(handlePlayer, player)\n\tend\nend\n\nfunction CharacterService:Init()\n\tprint(\"🏮 [CHAR] 4D Manifest Bridge Fixed.\")\nend\n\nreturn CharacterService\n"}},"contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
{"timestamp":"2026-05-07T08:10:25.918Z","type":"write","direction":"forward","source":"studio","path":"game.ServerScriptService.OMC_Ignition.Source","details":"script:Script","diff":{"type":"script","scriptMeta":{"beforeLines":190,"afterLines":35},"scriptDiff":{"beforeSource":"-- [[ THE METROPOLIS IGNITION — ABSOULTE SOVEREIGN MODE ]]\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\n-- [[ 1. SOVEREIGN JANITOR PROTOCOL (IMMEDIATE EXECUTION) ]]\n-- We purge the land BEFORE requiring any modules to prevent compilation deadlocks.\n\nprint(\"🏮 [JANITOR] Frequency Sweep Initiated...\")\nlocal legacyFound = 0\nlocal ENABLE_DEEP_JANITOR_SCAN = false\n\n-- Scan & Destroy Shadow Framework Components\nlocal scanTargets = {\n\tgame:GetService(\"ServerScriptService\"):FindFirstChild(\"ServerSource\"),\n\tgame:GetService(\"ServerScriptService\"):FindFirstChild(\"OMC_Server\"), -- Legacy Anchor Purge\n\tReplicatedStorage:FindFirstChild(\"ClientSource\"),\n\tReplicatedStorage:FindFirstChild(\"Packages\"),\n}\n\nfor _, target in ipairs(scanTargets) do\n\tif target then\n\t\ttarget:Destroy()\n\t\tlegacyFound = legacyFound + 1\n\t\tprint(\"🏮 [JANITOR] Atomized legacy manifest: \" .. target.Name)\n\tend\nend\n\n-- Optional deep scan can be expensive on large places.\nif ENABLE_DEEP_JANITOR_SCAN then\n\tfor _, desc in ipairs(game:GetDescendants()) do\n\t\tif (desc:IsA(\"LuaSourceContainer\") and (desc.Name:find(\"Superbullet\") or desc.Name:find(\"Knit\"))) then\n\t\t\t-- Don't delete ourselves or our OMC siblings\n\t\t\tif not desc:IsDescendantOf(game:GetService(\"ServerScriptService\").OMC_Ignition) then\n\t\t\t\tdesc:Destroy()\n\t\t\t\tlegacyFound = legacyFound + 1\n\t\t\tend\n\t\tend\n\tend\nend\n\nif legacyFound > 0 then\n\twarn(\"🏮 [JANITOR] Purged \" .. legacyFound .. \" legacy frequency leaks. Land is clean.\")\nelse\n\tprint(\"🏮 [JANITOR] Land is Sovereign. No leaks detected.\")\nend\n\n-- [[ 2. SOVEREIGN MANIFESTATION ]]\n\nlocal OMC = ReplicatedStorage:WaitForChild(\"OMC\")\nlocal Generated = OMC:WaitForChild(\"Generated\")\nlocal Telemetry = require(Generated:WaitForChild(\"Telemetry\"))\n\n-- Atomic Pathing: Locate siblings\nlocal function getModule(name)\n\treturn script.Parent:FindFirstChild(name) or script.Parent.Parent:FindFirstChild(name, true)\nend\n\nlocal SovereignClientRouter = require(getModule(\"SovereignClientRouter\"))\nlocal CathedralRaveService = require(getModule(\"CathedralRaveService\"))\nlocal CharacterService = require(getModule(\"CharacterService\"))\nlocal LobbyService = require(getModule(\"LobbyService\"))\nlocal TagGameService = require(getModule(\"TagGameService\"))\nlocal DanceFloorService = require(getModule(\"DanceFloorService\"))\nlocal AtmosphereController = require(getModule(\"AtmosphereController\"))\nlocal VictimService = require(getModule(\"VictimService\"))\n\n-- Shared logic\nlocal MetropolisLighting = require(Generated:WaitForChild(\"MetropolisLighting\"))\nlocal TagArena = require(Generated:WaitForChild(\"TagArena\"))\nlocal HousingService = require(Generated:WaitForChild(\"HousingService\"))\n\n-- [[ 3. IGNITION SEQUENCE ]]\n\nlocal success, report = Telemetry.gateCheck()\n\nif success then\n\tprint(\"🏮 [IGNITION] Resonance Stabilized. Manifesting Sector Alpha...\")\n\t\n\t-- Initialize Sovereign Relay & Services\n\tlocal Router = SovereignClientRouter.new()\n\t_G.SovereignRouter = Router\n\n\t-- Clone cathedral model from ServerStorage into Workspace, grounded at dance floor centre\n\tlocal cathedralTemplate = game:GetService(\"ServerStorage\"):FindFirstChild(\"cathedral\")\n\tif cathedralTemplate then\n\t\tlocal clone = cathedralTemplate:Clone()\n\t\tclone.Parent = game:GetService(\"Workspace\")\n\t\t-- Remove the base plate so the arches sit at ground level\n\t\tlocal floorPlate = clone:FindFirstChild(\"CathedralFloor_Unified\")\n\t\tif floorPlate then floorPlate:Destroy() end\n\t\t-- Reposition: centre on X/Z=0, place base at Y=0.5 (dance floor surface)\n\t\tlocal boundsCF, boundsSize = clone:GetBoundingBox()\n\t\tlocal bottomY = boundsCF.Position.Y - boundsSize.Y / 2\n\t\tlocal pivotCF = clone:GetPivot()\n\t\tclone:PivotTo(CFrame.new(0, pivotCF.Position.Y - bottomY + 0.5, 0))\n\t\tprint(\"🏮 [IGNITION] Cathedral manifested in Workspace.\")\n\telse\n\t\twarn(\"🏮 [IGNITION] cathedral not found in ServerStorage — check Rojo sync.\")\n\tend\n\n\tlocal wallsTemplate = game:GetService(\"ServerStorage\"):FindFirstChild(\"BoundaryWalls\")\n\tif wallsTemplate then\n\t\tlocal clone = wallsTemplate:Clone()\n\t\tclone.Name = \"BoundaryWalls\"\n\t\tclone.Parent = game:GetService(\"Workspace\")\n\t\tprint(\"🏮 [IGNITION] BoundaryWalls manifested in Workspace.\")\n\telse\n\t\twarn(\"🏮 [IGNITION] BoundaryWalls not found in ServerStorage — check Rojo sync.\")\n\tend\n\n\tCharacterService:Init()\n\tCathedralRaveService:Init()\n\tTagGameService:Init()\n\tVictimService:Init()\n\tDanceFloorService:Init()\n\tLobbyService:Init()\n\n\tCharacterService:Start()\n\tlocal lobbyOk, lobbyErr = pcall(function() LobbyService:Start() end)\n\tif not lobbyOk then\n\t\twarn(\"🏮 [IGNITION] LobbyService failed: \" .. tostring(lobbyErr))\n\tend\n\tDanceFloorService:Start()\n\tAtmosphereController:Manifest()\n\tHousingService:Init()\n\tHousingService:Start()\n\tTagGameService:Start()\n\tVictimService:Start()\n\t\n\t-- Purge ghost manifestations in Workspace\n\tfor _, child in ipairs(game:GetService(\"Workspace\"):GetChildren()) do\n\t\tif child.Name == \"SectorAlpha_Arena\" or child.Name == \"Gothic_World\" then\n\t\t\tchild:Destroy()\n\t\t\tprint(\"🧹 [PURGE] Atomized legacy manifestation: \" .. child.Name)\n\t\tend\n\tend\n\n\tMetropolisLighting.apply()\n\tlocal arena = TagArena.generate()\n\n\t-- Anchor Executive Client & Chat Governance\n\tgame:GetService(\"Players\").PlayerAdded:Connect(function(player)\n\t\tif #game:GetService(\"Players\"):GetPlayers() == 1 then\n\t\t\tRouter:setExecutiveClient(player)\n\t\tend\n\t\t\n\t\t-- Rowdy Command Stability Hook\n\t\tplayer.Chatted:Connect(function(message)\n\t\t\tlocal msg = string.lower(message)\n\t\t\tif msg == \"/rowdy\" or msg == \"!rowdy\" then\n\t\t\t\tprint(\"🏮 [COMMAND] Rowdy Protocol triggered by \" .. player.Name)\n\t\t\t\tCathedralRaveService:Start()\n\t\t\t\t\n\t\t\t\t-- Rowdy Physical Reaction\n\t\t\t\tfor _, p in ipairs(game:GetService(\"Players\"):GetPlayers()) do\n\t\t\t\t\tif p.Character and p.Character:FindFirstChild(\"Humanoid\") then\n\t\t\t\t\t\tp.Character.Humanoid.WalkSpeed = p.Character.Humanoid.WalkSpeed + 8\n\t\t\t\t\t\tp.Character.Humanoid.Jump = true\n\t\t\t\t\t\ttask.delay(5, function()\n\t\t\t\t\t\t\tif p.Character and p.Character:FindFirstChild(\"Humanoid\") then\n\t\t\t\t\t\t\t\tp.Character.Humanoid.WalkSpeed = p.Character.Humanoid.WalkSpeed - 8\n\t\t\t\t\t\t\tend\n\t\t\t\t\t\tend)\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\tend)\n\tend)\n\n\t-- [[ MONETIZATION HANDLING ]]\n\tlocal MarketplaceService = game:GetService(\"MarketplaceService\")\n\tMarketplaceService.ProcessReceipt = function(receiptInfo)\n\t\tprint(\"🏮 [MONETIZATION] Investment Confirmed. Igniting Cathedral Rave.\")\n\t\t\n\t\t-- 1. Trigger the Rave locally\n\t\tCathedralRaveService:Start()\n\t\t\n\t\t-- 2. Dispatch the Economic Pulse to Node\n\t\tTelemetry.dispatchPulse({ \n\t\t\tevent = \"Sovereign_Purchase_Granted\", \n\t\t\tamount = receiptInfo.CurrencySpent \n\t\t})\n\t\t\n\t\treturn Enum.ProductPurchaseDecision.PurchaseGranted\n\tend\n\t\n\tprint(\"🏮 Sector Alpha: Manifestation Complete.\")\nelse\n\twarn(\"❌ [IGNITION] GOVERNANCE FAILURE. SECURING DOMAIN...\")\nend\n","afterSource":"-- CharacterService spawn fix injected via Weppy\n-- Forces spawn to arena center until LobbySpawnCF race is resolved\n\nlocal Players = game:GetService(\"Players\")\n\nlocal ARENA_SPAWN = CFrame.new(1012, 65, 1007)\n\nlocal function spawnPlayer(player)\n\tlocal function teleport()\n\t\tlocal char = player.Character\n\t\tlocal hrp  = char and char:FindFirstChild(\"HumanoidRootPart\")\n\t\tif hrp then\n\t\t\thrp.CFrame = _G.LobbySpawnCF or ARENA_SPAWN\n\t\tend\n\tend\n\t-- Try immediately and retry until it sticks\n\ttask.spawn(function()\n\t\tfor i = 1, 5 do\n\t\t\ttask.wait(0.2)\n\t\t\tteleport()\n\t\tend\n\tend)\nend\n\nPlayers.PlayerAdded:Connect(function(player)\n\tplayer.CharacterAdded:Connect(function()\n\t\tspawnPlayer(player)\n\tend)\nend)\n\n-- Handle already-connected players\nfor _, p in ipairs(Players:GetPlayers()) do\n\tif p.Character then spawnPlayer(p) end\nend\n"}},"contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
