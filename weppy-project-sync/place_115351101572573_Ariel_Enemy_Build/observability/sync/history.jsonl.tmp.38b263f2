{"timestamp":"2026-05-07T08:22:01.188Z","type":"write","direction":"forward","source":"studio","path":"game.ServerScriptService.OMC_Ignition.Source.CharacterService","details":"script:ModuleScript","diff":{"type":"script","scriptMeta":{"beforeLines":107,"afterLines":83},"scriptDiff":{"beforeSource":"--[=[\n    CharacterService.luau\n    Status: VAULT-READY | 4D-Hardened | Sovereign Blueprint\n    Governance: State Stewardship §4, Spatio-Temporal Anchoring §3\n]=]\n\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\n-- Sovereign Anchors\nlocal OMC = ReplicatedStorage:WaitForChild(\"OMC\")\nlocal Generated = OMC:WaitForChild(\"Generated\")\nlocal Telemetry = require(Generated:WaitForChild(\"Telemetry\"))\nlocal Governance = require(script.Parent:WaitForChild(\"MetropolisGovernance\"))\n\n-- Native Bridge Factory (SafeFire)\nlocal function CreateBridge(name)\n\tlocal remote = ReplicatedStorage:FindFirstChild(name) or Instance.new(\"RemoteEvent\")\n\tremote.Name = name\n\tremote.Parent = ReplicatedStorage\n\treturn {\n\t\tFireAll = function(...) remote:FireAllClients(...) end,\n\t\t_remote = remote\n\t}\nend\n\nlocal CharacterService = {\n\tName = \"CharacterService\",\n\tConfig = {\n\t\tAPPLY_APPEARANCE = true,\n\t\tLOAD_TIMEOUT = 10,\n\t\tMANIFEST_Y = 62,   -- Arena floor level (fallback if LobbySpawnCF not ready)\n\t\tMANIFEST_X = 1012, -- Arena center X\n\t\tMANIFEST_Z = 1007, -- Arena center Z\n\t},\n\tBridges = {\n\t\tManifest = CreateBridge(\"OMC_CharacterManifest\"),\n\t},\n\tState = { players = {} },\n}\n\n-- [[ MANIFESTATION LOGIC ]]\n\nfunction CharacterService:_applyAppearance(player, character)\n\tif not self.Config.APPLY_APPEARANCE then return end\n\tlocal humanoid = character:WaitForChild(\"Humanoid\", self.Config.LOAD_TIMEOUT)\n\tif not humanoid then return end\n\t\n\tlocal success, description = pcall(function()\n\t\treturn Players:GetHumanoidDescriptionFromUserId(player.UserId)\n\tend)\n\t\n\tif success and description then\n\t\tpcall(function() humanoid:ApplyDescription(description) end)\n\tend\nend\n\n-- [[ LIFECYCLE IGNITION ]]\n\nfunction CharacterService:Start()\n\tlocal function handlePlayer(player)\n\t\tplayer.CharacterAdded:Connect(function(char)\n\t\t\tlocal humanoid = char:WaitForChild(\"Humanoid\", 10)\n\t\t\tlocal hrp = char:WaitForChild(\"HumanoidRootPart\", 5)\n\t\t\t\n\t\t\tif humanoid then\n\t\t\t\thumanoid.WalkSpeed = 32 -- Sovereign Speed\n\t\t\t\thumanoid.JumpPower = 100 -- Cybernetic Jump\n\t\t\t\thumanoid.UseJumpPower = true\n\t\t\tend\n\t\t\t\n\t\t\tif hrp then\n\t\t\t\tlocal spawnCF = _G.LobbySpawnCF\n\t\t\t\t\tor CFrame.new(self.Config.MANIFEST_X, self.Config.MANIFEST_Y, self.Config.MANIFEST_Z)\n\t\t\t\thrp.CFrame = spawnCF\n\t\t\tend\n\t\t\t\n\t\t\tself:_applyAppearance(player, char)\n\t\t\tself.Bridges.Manifest:FireAll(\"LOADED\", player.Name)\n\t\t\tTelemetry.dispatchPulse({ event = \"Character_Manifest\", player = player.Name })\n\t\tend)\n\t\t\n\t\t-- Also handle the current character if it already exists\n\t\tif player.Character then\n\t\t\ttask.spawn(function()\n\t\t\t\tlocal hrp = player.Character:WaitForChild(\"HumanoidRootPart\", 5)\n\t\t\t\tif hrp then\n\t\t\t\t\tlocal spawnCF = _G.LobbySpawnCF\n\t\t\t\t\t\tor CFrame.new(self.Config.MANIFEST_X, self.Config.MANIFEST_Y, self.Config.MANIFEST_Z)\n\t\t\t\t\thrp.CFrame = spawnCF\n\t\t\t\tend\n\t\t\tend)\n\t\tend\n\tend\n\n\tPlayers.PlayerAdded:Connect(handlePlayer)\n\tfor _, player in ipairs(Players:GetPlayers()) do\n\t\ttask.spawn(handlePlayer, player)\n\tend\nend\n\nfunction CharacterService:Init()\n\tprint(\"🏮 [CHAR] 4D Manifest Bridge Fixed.\")\nend\n\nreturn CharacterService\n","afterSource":"--[=[\n    CharacterService.luau\n    Status: VAULT-READY | 4D-Hardened | Sovereign Blueprint\n    Spawn teleport is handled by OMC_Ignition.Source (raycast-based).\n    This module handles: appearance, stats, telemetry bridge ONLY.\n]=]\n\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal OMC = ReplicatedStorage:WaitForChild(\"OMC\")\nlocal Generated = OMC:WaitForChild(\"Generated\")\nlocal Telemetry = require(Generated:WaitForChild(\"Telemetry\"))\nlocal Governance = require(script.Parent:WaitForChild(\"MetropolisGovernance\"))\n\nlocal function CreateBridge(name)\n\tlocal remote = ReplicatedStorage:FindFirstChild(name) or Instance.new(\"RemoteEvent\")\n\tremote.Name = name\n\tremote.Parent = ReplicatedStorage\n\treturn {\n\t\tFireAll = function(...) remote:FireAllClients(...) end,\n\t\t_remote = remote\n\t}\nend\n\nlocal CharacterService = {\n\tName = \"CharacterService\",\n\tConfig = {\n\t\tAPPLY_APPEARANCE = true,\n\t\tLOAD_TIMEOUT = 10,\n\t},\n\tBridges = {\n\t\tManifest = CreateBridge(\"OMC_CharacterManifest\"),\n\t},\n\tState = { players = {} },\n}\n\nfunction CharacterService:_applyAppearance(player, character)\n\tif not self.Config.APPLY_APPEARANCE then return end\n\tlocal humanoid = character:WaitForChild(\"Humanoid\", self.Config.LOAD_TIMEOUT)\n\tif not humanoid then return end\n\tlocal success, description = pcall(function()\n\t\treturn Players:GetHumanoidDescriptionFromUserId(player.UserId)\n\tend)\n\tif success and description then\n\t\tpcall(function() humanoid:ApplyDescription(description) end)\n\tend\nend\n\nfunction CharacterService:Start()\n\tlocal function handlePlayer(player)\n\t\tplayer.CharacterAdded:Connect(function(char)\n\t\t\tlocal humanoid = char:WaitForChild(\"Humanoid\", 10)\n\n\t\t\t-- Stats only — NO teleport here, OMC_Ignition.Source owns spawn position\n\t\t\tif humanoid then\n\t\t\t\thumanoid.WalkSpeed = 32\n\t\t\t\thumanoid.JumpPower = 100\n\t\t\t\thumanoid.UseJumpPower = true\n\t\t\tend\n\n\t\t\tself:_applyAppearance(player, char)\n\t\t\tself.Bridges.Manifest:FireAll(\"LOADED\", player.Name)\n\t\t\tTelemetry.dispatchPulse({ event = \"Character_Manifest\", player = player.Name })\n\t\tend)\n\n\t\tif player.Character then\n\t\t\tself:_applyAppearance(player, player.Character)\n\t\tend\n\tend\n\n\tPlayers.PlayerAdded:Connect(handlePlayer)\n\tfor _, player in ipairs(Players:GetPlayers()) do\n\t\ttask.spawn(handlePlayer, player)\n\tend\nend\n\nfunction CharacterService:Init()\n\tprint(\"[CHAR] Service ready — spawn owned by Ignition.Source\")\nend\n\nreturn CharacterService\n"}},"contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
{"timestamp":"2026-05-07T08:40:55.749Z","type":"write","direction":"forward","source":"studio","path":"game.Workspace.ArenaFloor","details":"props","diff":{"type":"props","changedProperties":{"TopSurface":{"before":null,"after":"Enum.SurfaceType.Smooth"},"BottomSurface":{"before":null,"after":"Enum.SurfaceType.Smooth"},"BrickColor":{"before":null,"after":"Dark grey metallic"},"Material":{"before":null,"after":"Enum.Material.SmoothPlastic"},"Color":{"before":null,"after":{"b":87,"g":88,"r":87}},"Anchored":{"before":null,"after":true},"CFrame":{"before":null,"after":[1012,58,1007,1,0,0,0,1,0,0,0,1]},"Size":{"before":null,"after":{"y":2,"x":120,"z":120}}}},"contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
