{"timestamp":"2026-05-07T07:36:40.747Z","type":"write","direction":"forward","source":"studio","path":"game.StarterPlayer.StarterPlayerScripts.OMCClientBootstrap","details":"props","contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
{"timestamp":"2026-05-07T07:36:40.748Z","type":"write","direction":"forward","source":"studio","path":"game.StarterPlayer.StarterPlayerScripts.OMCClientBootstrap","details":"script:LocalScript","diff":{"type":"script","scriptMeta":{"beforeLines":null,"afterLines":39},"scriptDiff":{"beforeSource":null,"afterSource":"local Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal player = Players.LocalPlayer\nlocal omcRoot = ReplicatedStorage:WaitForChild(\"OMC\")\nlocal generated = omcRoot:WaitForChild(\"Generated\")\nlocal clientRoot = omcRoot:WaitForChild(\"Client\")\n\nlocal Telemetry = require(generated:WaitForChild(\"Telemetry\"))\nlocal CharacterController = require(clientRoot:WaitForChild(\"CharacterController\"))\nlocal MobilityController = require(clientRoot:WaitForChild(\"SovereignMobilityController\"))\nlocal LobbyController = require(clientRoot:WaitForChild(\"LobbyController\"))\n\nlocal services = {\n\tCharacterService = {\n\t\tCharacterLoaded = {\n\t\t\tConnect = function(_, _fn)\n\t\t\t\t-- Stubbed client bridge.\n\t\t\tend,\n\t\t},\n\t\tGetCharacter = function()\n\t\t\treturn player.Character\n\t\tend,\n\t},\n}\n\nCharacterController:Init(services)\nMobilityController:Init(services)\nLobbyController:Init()\n\nCharacterController:Start()\nMobilityController:Start()\nLobbyController:Start()\n\npcall(function()\n\tTelemetry.dispatchPulse({ event = \"Client_Bootstrap_Success\" })\nend)\nprint(\"[CLIENT] OMC bootstrap loaded from StarterPlayerScripts.\")\n"}},"contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
{"timestamp":"2026-05-07T07:36:40.749Z","type":"write","direction":"forward","source":"studio","path":"game.StarterPlayer.StarterPlayerScripts.PreloadAerialHawk","details":"props","contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
{"timestamp":"2026-05-07T07:36:40.750Z","type":"write","direction":"forward","source":"studio","path":"game.StarterPlayer.StarterPlayerScripts.PreloadAerialHawk","details":"script:LocalScript","diff":{"type":"script","scriptMeta":{"beforeLines":null,"afterLines":35},"scriptDiff":{"beforeSource":null,"afterSource":"-- Preloads the Aerial Hawk mesh assets on the client so the mesh is\n-- visible immediately when the hawk spawns in Workspace.\n-- Server-side PreloadAsync does nothing for client rendering.\n\nlocal ContentProvider = game:GetService(\"ContentProvider\")\n\nlocal MESH_ID    = \"http://www.roblox.com/asset/?id=120647529\"\nlocal TEXTURE_ID = \"http://www.roblox.com/asset/?id=120647378\"\n\nContentProvider:PreloadAsync({ MESH_ID, TEXTURE_ID })\nprint(\"[HAWK-CLIENT] Mesh assets preloaded\")\n\n-- Also watch for hawk spawning and force-render it\nlocal Workspace = game:GetService(\"Workspace\")\n\nlocal function onHawkAdded(instance)\n\tif instance.Name == \"AerialHawk\" and instance:IsA(\"Model\") then\n\t\tlocal root = instance:FindFirstChild(\"HumanoidRootPart\")\n\t\tif root then\n\t\t\t-- Touch the mesh to force client render\n\t\t\tlocal mesh = root:FindFirstChildOfClass(\"SpecialMesh\")\n\t\t\tif mesh then\n\t\t\t\tContentProvider:PreloadAsync({ mesh.MeshId, mesh.TextureId })\n\t\t\tend\n\t\tend\n\tend\nend\n\nWorkspace.ChildAdded:Connect(onHawkAdded)\n\n-- Catch it if already there\nfor _, child in ipairs(Workspace:GetChildren()) do\n\tonHawkAdded(child)\nend\n"}},"contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
