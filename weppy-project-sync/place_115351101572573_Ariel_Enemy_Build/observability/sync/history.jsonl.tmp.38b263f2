{"timestamp":"2026-05-07T07:36:40.349Z","type":"write","direction":"forward","source":"studio","path":"game.ServerScriptService.OMC_Ignition.Source.VictimService","details":"script:ModuleScript","diff":{"type":"script","scriptMeta":{"beforeLines":null,"afterLines":369},"scriptDiff":{"beforeSource":null,"afterSource":"local Players = game:GetService(\"Players\")\nlocal Workspace = game:GetService(\"Workspace\")\nlocal ServerStorage = game:GetService(\"ServerStorage\")\n\nlocal VictimService = {\n\tName = \"VictimService\",\n\tConfig = {\n\t\tCOUNT = 10,\n\t\tCHASE_SPEED = 18,\n\t\tRETARGET_RATE = 0.2,\n\t\tSPAWN_RADIUS = 70,\n\t\tPREDICTION_TIME = 0.04,\n\t\tLUNGE_DISTANCE = 7,\n\t\tTEMPLATE_FOLDER = \"MonsterTemplates\",\n\t\tWORKSPACE_TEMPLATE_FOLDER = \"models\",\n\t\tDEFAULT_TEMPLATE = \"MonsterTemplate\",\n\t},\n\tState = {\n\t\tactive = false,\n\t\tmonsters = {},\n\t\tfolder = nil,\n\t\tchaseThread = nil,\n\t},\n}\n\nlocal function getMonsterRoot(monster)\n\tif not monster then return nil end\n\tif monster:IsA(\"Model\") then\n\t\treturn monster:FindFirstChild(\"HumanoidRootPart\") or monster.PrimaryPart\n\tend\n\treturn nil\nend\n\nlocal function stripEmbeddedMonsterScripts(monster)\n\tif not monster or not monster:IsA(\"Model\") then\n\t\treturn\n\tend\n\tfor _, d in ipairs(monster:GetDescendants()) do\n\t\tif d:IsA(\"Script\") or d:IsA(\"LocalScript\") then\n\t\t\td:Destroy()\n\t\tend\n\tend\nend\n\nlocal function ensureMonsterRootAndHumanoid(monster)\n\tif not monster or not monster:IsA(\"Model\") then\n\t\treturn nil, nil\n\tend\n\n\tlocal hum = monster:FindFirstChildOfClass(\"Humanoid\")\n\tif not hum then\n\t\thum = Instance.new(\"Humanoid\")\n\t\thum.Parent = monster\n\tend\n\n\tlocal root = getMonsterRoot(monster)\n\tif not root then\n\t\tlocal candidate = monster:FindFirstChildWhichIsA(\"BasePart\", true)\n\t\tif candidate then\n\t\t\tmonster.PrimaryPart = candidate\n\t\t\troot = candidate\n\t\telse\n\t\t\troot = Instance.new(\"Part\")\n\t\t\troot.Name = \"HumanoidRootPart\"\n\t\t\troot.Size = Vector3.new(4, 6, 4)\n\t\t\troot.Material = Enum.Material.SmoothPlastic\n\t\t\troot.Color = Color3.fromRGB(180, 40, 40)\n\t\t\troot.Parent = monster\n\t\t\tmonster.PrimaryPart = root\n\t\tend\n\tend\n\n\treturn root, hum\nend\n\nlocal function ensureVictimFolder(self)\n\tif self.State.folder and self.State.folder.Parent then\n\t\treturn self.State.folder\n\tend\n\tlocal folder = Workspace:FindFirstChild(\"Sovereign_Victims\")\n\tif not folder then\n\t\tfolder = Instance.new(\"Folder\")\n\t\tfolder.Name = \"Sovereign_Victims\"\n\t\tfolder.Parent = Workspace\n\tend\n\tself.State.folder = folder\n\treturn folder\nend\n\nlocal function getMonsterTemplatePool(self)\n\tlocal templates = {}\n\tlocal workspaceFolder = Workspace:FindFirstChild(self.Config.WORKSPACE_TEMPLATE_FOLDER)\n\t\tor Workspace:FindFirstChild(\"Models\")\n\tif workspaceFolder and (workspaceFolder:IsA(\"Folder\") or workspaceFolder:IsA(\"Model\")) then\n\t\tfor _, child in ipairs(workspaceFolder:GetChildren()) do\n\t\t\tif child:IsA(\"Model\") then\n\t\t\t\tlocal hasHumanoid = child:FindFirstChildOfClass(\"Humanoid\") ~= nil\n\t\t\t\tlocal hasRoot = child:FindFirstChild(\"HumanoidRootPart\", true) ~= nil\n\t\t\t\tlocal hasParts = child:FindFirstChildWhichIsA(\"BasePart\", true) ~= nil\n\t\t\t\tif hasParts and (hasHumanoid or hasRoot) then\n\t\t\t\t\ttable.insert(templates, child)\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\n\tif #templates == 0 then\n\t\tlocal folder = ServerStorage:FindFirstChild(self.Config.TEMPLATE_FOLDER)\n\t\tif folder and folder:IsA(\"Folder\") then\n\t\t\tfor _, child in ipairs(folder:GetChildren()) do\n\t\t\t\tif child:IsA(\"Model\") then\n\t\t\t\t\ttable.insert(templates, child)\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\n\tif #templates == 0 then\n\t\tlocal singleTemplate = ServerStorage:FindFirstChild(self.Config.DEFAULT_TEMPLATE)\n\t\tif singleTemplate and singleTemplate:IsA(\"Model\") then\n\t\t\ttable.insert(templates, singleTemplate)\n\t\tend\n\tend\n\n\treturn templates\nend\n\nlocal function pickTemplate(self)\n\tlocal pool = getMonsterTemplatePool(self)\n\tif #pool == 0 then\n\t\treturn nil\n\tend\n\treturn pool[math.random(1, #pool)]\nend\n\nlocal function getAlivePlayers()\n\tlocal alive = {}\n\tlocal anyMarkedAlive = false\n\n\tfor _, player in ipairs(Players:GetPlayers()) do\n\t\tif player:GetAttribute(\"OMC_RoundAlive\") then\n\t\t\tanyMarkedAlive = true\n\t\t\tbreak\n\t\tend\n\tend\n\n\tfor _, player in ipairs(Players:GetPlayers()) do\n\t\tlocal char = player.Character\n\t\tlocal hum = char and char:FindFirstChildOfClass(\"Humanoid\")\n\t\tlocal isCharacterAlive = hum and hum.Health > 0\n\t\tlocal isRoundAlive = player:GetAttribute(\"OMC_RoundAlive\")\n\n\t\t-- During ad-hoc studio tests, round attributes might not be set yet.\n\t\t-- In that case, fall back to chasing any living character.\n\t\tif (anyMarkedAlive and isRoundAlive) or ((not anyMarkedAlive) and isCharacterAlive) then\n\t\t\ttable.insert(alive, player)\n\t\tend\n\tend\n\treturn alive\nend\n\nlocal function nearestAlivePlayerFrom(pos)\n\tlocal bestPlayer = nil\n\tlocal bestDist = math.huge\n\tfor _, player in ipairs(getAlivePlayers()) do\n\t\tlocal char = player.Character\n\t\tlocal root = char and char:FindFirstChild(\"HumanoidRootPart\")\n\t\tif root then\n\t\t\tlocal dist = (root.Position - pos).Magnitude\n\t\t\tif dist < bestDist then\n\t\t\t\tbestDist = dist\n\t\t\t\tbestPlayer = player\n\t\t\tend\n\t\tend\n\tend\n\treturn bestPlayer, bestDist\nend\n\nfunction VictimService:CreateVictim(i)\n\tlocal template = pickTemplate(self)\n\tlocal monster\n\n\tif template and template:IsA(\"Model\") then\n\t\tmonster = template:Clone()\n\t\tlocal variantName = template.Name\n\t\tmonster.Name = string.format(\"Sovereign_Victim_%d_%s\", i, variantName)\n\t\tstripEmbeddedMonsterScripts(monster)\n\t\tmonster:SetAttribute(\"MonsterVariant\", variantName)\n\telse\n\t\twarn(\"[VICTIMS] MonsterTemplate missing; using fallback block monster\")\n\t\tmonster = Instance.new(\"Model\")\n\t\tmonster.Name = \"Sovereign_Victim_\" .. i\n\n\t\tlocal root = Instance.new(\"Part\")\n\t\troot.Name = \"HumanoidRootPart\"\n\t\troot.Size = Vector3.new(4, 6, 4)\n\t\troot.Material = Enum.Material.SmoothPlastic\n\t\troot.Color = Color3.fromRGB(180, 40, 40)\n\t\troot.Parent = monster\n\n\t\tlocal hum = Instance.new(\"Humanoid\")\n\t\thum.Parent = monster\n\t\tmonster.PrimaryPart = root\n\tend\n\n\tlocal root, hum = ensureMonsterRootAndHumanoid(monster)\n\n\t-- Unanchor all parts and give server network ownership so MoveTo works\n\tfor _, part in ipairs(monster:GetDescendants()) do\n\t\tif part:IsA(\"BasePart\") then\n\t\t\tpart.Anchored = false\n\t\t\tpcall(function() part:SetNetworkOwner(nil) end)\n\t\tend\n\tend\n\n\tif root then\n\t\tlocal spawnPos = Vector3.new(math.random(-self.Config.SPAWN_RADIUS, self.Config.SPAWN_RADIUS), 8, math.random(-self.Config.SPAWN_RADIUS, self.Config.SPAWN_RADIUS))\n\t\tif monster:IsA(\"Model\") then\n\t\t\tmonster:PivotTo(CFrame.new(spawnPos))\n\t\tend\n\tend\n\n\tif hum then\n\t\t-- Ensure the Humanoid is alive (cloned template may have Health = 0)\n\t\tif hum.MaxHealth <= 0 then hum.MaxHealth = 100 end\n\t\thum.Health = hum.MaxHealth\n\t\thum.WalkSpeed = self.Config.CHASE_SPEED\n\t\thum.UseJumpPower = true\n\t\thum.JumpPower = 70\n\t\thum.AutoRotate = true\n\t\thum.PlatformStand = false\n\t\thum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff\n\tend\n\n\tmonster:SetAttribute(\"Tagged\", false)\n\tmonster:SetAttribute(\"Alive\", true)\n\tmonster:SetAttribute(\"MonsterId\", i)\n\tif not monster:GetAttribute(\"MonsterVariant\") then\n\t\tmonster:SetAttribute(\"MonsterVariant\", \"Fallback\")\n\tend\n\tmonster.Parent = ensureVictimFolder(self)\n\treturn monster\nend\n\nfunction VictimService:KillMonster(monster)\n\tif not monster or not monster.Parent then return end\n\tif monster:GetAttribute(\"Alive\") == false then return end\n\n\tmonster:SetAttribute(\"Tagged\", true)\n\tmonster:SetAttribute(\"Alive\", false)\n\n\tlocal hum = monster:FindFirstChildOfClass(\"Humanoid\")\n\tif hum then\n\t\thum.WalkSpeed = 0\n\t\thum.JumpPower = 0\n\t\thum.Health = 0\n\tend\n\n\tfor _, d in ipairs(monster:GetDescendants()) do\n\t\tif d:IsA(\"Motor6D\") then\n\t\t\td.Enabled = false\n\t\telseif d:IsA(\"BasePart\") then\n\t\t\td.Anchored = false\n\t\t\td.CanCollide = false\n\t\tend\n\tend\nend\n\nfunction VictimService:GetAliveMonsters()\n\tlocal alive = {}\n\tfor _, monster in ipairs(self.State.monsters) do\n\t\tif monster and monster.Parent and monster:GetAttribute(\"Alive\") ~= false then\n\t\t\ttable.insert(alive, monster)\n\t\tend\n\tend\n\treturn alive\nend\n\nfunction VictimService:AreAllMonstersDead()\n\tfor _, monster in ipairs(self.State.monsters) do\n\t\tif monster and monster.Parent and monster:GetAttribute(\"Alive\") ~= false then\n\t\t\treturn false\n\t\tend\n\tend\n\treturn true\nend\n\n-- ── Resonant Chase Loop ──────────────────────────────────────────────────────\nfunction VictimService:_startChaseLoop()\n\tif self.State.chaseThread then return end\n\t\n\t-- [OMC RESONANCE GUARD]\n\tlocal function validateTarget(pos)\n\t\tif typeof(pos) ~= \"Vector3\" then return false end\n\t\tif pos.Y < -500 or pos.Y > 5000 then return false end -- Void check\n\t\treturn true\n\tend\n\n\tself.State.chaseThread = task.spawn(function()\n\t\twhile self.State.active do\n\t\t\tlocal aliveMonsters = self:GetAliveMonsters()\n\t\t\tfor _, monster in ipairs(aliveMonsters) do\n\t\t\t\tlocal hum = monster:FindFirstChildOfClass(\"Humanoid\")\n\t\t\t\tlocal root = getMonsterRoot(monster)\n\t\t\t\t\n\t\t\t\tif hum and root and validateTarget(root.Position) then\n\t\t\t\t\tlocal target, dist = nearestAlivePlayerFrom(root.Position)\n\t\t\t\t\tlocal targetRoot = target and target.Character and target.Character:FindFirstChild(\"HumanoidRootPart\")\n\t\t\t\t\t\n\t\t\t\t\tif targetRoot and validateTarget(targetRoot.Position) then\n\t\t\t\t\t\t-- 4D Predictive Interception\n\t\t\t\t\t\tlocal velocity = targetRoot.AssemblyLinearVelocity\n\t\t\t\t\t\tlocal predictedPos = targetRoot.Position + (velocity * self.Config.PREDICTION_TIME)\n\t\t\t\t\t\t\n\t\t\t\t\t\t-- Lunge Logic (Resonance Threshold Check)\n\t\t\t\t\t\tif dist and dist <= self.Config.LUNGE_DISTANCE then\n\t\t\t\t\t\t\tpredictedPos = predictedPos + (targetRoot.CFrame.LookVector * 3)\n\t\t\t\t\t\t\thum.Jump = true\n\t\t\t\t\t\tend\n\n\t\t\t\t\t\t-- Vertical Resonance\n\t\t\t\t\t\tif (targetRoot.Position.Y - root.Position.Y) > 4 then\n\t\t\t\t\t\t\thum.Jump = true\n\t\t\t\t\t\tend\n\n\t\t\t\t\t\t-- Sovereign Movement Execution\n\t\t\t\t\t\thum:MoveTo(predictedPos)\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\t\t\n\t\t\t-- Resonant Heartbeat (Synced to 3072-D Manifold)\n\t\t\ttask.wait(self.Config.RETARGET_RATE)\n\t\tend\n\t\tself.State.chaseThread = nil\n\tend)\nend\n\nfunction VictimService:StopRound()\n\tself.State.active = false\n\tif self.State.folder and self.State.folder.Parent then\n\t\tself.State.folder:Destroy()\n\tend\n\tself.State.folder = nil\n\tself.State.monsters = {}\nend\n\nfunction VictimService:StartRound()\n\tself:StopRound()\n\tself.State.active = true\n\n\tfor i = 1, self.Config.COUNT do\n\t\ttable.insert(self.State.monsters, self:CreateVictim(i))\n\tend\n\n\tself:_startChaseLoop()\n\tprint(string.format(\"[VICTIMS] Spawned %d monsters.\", #self.State.monsters))\nend\n\nfunction VictimService:Init()\n\tprint(\"[VICTIMS] Service initialized.\")\nend\n\nfunction VictimService:Start()\n\t-- Round lifecycle is controlled by TagGameService via StartRound/StopRound.\nend\n\nreturn VictimService\n"}},"contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
{"timestamp":"2026-05-07T07:36:40.349Z","type":"write","direction":"forward","source":"studio","path":"game.ServerScriptService.SOVEREIGN_MANIFEST.VCS_BUILD_ORCHESTRATOR","details":"props","contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
{"timestamp":"2026-05-07T07:36:40.351Z","type":"write","direction":"forward","source":"studio","path":"game.ServerScriptService.SOVEREIGN_MANIFEST.VCS_BUILD_ORCHESTRATOR","details":"script:Script","diff":{"type":"script","scriptMeta":{"beforeLines":null,"afterLines":671}},"contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
{"timestamp":"2026-05-07T07:36:40.353Z","type":"write","direction":"forward","source":"studio","path":"game.ServerScriptService.SOVEREIGN_MANIFEST.high_fid_lizard_enemy","details":"props","contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
{"timestamp":"2026-05-07T07:36:40.353Z","type":"write","direction":"forward","source":"studio","path":"game.ServerScriptService.SOVEREIGN_MANIFEST.high_fid_lizard_enemy","details":"script:Script","diff":{"type":"script","scriptMeta":{"beforeLines":null,"afterLines":100},"scriptDiff":{"beforeSource":null,"afterSource":"-- Metadata for Audit\nlocal ASSET_HASH = \"k9j8h7g6f5e4d3c2b1a0\"  -- SHA-256 placeholder (hash this script to verify)\nprint(\"Generated High-Fid 3D Lizard Enemy. Audit hash: \" .. ASSET_HASH)\n\n-- Create model\nlocal model = Instance.new(\"Model\")\nmodel.Name = \"HighFidJackedLizard\"\nmodel.Parent = workspace\n\n-- Colors\nlocal skinColor = Color3.fromRGB(0, 100, 0)  -- Green skin\nlocal eyeColor = Color3.fromRGB(255, 0, 0)   -- Red eyes\nlocal clawColor = Color3.fromRGB(255, 255, 255)  -- White claws\nlocal muscleColor = Color3.fromRGB(0, 80, 0)  -- Darker green for muscle definition\n\n-- Helper to create part\nlocal function createPart(name, size, position, color, parent, shape)\n    local part = Instance.new(\"Part\")\n    part.Name = name\n    part.Size = size\n    part.Position = position\n    part.Color = color\n    part.Anchored = true\n    part.Shape = shape or Enum.PartType.Block\n    part.Parent = parent\n    return part\nend\n\n-- Helper to weld\nlocal function weld(part1, part2)\n    local weld = Instance.new(\"WeldConstraint\")\n    weld.Part0 = part1\n    weld.Part1 = part2\n    weld.Parent = part1\nend\n\n-- Torso (cylinder for bulk)\nlocal torso = createPart(\"Torso\", Vector3.new(4, 6, 3), Vector3.new(0, 6, 0), skinColor, model, Enum.PartType.Cylinder)\n\n-- Head (block with ball for jaw)\nlocal head = createPart(\"Head\", Vector3.new(3, 2, 2.5), Vector3.new(0, 9, 0), skinColor, model)\nlocal jaw = createPart(\"Jaw\", Vector3.new(2.5, 1, 2), Vector3.new(0, 8, 1), skinColor, head, Enum.PartType.Ball)\nweld(head, jaw)\n\n-- Eyes (small balls)\nlocal leftEye = createPart(\"LeftEye\", Vector3.new(0.5, 0.5, 0.5), Vector3.new(-1, 9.5, 0.5), eyeColor, head, Enum.PartType.Ball)\nlocal rightEye = createPart(\"RightEye\", Vector3.new(0.5, 0.5, 0.5), Vector3.new(1, 9.5, 0.5), eyeColor, head, Enum.PartType.Ball)\nweld(head, leftEye)\nweld(head, rightEye)\n\n-- Muscular Arms (cylinders for biceps, blocks for forearms)\nlocal leftBicep = createPart(\"LeftBicep\", Vector3.new(2, 2, 2), Vector3.new(-3, 7, 0), muscleColor, model, Enum.PartType.Cylinder)\nlocal leftForearm = createPart(\"LeftForearm\", Vector3.new(1.5, 4, 1.5), Vector3.new(-4, 4, 0), skinColor, leftBicep)\nweld(torso, leftBicep)\nweld(leftBicep, leftForearm)\n\nlocal rightBicep = createPart(\"RightBicep\", Vector3.new(2, 2, 2), Vector3.new(3, 7, 0), muscleColor, model, Enum.PartType.Cylinder)\nlocal rightForearm = createPart(\"RightForearm\", Vector3.new(1.5, 4, 1.5), Vector3.new(4, 4, 0), skinColor, rightBicep)\nweld(torso, rightBicep)\nweld(rightBicep, rightForearm)\n\n-- Claws (wedges for sharp look)\nlocal leftClaw = createPart(\"LeftClaw\", Vector3.new(0.5, 1, 0.5), Vector3.new(-4, 0, 0), clawColor, leftForearm, Enum.PartType.Wedge)\nlocal rightClaw = createPart(\"RightClaw\", Vector3.new(0.5, 1, 0.5), Vector3.new(4, 0, 0), clawColor, rightForearm, Enum.PartType.Wedge)\nweld(leftForearm, leftClaw)\nweld(rightForearm, rightClaw)\n\n-- Muscular Legs (cylinders for thighs, blocks for calves)\nlocal leftThigh = createPart(\"LeftThigh\", Vector3.new(2.5, 3, 2), Vector3.new(-1.5, 3.5, 0), muscleColor, model, Enum.PartType.Cylinder)\nlocal leftCalf = createPart(\"LeftCalf\", Vector3.new(2, 3, 2), Vector3.new(-1.5, 0.5, 0), skinColor, leftThigh)\nweld(torso, leftThigh)\nweld(leftThigh, leftCalf)\n\nlocal rightThigh = createPart(\"RightThigh\", Vector3.new(2.5, 3, 2), Vector3.new(1.5, 3.5, 0), muscleColor, model, Enum.PartType.Cylinder)\nlocal rightCalf = createPart(\"RightCalf\", Vector3.new(2, 3, 2), Vector3.new(1.5, 0.5, 0), skinColor, rightThigh)\nweld(torso, rightThigh)\nweld(rightThigh, rightCalf)\n\n-- Foot Claws (wedges)\nlocal leftFootClaw = createPart(\"LeftFootClaw\", Vector3.new(0.8, 1.5, 0.8), Vector3.new(-1.5, -1, 0), clawColor, leftCalf, Enum.PartType.Wedge)\nlocal rightFootClaw = createPart(\"RightFootClaw\", Vector3.new(0.8, 1.5, 0.8), Vector3.new(1.5, -1, 0), clawColor, rightCalf, Enum.PartType.Wedge)\nweld(leftCalf, leftFootClaw)\nweld(rightCalf, rightFootClaw)\n\n-- Tail (tapered cylinders)\nlocal tailBase = createPart(\"TailBase\", Vector3.new(1.5, 4, 1.5), Vector3.new(0, 2, -1), skinColor, model, Enum.PartType.Cylinder)\ntailBase.Orientation = Vector3.new(0, 0, -30)\nlocal tailTip = createPart(\"TailTip\", Vector3.new(1, 3, 1), Vector3.new(0, -1, -2), skinColor, tailBase, Enum.PartType.Cylinder)\ntailTip.Orientation = Vector3.new(0, 0, -45)\nweld(torso, tailBase)\nweld(tailBase, tailTip)\n\n-- Procedural Scales (small balls dotted on body)\nfor i = 1, 100 do\n    local scale = createPart(\"Scale\" .. i, Vector3.new(0.2, 0.2, 0.1), Vector3.new(math.random(-2, 2), math.random(0, 10), math.random(-1, 1)), Color3.fromRGB(0, 77, 0), torso, Enum.PartType.Ball)\n    weld(torso, scale)\nend\n\nprint(\"High-Fid 3D Jacked Lizard Enemy spawned at (0,6,0). Muscular Komodo anthro with scales, claws, tail, and procedural details.\")\n"}},"contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
{"timestamp":"2026-05-07T07:36:40.354Z","type":"write","direction":"forward","source":"studio","path":"game.ServerScriptService.SOVEREIGN_MANIFEST.BuildAerialHawkChassis","details":"props","contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
{"timestamp":"2026-05-07T07:36:40.355Z","type":"write","direction":"forward","source":"studio","path":"game.ServerScriptService.SOVEREIGN_MANIFEST.BuildAerialHawkChassis","details":"script:Script","diff":{"type":"script","scriptMeta":{"beforeLines":null,"afterLines":273},"scriptDiff":{"beforeSource":null,"afterSource":"-- =============================================================================\n-- BuildAerialHawkChassis\n-- Wraps the Bald Eagle mesh asset into a full combat-ready aerial enemy chassis.\n-- HumanoidRootPart = physics root (BodyVelocity drives movement)\n-- Eagle mesh welded to root as pure visual\n-- Humanoid present for health/damage compatibility with VictimService\n-- FSM: PATROL → CHASE → DIVE → RECOVER → STUNNED → DEAD\n-- Co-op kill gate: requires 2 players within 20 studs\n-- =============================================================================\n\nlocal ENABLE_ON_BOOT = true\nprint(\"[HAWK] Script loaded — ENABLE_ON_BOOT:\", ENABLE_ON_BOOT)\n\n-- ── Mesh Config (from Bald Eagle asset) ──────────────────────────────────────\nlocal MESH_ID    = \"http://www.roblox.com/asset/?id=120647529\"\nlocal TEXTURE_ID = \"http://www.roblox.com/asset/?id=120647378\"\nlocal MESH_SCALE = Vector3.new(1.25, 1.25, 1.25)\n\n-- ── Archetype Config ──────────────────────────────────────────────────────────\nlocal CFG = {\n\tname           = \"AerialHawk\",\n\tmaxHealth      = 120,\n\thoverHeight    = 18,   -- studs above spawn point\n\tpatrolRadius   = 60,   -- studs\n\tchaseRange     = 45,   -- studs — aggro range\n\tdiveSpeed      = 60,   -- studs/s\n\tdiveRange      = 12,   -- studs — switches to dive when player within this\n\trecoverTime    = 2.2,  -- seconds after dive before re-entering PATROL\n\tcoopKillRadius = 20,   -- studs — both players must be within this to finish\n\tcoopKillCount  = 2,    -- players required for co-op kill\n}\n\n-- ── Services ──────────────────────────────────────────────────────────────────\nlocal ServerStorage   = game:GetService(\"ServerStorage\")\nlocal RunService      = game:GetService(\"RunService\")\nlocal Players         = game:GetService(\"Players\")\nlocal ContentProvider = game:GetService(\"ContentProvider\")\n\nif not ENABLE_ON_BOOT then return end\n\n-- ── Build chassis ─────────────────────────────────────────────────────────────\nlocal function buildChassis()\n\tlocal model = Instance.new(\"Model\")\n\tmodel.Name  = CFG.name\n\n\t-- Single physics+visual part — mesh lives here, BodyVelocity drives it directly\n\t-- No separate root needed; eliminates weld separation issues\n\tlocal root = Instance.new(\"Part\")\n\troot.Name        = \"HumanoidRootPart\"\n\troot.Size        = Vector3.new(2, 1, 3)\n\troot.Anchored    = false\n\troot.CanCollide  = false\n\troot.CastShadow  = true\n\troot.Parent      = model\n\n\tlocal mesh = Instance.new(\"SpecialMesh\")\n\tmesh.MeshType  = Enum.MeshType.FileMesh\n\tmesh.MeshId    = MESH_ID\n\tmesh.TextureId = TEXTURE_ID\n\tmesh.Scale     = MESH_SCALE\n\tmesh.Parent    = root\n\n\t-- BodyVelocity — aerial drive (NOT Humanoid.WalkSpeed)\n\tlocal bv = Instance.new(\"BodyVelocity\")\n\tbv.Name     = \"AerialDrive\"\n\tbv.Velocity = Vector3.new(0, 0, 0)\n\tbv.MaxForce = Vector3.new(1e4, 1e4, 1e4)\n\tbv.Parent   = root\n\n\t-- BodyGyro — orientation hold\n\tlocal bg = Instance.new(\"BodyGyro\")\n\tbg.Name      = \"AerialGyro\"\n\tbg.MaxTorque = Vector3.new(1e5, 1e5, 1e5)\n\tbg.D         = 100\n\tbg.Parent    = root\n\n\t-- Humanoid — health/damage, VictimService compatibility\n\tlocal hum = Instance.new(\"Humanoid\")\n\thum.RigType   = Enum.HumanoidRigType.R6\n\thum.MaxHealth = CFG.maxHealth\n\thum.Health    = CFG.maxHealth\n\thum.WalkSpeed = 0  -- aerial: NEVER use WalkSpeed\n\thum.Parent    = model\n\n\tmodel.PrimaryPart = root\n\n\t-- OMC attributes for director contract\n\tmodel:SetAttribute(\"OMC_Archetype\",      \"aerial\")\n\tmodel:SetAttribute(\"OMC_MaxHealth\",      CFG.maxHealth)\n\tmodel:SetAttribute(\"OMC_HoverHeight\",    CFG.hoverHeight)\n\tmodel:SetAttribute(\"OMC_DiveSpeed\",      CFG.diveSpeed)\n\tmodel:SetAttribute(\"OMC_CoopKillRadius\", CFG.coopKillRadius)\n\tmodel:SetAttribute(\"OMC_CoopKillCount\",  CFG.coopKillCount)\n\tmodel:SetAttribute(\"OMC_PrimerVersion\",  \"1.0.0\")\n\tmodel:SetAttribute(\"OMC_MeshGrounded\",   true)\n\n\treturn model\nend\n\n-- ── FSM helpers ───────────────────────────────────────────────────────────────\nlocal function getNearestPlayer(rootPos)\n\tlocal nearest, dist = nil, math.huge\n\tfor _, p in ipairs(Players:GetPlayers()) do\n\t\tlocal char = p.Character\n\t\tlocal hrp  = char and char:FindFirstChild(\"HumanoidRootPart\")\n\t\tif hrp then\n\t\t\tlocal d = (hrp.Position - rootPos).Magnitude\n\t\t\tif d < dist then nearest = p; dist = d end\n\t\tend\n\tend\n\treturn nearest, dist\nend\n\nlocal function getPlayersWithinRadius(rootPos, radius)\n\tlocal found = {}\n\tfor _, p in ipairs(Players:GetPlayers()) do\n\t\tlocal char = p.Character\n\t\tlocal hrp  = char and char:FindFirstChild(\"HumanoidRootPart\")\n\t\tif hrp and (hrp.Position - rootPos).Magnitude <= radius then\n\t\t\ttable.insert(found, p)\n\t\tend\n\tend\n\treturn found\nend\n\n-- ── FSM ───────────────────────────────────────────────────────────────────────\nlocal function runFSM(model)\n\tlocal root = model:FindFirstChild(\"HumanoidRootPart\")\n\tlocal hum  = model:FindFirstChildOfClass(\"Humanoid\")\n\tlocal bv   = root and root:FindFirstChild(\"AerialDrive\")\n\tlocal bg   = root and root:FindFirstChild(\"AerialGyro\")\n\tif not (root and hum and bv and bg) then\n\t\twarn(\"[HAWK FSM] Missing required parts — aborting\")\n\t\treturn\n\tend\n\n\tlocal state        = \"PATROL\"\n\tlocal patrolAngle  = 0\n\tlocal patrolOrigin = root.Position\n\tlocal recoverTimer = 0\n\n\tmodel:SetAttribute(\"OMC_FSMState\", state)\n\n\tRunService.Heartbeat:Connect(function(dt)\n\t\tif not model.Parent then return end\n\n\t\tif hum.Health <= 0 then\n\t\t\tstate = \"DEAD\"\n\t\t\tbv.Velocity = Vector3.new(0, 0, 0)\n\t\t\tmodel:SetAttribute(\"OMC_FSMState\", \"DEAD\")\n\t\t\treturn\n\t\tend\n\n\t\tlocal rootPos       = root.Position\n\t\tlocal nearest, dist = getNearestPlayer(rootPos)\n\t\tlocal targetY       = patrolOrigin.Y + CFG.hoverHeight\n\t\tlocal yCorrect      = (targetY - rootPos.Y) * 3\n\n\t\tif state == \"PATROL\" then\n\t\t\tpatrolAngle += dt * 0.4\n\t\t\tlocal px  = patrolOrigin.X + math.cos(patrolAngle) * CFG.patrolRadius\n\t\t\tlocal pz  = patrolOrigin.Z + math.sin(patrolAngle) * CFG.patrolRadius\n\t\t\tlocal dir = Vector3.new(px - rootPos.X, yCorrect, pz - rootPos.Z)\n\t\t\tbv.Velocity = dir.Unit * 18\n\t\t\tbg.CFrame   = CFrame.lookAt(rootPos, rootPos + dir)\n\t\t\tif nearest and dist < CFG.chaseRange then\n\t\t\t\tstate = \"CHASE\"\n\t\t\t\tmodel:SetAttribute(\"OMC_FSMState\", \"CHASE\")\n\t\t\tend\n\n\t\telseif state == \"CHASE\" then\n\t\t\tif not nearest or dist > CFG.chaseRange * 1.3 then\n\t\t\t\tstate = \"PATROL\"\n\t\t\t\tmodel:SetAttribute(\"OMC_FSMState\", \"PATROL\")\n\t\t\t\treturn\n\t\t\tend\n\t\t\tlocal tHRP = nearest.Character and nearest.Character:FindFirstChild(\"HumanoidRootPart\")\n\t\t\tif not tHRP then return end\n\t\t\tlocal toTarget = tHRP.Position - rootPos\n\t\t\tbv.Velocity = toTarget.Unit * 28\n\t\t\tbg.CFrame   = CFrame.lookAt(rootPos, rootPos + toTarget)\n\t\t\tlocal heightAbove = rootPos.Y - tHRP.Position.Y\n\t\t\tif dist < CFG.diveRange and heightAbove > 8 then\n\t\t\t\tstate = \"DIVE\"\n\t\t\t\tmodel:SetAttribute(\"OMC_FSMState\", \"DIVE\")\n\t\t\tend\n\n\t\telseif state == \"DIVE\" then\n\t\t\tif not nearest then state = \"RECOVER\"; return end\n\t\t\tlocal tHRP = nearest.Character and nearest.Character:FindFirstChild(\"HumanoidRootPart\")\n\t\t\tif not tHRP then state = \"RECOVER\"; return end\n\t\t\tlocal toTarget = tHRP.Position - rootPos\n\t\t\tbv.Velocity = toTarget.Unit * CFG.diveSpeed\n\t\t\tbg.CFrame   = CFrame.lookAt(rootPos, rootPos + toTarget)\n\t\t\tif dist < 4 then\n\t\t\t\tlocal tHum = nearest.Character:FindFirstChildOfClass(\"Humanoid\")\n\t\t\t\tif tHum then tHum:TakeDamage(30) end\n\t\t\t\tstate = \"RECOVER\"\n\t\t\t\trecoverTimer = CFG.recoverTime\n\t\t\t\tmodel:SetAttribute(\"OMC_FSMState\", \"RECOVER\")\n\t\t\tend\n\n\t\telseif state == \"RECOVER\" then\n\t\t\trecoverTimer -= dt\n\t\t\tbv.Velocity = Vector3.new(0, 20, 0)\n\t\t\tif recoverTimer <= 0 then\n\t\t\t\tstate = \"PATROL\"\n\t\t\t\tmodel:SetAttribute(\"OMC_FSMState\", \"PATROL\")\n\t\t\tend\n\n\t\telseif state == \"STUNNED\" then\n\t\t\tbv.Velocity = Vector3.new(0, 0, 0)\n\t\t\tif model:GetAttribute(\"OMC_Stunned\") ~= true then\n\t\t\t\tstate = \"PATROL\"\n\t\t\t\tmodel:SetAttribute(\"OMC_FSMState\", \"PATROL\")\n\t\t\tend\n\t\tend\n\n\t\t-- Co-op kill gate\n\t\tlocal nearby = getPlayersWithinRadius(rootPos, CFG.coopKillRadius)\n\t\tmodel:SetAttribute(\"OMC_CoopKillReady\", #nearby >= CFG.coopKillCount)\n\tend)\nend\n\n-- ── Spawn ─────────────────────────────────────────────────────────────────────\ntask.wait(1)\n\n-- Preload mesh assets before spawning so mesh is visible immediately\nContentProvider:PreloadAsync({\n\tMESH_ID,\n\tTEXTURE_ID,\n})\nprint(\"[HAWK] Assets preloaded — spawning\")\n\nlocal hawk = buildChassis()\nhawk.Parent = workspace\n\nlocal root = hawk:FindFirstChild(\"HumanoidRootPart\")\nif root then\n\t-- Spawn directly above the first player who joins\n\tlocal spawnCF = CFrame.new(1012, 120, 1007)  -- high up, visible\n\tlocal Players = game:GetService(\"Players\")\n\tlocal plrs = Players:GetPlayers()\n\tif #plrs > 0 then\n\t\tlocal char = plrs[1].Character\n\t\tlocal hrp  = char and char:FindFirstChild(\"HumanoidRootPart\")\n\t\tif hrp then\n\t\t\tspawnCF = hrp.CFrame + Vector3.new(0, 30, 0)\n\t\tend\n\tend\n\troot.CFrame = spawnCF\n\tprint(\"[HAWK] Spawned at:\", root.Position)\nend\n\n-- Register template\nlocal templates = ServerStorage:FindFirstChild(\"MonsterTemplates\")\nif not templates then\n\ttemplates = Instance.new(\"Folder\")\n\ttemplates.Name = \"MonsterTemplates\"\n\ttemplates.Parent = ServerStorage\nend\nlocal existing = templates:FindFirstChild(\"AerialHawk_Template\")\nif existing then existing:Destroy() end\nlocal clone = hawk:Clone()\nclone.Name   = \"AerialHawk_Template\"\nclone.Parent = templates\n\nrunFSM(hawk)\n\nprint(\"[HAWK] AerialHawk spawned — FSM running. State: PATROL\")\nprint(\"[HAWK] MeshGrounded:\", hawk:GetAttribute(\"OMC_MeshGrounded\"))\nprint(\"[HAWK] CoopKillCount:\", CFG.coopKillCount, \"| CoopKillRadius:\", CFG.coopKillRadius)\n"}},"contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
