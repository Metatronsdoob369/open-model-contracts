{"timestamp":"2026-05-07T08:20:56.858Z","type":"write","direction":"forward","source":"studio","path":"game.ServerScriptService.OMC_Ignition.Source","details":"script:Script","diff":{"type":"script","scriptMeta":{"beforeLines":35,"afterLines":56},"scriptDiff":{"beforeSource":"-- CharacterService spawn fix injected via Weppy\n-- Forces spawn to arena center until LobbySpawnCF race is resolved\n\nlocal Players = game:GetService(\"Players\")\n\nlocal ARENA_SPAWN = CFrame.new(1012, 65, 1007)\n\nlocal function spawnPlayer(player)\n\tlocal function teleport()\n\t\tlocal char = player.Character\n\t\tlocal hrp  = char and char:FindFirstChild(\"HumanoidRootPart\")\n\t\tif hrp then\n\t\t\thrp.CFrame = _G.LobbySpawnCF or ARENA_SPAWN\n\t\tend\n\tend\n\t-- Try immediately and retry until it sticks\n\ttask.spawn(function()\n\t\tfor i = 1, 5 do\n\t\t\ttask.wait(0.2)\n\t\t\tteleport()\n\t\tend\n\tend)\nend\n\nPlayers.PlayerAdded:Connect(function(player)\n\tplayer.CharacterAdded:Connect(function()\n\t\tspawnPlayer(player)\n\tend)\nend)\n\n-- Handle already-connected players\nfor _, p in ipairs(Players:GetPlayers()) do\n\tif p.Character then spawnPlayer(p) end\nend\n","afterSource":"-- OMC_Ignition.Source — Sovereign Spawn Fix v2\n-- Raycasts to find actual floor Y before teleporting player\n-- Retries to handle CharacterAdded race with geometry load\n\nlocal Players = game:GetService(\"Players\")\n\nlocal ARENA_X = 1012\nlocal ARENA_Z = 1007\nlocal FALLBACK_Y = 70  -- safe air height if raycast misses\n\nlocal function findFloorY(x, z)\n\tlocal rp = RaycastParams.new()\n\trp.FilterType = Enum.RaycastFilterType.Exclude\n\trp.FilterDescendantsInstances = {}\n\tlocal origin    = Vector3.new(x, 400, z)\n\tlocal direction = Vector3.new(0, -500, 0)\n\tlocal result    = workspace:Raycast(origin, direction, rp)\n\tif result then\n\t\treturn result.Position.Y + 5  -- 5 studs above floor surface\n\tend\n\treturn FALLBACK_Y\nend\n\nlocal function spawnPlayer(player)\n\ttask.spawn(function()\n\t\tfor i = 1, 8 do\n\t\t\ttask.wait(0.25)\n\t\t\tlocal char = player.Character\n\t\t\tlocal hrp  = char and char:FindFirstChild(\"HumanoidRootPart\")\n\t\t\tif hrp then\n\t\t\t\tlocal targetX = ARENA_X\n\t\t\t\tlocal targetZ = ARENA_Z\n\t\t\t\tif _G.LobbySpawnCF then\n\t\t\t\t\ttargetX = _G.LobbySpawnCF.Position.X\n\t\t\t\t\ttargetZ = _G.LobbySpawnCF.Position.Z\n\t\t\t\tend\n\t\t\t\tlocal spawnY = findFloorY(targetX, targetZ)\n\t\t\t\thrp.CFrame = CFrame.new(targetX, spawnY, targetZ)\n\t\t\t\tprint(string.format(\"[IGNITION] %s placed at (%.0f, %.1f, %.0f)\",\n\t\t\t\t\tplayer.Name, targetX, spawnY, targetZ))\n\t\t\t\tbreak\n\t\t\tend\n\t\tend\n\tend)\nend\n\nPlayers.PlayerAdded:Connect(function(player)\n\tplayer.CharacterAdded:Connect(function()\n\t\tspawnPlayer(player)\n\tend)\nend)\n\nfor _, p in ipairs(Players:GetPlayers()) do\n\tif p.Character then spawnPlayer(p) end\nend\n"}},"contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
