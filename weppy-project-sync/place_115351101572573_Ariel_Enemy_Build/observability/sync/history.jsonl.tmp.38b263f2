{"timestamp":"2026-05-07T07:41:31.267Z","type":"write","direction":"forward","source":"studio","path":"game.ServerScriptService.SetDuskLighting","details":"script:Script","diff":{"type":"script","scriptMeta":{"beforeLines":11,"afterLines":19},"scriptDiff":{"beforeSource":"-- Temporary dusk lighting for hawk visibility testing\n-- Delete this file when done testing\nlocal Lighting = game:GetService(\"Lighting\")\nLighting.ClockTime    = 18.5\nLighting.Brightness   = 2\nLighting.Ambient      = Color3.fromRGB(80, 60, 90)\nLighting.OutdoorAmbient = Color3.fromRGB(120, 80, 60)\nLighting.FogColor     = Color3.fromRGB(180, 120, 80)\nLighting.FogEnd       = 2000\nprint(\"[LIGHTING] Dusk set — ClockTime 18.5\")\n","afterSource":"-- Temporary dusk lighting for hawk visibility testing\n-- Runs after a delay to override MetropolisLighting (ClockTime=0)\nlocal Lighting = game:GetService(\"Lighting\")\n\nlocal function setDusk()\n\tLighting.ClockTime      = 18.5\n\tLighting.Brightness     = 3\n\tLighting.Ambient        = Color3.fromRGB(80, 60, 90)\n\tLighting.OutdoorAmbient = Color3.fromRGB(140, 100, 70)\n\t-- Remove midnight skybox so default dusk sky shows\n\tlocal sky = Lighting:FindFirstChildOfClass(\"Sky\")\n\tif sky then sky:Destroy() end\n\tprint(\"[LIGHTING] Dusk set — ClockTime 18.5\")\nend\n\n-- Run immediately and again after 2s to beat MetropolisLighting\nsetDusk()\ntask.delay(2, setDusk)\n"}},"contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
{"timestamp":"2026-05-07T07:42:09.848Z","type":"write","direction":"forward","source":"studio","path":"game.Workspace.Camera","details":"props","diff":{"type":"props","changedProperties":{"Focus":{"before":[-27.524017333984375,-3.0144882202148438,-51.60975646972656,1,0,0,0,1,0,0,0,1],"after":[-53.280517578125,29.361583709716797,-69.31888580322266,1,0,0,0,1,0,0,0,1]},"CFrame":{"before":[-27.36058235168457,-0.18416762351989746,-54.20726776123047,-0.9980264902114868,-0.04622342437505722,0.0425051786005497,0,0.676880955696106,0.7360926270484924,-0.06279566138982773,0.7346399426460266,-0.6755449771881104],"after":[-53.11708068847656,32.1919059753418,-71.91639709472656,-0.9980263710021973,-0.046223968267440796,0.0425056591629982,1.8626449271863521e-9,0.6768806576728821,0.7360928058624268,-0.06279638409614563,0.7346400022506714,-0.6755447387695312]}}},"contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
{"timestamp":"2026-05-07T07:45:15.958Z","type":"write","direction":"forward","source":"studio","path":"game.ServerScriptService.SetDuskLighting","details":"script:Script","diff":{"type":"script","scriptMeta":{"beforeLines":19,"afterLines":21},"scriptDiff":{"beforeSource":"-- Temporary dusk lighting for hawk visibility testing\n-- Runs after a delay to override MetropolisLighting (ClockTime=0)\nlocal Lighting = game:GetService(\"Lighting\")\n\nlocal function setDusk()\n\tLighting.ClockTime      = 18.5\n\tLighting.Brightness     = 3\n\tLighting.Ambient        = Color3.fromRGB(80, 60, 90)\n\tLighting.OutdoorAmbient = Color3.fromRGB(140, 100, 70)\n\t-- Remove midnight skybox so default dusk sky shows\n\tlocal sky = Lighting:FindFirstChildOfClass(\"Sky\")\n\tif sky then sky:Destroy() end\n\tprint(\"[LIGHTING] Dusk set — ClockTime 18.5\")\nend\n\n-- Run immediately and again after 2s to beat MetropolisLighting\nsetDusk()\ntask.delay(2, setDusk)\n","afterSource":"-- Temporary dusk lighting for hawk visibility testing\n-- Runs after a delay to override MetropolisLighting (ClockTime=0)\nlocal Lighting = game:GetService(\"Lighting\")\n\nlocal function setDusk()\n\tLighting.ClockTime      = 18.5\n\tLighting.Brightness     = 3\n\tLighting.Ambient        = Color3.fromRGB(80, 60, 90)\n\tLighting.OutdoorAmbient = Color3.fromRGB(140, 100, 70)\n\tLighting.FogEnd         = 100000  -- push fog out to eliminate horizon band\n\tLighting.FogStart       = 90000\n\t-- Remove midnight skybox so default dusk sky shows\n\tlocal sky = Lighting:FindFirstChildOfClass(\"Sky\")\n\tif sky then sky:Destroy() end\n\tprint(\"[LIGHTING] Dusk set — ClockTime 18.5\")\nend\n\n-- Run immediately and again after 2s to beat MetropolisLighting\nsetDusk()\ntask.delay(2, setDusk)\n"}},"contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
{"timestamp":"2026-05-07T07:45:56.240Z","type":"write","direction":"forward","source":"studio","path":"game.Workspace.Camera","details":"props","diff":{"type":"props","changedProperties":{"Focus":{"before":[-53.280517578125,29.361583709716797,-69.31888580322266,1,0,0,0,1,0,0,0,1],"after":[-50.01322555541992,21.34752655029297,-57.06736755371094,1,0,0,0,1,0,0,0,1]},"CFrame":{"before":[-53.11708068847656,32.1919059753418,-71.91639709472656,-0.9980263710021973,-0.046223968267440796,0.0425056591629982,1.8626449271863521e-9,0.6768806576728821,0.7360928058624268,-0.06279638409614563,0.7346400022506714,-0.6755447387695312],"after":[-49.849788665771484,24.17784881591797,-59.664878845214844,-0.9980263710021973,-0.046223968267440796,0.0425056591629982,1.8626449271863521e-9,0.6768806576728821,0.7360928058624268,-0.06279638409614563,0.7346400022506714,-0.6755447387695312]}}},"contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
{"timestamp":"2026-05-07T07:51:58.891Z","type":"write","direction":"forward","source":"studio","path":"game.ServerScriptService.InventoryService","details":"props","contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
{"timestamp":"2026-05-07T07:51:58.892Z","type":"write","direction":"forward","source":"studio","path":"game.ServerScriptService.InventoryService","details":"script:Script","diff":{"type":"script","scriptMeta":{"beforeLines":null,"afterLines":292},"scriptDiff":{"beforeSource":null,"afterSource":"-- =============================================================================\n-- InventoryService\n-- 3-slot inventory system. Power-ups spawn at randomized map points and\n-- respawn after use. Players pick up by touching. Server-authoritative.\n--\n-- Power-ups: JETPACK | CLOAK | SPITBALL | HEAL\n-- Healing is player-to-player only — no healing pickups exist.\n-- =============================================================================\n\nlocal Players         = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService      = game:GetService(\"RunService\")\n\n-- ── Config ────────────────────────────────────────────────────────────────────\n\nlocal POWERUP_TYPES = { \"JETPACK\", \"CLOAK\", \"SPITBALL\" }\n\nlocal POWERUP_CFG = {\n\tJETPACK  = { color = BrickColor.new(\"Bright orange\"),  duration = 20,  respawnDelay = 15 },\n\tCLOAK    = { color = BrickColor.new(\"Electric blue\"),  duration = 10,  respawnDelay = 20 },\n\tSPITBALL = { color = BrickColor.new(\"Bright green\"),   duration = 0,   respawnDelay = 10 }, -- duration=0 = uses charges\n}\n\nlocal INVENTORY_SIZE = 3\n\n-- Spawn zone: randomized points within the arena bounds\n-- Centered around (1012, 58, 1007) — lobby/arena center\nlocal ARENA_CENTER = Vector3.new(1012, 62, 1007)\nlocal ARENA_RADIUS = 40  -- studs from center, keeps pickups on the floor\n\n-- ── RemoteEvents setup ────────────────────────────────────────────────────────\n\nlocal function ensureFolder(parent, name)\n\tlocal f = parent:FindFirstChild(name)\n\tif not f then\n\t\tf = Instance.new(\"Folder\")\n\t\tf.Name = name\n\t\tf.Parent = parent\n\tend\n\treturn f\nend\n\nlocal omcFolder   = ensureFolder(ReplicatedStorage, \"OMC\")\nlocal eventsFolder = ensureFolder(omcFolder, \"Events\")\n\nlocal function getOrCreateRemote(name, class)\n\tlocal existing = eventsFolder:FindFirstChild(name)\n\tif existing then return existing end\n\tlocal r = Instance.new(class)\n\tr.Name   = name\n\tr.Parent = eventsFolder\n\treturn r\nend\n\nlocal InventoryUpdate  = getOrCreateRemote(\"InventoryUpdate\",  \"RemoteEvent\")  -- server→client\nlocal UseItem          = getOrCreateRemote(\"UseItem\",          \"RemoteEvent\")  -- client→server\nlocal HealRequest      = getOrCreateRemote(\"HealRequest\",      \"RemoteEvent\")  -- client→server\nlocal HealEffect       = getOrCreateRemote(\"HealEffect\",       \"RemoteEvent\")  -- server→client\n\n-- ── Player inventory state ────────────────────────────────────────────────────\n\n-- inventory[player] = { [1]=item|nil, [2]=item|nil, [3]=item|nil }\nlocal inventory = {}\n\nlocal function getInventory(player)\n\tif not inventory[player] then\n\t\tinventory[player] = { nil, nil, nil }\n\tend\n\treturn inventory[player]\nend\n\nlocal function firstEmptySlot(player)\n\tlocal inv = getInventory(player)\n\tfor i = 1, INVENTORY_SIZE do\n\t\tif not inv[i] then return i end\n\tend\n\treturn nil\nend\n\nlocal function addItem(player, itemType)\n\tlocal slot = firstEmptySlot(player)\n\tif not slot then return false end\n\tgetInventory(player)[slot] = itemType\n\tInventoryUpdate:FireClient(player, getInventory(player))\n\treturn true\nend\n\nlocal function removeItem(player, slot)\n\tgetInventory(player)[slot] = nil\n\tInventoryUpdate:FireClient(player, getInventory(player))\nend\n\n-- ── Pickup spawning ───────────────────────────────────────────────────────────\n\nlocal pickupFolder = ensureFolder(workspace, \"PowerupPickups\")\n\nlocal function randomArenaPoint()\n\tlocal angle  = math.random() * math.pi * 2\n\tlocal radius = math.random() * ARENA_RADIUS\n\treturn Vector3.new(\n\t\tARENA_CENTER.X + math.cos(angle) * radius,\n\t\tARENA_CENTER.Y,\n\t\tARENA_CENTER.Z + math.sin(angle) * radius\n\t)\nend\n\nlocal function spawnPickup(itemType)\n\tlocal cfg = POWERUP_CFG[itemType]\n\n\tlocal part = Instance.new(\"Part\")\n\tpart.Name        = \"Pickup_\" .. itemType\n\tpart.Size        = Vector3.new(2, 2, 2)\n\tpart.Shape       = Enum.PartType.Ball\n\tpart.BrickColor  = cfg.color\n\tpart.Material    = Enum.Material.Neon\n\tpart.Anchored    = true\n\tpart.CanCollide  = false\n\tpart.CFrame      = CFrame.new(randomArenaPoint())\n\tpart.Parent      = pickupFolder\n\n\t-- Spin effect\n\tlocal spin = Instance.new(\"BodyAngularVelocity\")\n\tspin.AngularVelocity = Vector3.new(0, 2, 0)\n\tspin.MaxTorque       = Vector3.new(0, 1e4, 0)\n\tspin.Parent          = part\n\n\t-- Label\n\tlocal billboard = Instance.new(\"BillboardGui\")\n\tbillboard.Size        = UDim2.new(0, 80, 0, 30)\n\tbillboard.StudsOffset = Vector3.new(0, 2, 0)\n\tbillboard.AlwaysOnTop = false\n\tbillboard.Parent      = part\n\tlocal label = Instance.new(\"TextLabel\", billboard)\n\tlabel.Size            = UDim2.new(1, 0, 1, 0)\n\tlabel.BackgroundTransparency = 1\n\tlabel.Text            = itemType\n\tlabel.TextColor3      = Color3.new(1, 1, 1)\n\tlabel.TextScaled      = true\n\tlabel.Font            = Enum.Font.GothamBold\n\n\t-- Touch to collect\n\tpart.Touched:Connect(function(hit)\n\t\tlocal char = hit.Parent\n\t\tif not char then return end\n\t\tlocal player = Players:GetPlayerFromCharacter(char)\n\t\tif not player then return end\n\t\tif not part.Parent then return end  -- already collected\n\n\t\tlocal added = addItem(player, itemType)\n\t\tif added then\n\t\t\tpart:Destroy()\n\t\t\tprint(string.format(\"[INVENTORY] %s picked up %s\", player.Name, itemType))\n\t\t\t-- Respawn after delay\n\t\t\ttask.delay(cfg.respawnDelay, function()\n\t\t\t\tspawnPickup(itemType)\n\t\t\tend)\n\t\tend\n\tend)\n\n\treturn part\nend\n\n-- ── Initial spawn — one of each type at random points ────────────────────────\n\ntask.wait(2)  -- let world finish loading\n\nfor _, itemType in ipairs(POWERUP_TYPES) do\n\tspawnPickup(itemType)\nend\n\nprint(\"[INVENTORY] Power-up spawner active —\", #POWERUP_TYPES, \"pickups in world\")\n\n-- ── Use item handler ──────────────────────────────────────────────────────────\n\nUseItem.OnServerEvent:Connect(function(player, slot)\n\tlocal inv = getInventory(player)\n\tlocal item = inv[slot]\n\tif not item then return end\n\n\tlocal char = player.Character\n\tlocal hrp  = char and char:FindFirstChild(\"HumanoidRootPart\")\n\tlocal hum  = char and char:FindFirstChildOfClass(\"Humanoid\")\n\tif not (char and hrp and hum) then return end\n\n\tlocal cfg = POWERUP_CFG[item]\n\n\tprint(string.format(\"[INVENTORY] %s used %s (slot %d)\", player.Name, item, slot))\n\tremoveItem(player, slot)\n\n\tif item == \"JETPACK\" then\n\t\t-- Jetpack: apply upward BodyVelocity burst\n\t\t-- Teammate throw logic handled client-side via JetpackThrow RemoteEvent\n\t\tlocal bv = Instance.new(\"BodyVelocity\")\n\t\tbv.Velocity  = Vector3.new(0, 80, 0)\n\t\tbv.MaxForce  = Vector3.new(0, 1e5, 0)\n\t\tbv.Parent    = hrp\n\t\tgame:GetService(\"Debris\"):AddItem(bv, 0.4)\n\n\t\t-- Duration: keep jetpack active\n\t\tlocal active = true\n\t\ttask.delay(cfg.duration, function() active = false end)\n\n\t\t-- Hover assist while active\n\t\ttask.spawn(function()\n\t\t\tlocal startT = tick()\n\t\t\twhile active and tick() - startT < cfg.duration do\n\t\t\t\tif hrp and hrp.Parent then\n\t\t\t\t\tlocal vel = hrp.AssemblyLinearVelocity\n\t\t\t\t\tif vel.Y < -10 then\n\t\t\t\t\t\tlocal assist = Instance.new(\"BodyVelocity\")\n\t\t\t\t\t\tassist.Velocity = Vector3.new(vel.X, -5, vel.Z)\n\t\t\t\t\t\tassist.MaxForce = Vector3.new(0, 1e4, 0)\n\t\t\t\t\t\tassist.Parent   = hrp\n\t\t\t\t\t\tgame:GetService(\"Debris\"):AddItem(assist, 0.1)\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\t\ttask.wait(0.1)\n\t\t\tend\n\t\tend)\n\n\telseif item == \"CLOAK\" then\n\t\t-- Cloak: invisibility + invincibility\n\t\tfor _, part in ipairs(char:GetDescendants()) do\n\t\t\tif part:IsA(\"BasePart\") and part.Name ~= \"HumanoidRootPart\" then\n\t\t\t\tpart.Transparency = 0.85\n\t\t\tend\n\t\tend\n\t\thum:SetAttribute(\"OMC_Cloaked\", true)\n\n\t\ttask.delay(cfg.duration, function()\n\t\t\tif not char.Parent then return end\n\t\t\tfor _, part in ipairs(char:GetDescendants()) do\n\t\t\t\tif part:IsA(\"BasePart\") and part.Name ~= \"HumanoidRootPart\" then\n\t\t\t\t\tpart.Transparency = 0\n\t\t\t\tend\n\t\t\tend\n\t\t\thum:SetAttribute(\"OMC_Cloaked\", false)\n\t\t\tprint(string.format(\"[INVENTORY] %s cloak expired\", player.Name))\n\t\tend)\n\n\telseif item == \"SPITBALL\" then\n\t\t-- Spitball: grant 3 charges, handled via SpitballFire RemoteEvent\n\t\tlocal current = hum:GetAttribute(\"OMC_SpitballCharges\") or 0\n\t\thum:SetAttribute(\"OMC_SpitballCharges\", current + 3)\n\t\tprint(string.format(\"[INVENTORY] %s has %d spitball charges\", player.Name, current + 3))\n\tend\nend)\n\n-- ── Heal handler — player-to-player only ──────────────────────────────────────\n\nHealRequest.OnServerEvent:Connect(function(healer, targetPlayer)\n\tif healer == targetPlayer then return end\n\n\tlocal healerChar = healer.Character\n\tlocal healerHRP  = healerChar and healerChar:FindFirstChild(\"HumanoidRootPart\")\n\tlocal targetChar = targetPlayer and targetPlayer.Character\n\tlocal targetHRP  = targetChar and targetChar:FindFirstChild(\"HumanoidRootPart\")\n\tlocal targetHum  = targetChar and targetChar:FindFirstChildOfClass(\"Humanoid\")\n\n\tif not (healerHRP and targetHRP and targetHum) then return end\n\n\t-- Must be within 10 studs to heal\n\tlocal dist = (healerHRP.Position - targetHRP.Position).Magnitude\n\tif dist > 10 then\n\t\tprint(string.format(\"[INVENTORY] %s too far to heal %s (%.1f studs)\", healer.Name, targetPlayer.Name, dist))\n\t\treturn\n\tend\n\n\t-- Only heal if target is in danger zone (below 30% health)\n\tlocal pct = targetHum.Health / targetHum.MaxHealth\n\tif pct > 0.3 then\n\t\tprint(string.format(\"[INVENTORY] %s health not critical (%.0f%%)\", targetPlayer.Name, pct * 100))\n\t\treturn\n\tend\n\n\tlocal healAmount = targetHum.MaxHealth * 0.4  -- heal to ~70%\n\ttargetHum.Health = math.min(targetHum.MaxHealth, targetHum.Health + healAmount)\n\n\tHealEffect:FireClient(healer,    \"healer\", targetPlayer.Name)\n\tHealEffect:FireClient(targetPlayer, \"receiver\", healer.Name)\n\n\tprint(string.format(\"[INVENTORY] %s healed %s (+%.0f HP)\", healer.Name, targetPlayer.Name, healAmount))\nend)\n\n-- ── Cleanup on player leave ───────────────────────────────────────────────────\n\nPlayers.PlayerRemoving:Connect(function(player)\n\tinventory[player] = nil\nend)\n\nprint(\"[INVENTORY] Service initialized — 3-slot inventory, player-to-player healing only\")\n"}},"contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
{"timestamp":"2026-05-07T07:52:02.398Z","type":"write","direction":"forward","source":"studio","path":"game.ServerScriptService.InventoryService~2","details":"props","contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
{"timestamp":"2026-05-07T07:52:02.399Z","type":"write","direction":"forward","source":"studio","path":"game.ServerScriptService.InventoryService~2","details":"script:Script","diff":{"type":"script","scriptMeta":{"beforeLines":null,"afterLines":292},"scriptDiff":{"beforeSource":null,"afterSource":"-- =============================================================================\n-- InventoryService\n-- 3-slot inventory system. Power-ups spawn at randomized map points and\n-- respawn after use. Players pick up by touching. Server-authoritative.\n--\n-- Power-ups: JETPACK | CLOAK | SPITBALL | HEAL\n-- Healing is player-to-player only — no healing pickups exist.\n-- =============================================================================\n\nlocal Players         = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService      = game:GetService(\"RunService\")\n\n-- ── Config ────────────────────────────────────────────────────────────────────\n\nlocal POWERUP_TYPES = { \"JETPACK\", \"CLOAK\", \"SPITBALL\" }\n\nlocal POWERUP_CFG = {\n\tJETPACK  = { color = BrickColor.new(\"Bright orange\"),  duration = 20,  respawnDelay = 15 },\n\tCLOAK    = { color = BrickColor.new(\"Electric blue\"),  duration = 10,  respawnDelay = 20 },\n\tSPITBALL = { color = BrickColor.new(\"Bright green\"),   duration = 0,   respawnDelay = 10 }, -- duration=0 = uses charges\n}\n\nlocal INVENTORY_SIZE = 3\n\n-- Spawn zone: randomized points within the arena bounds\n-- Centered around (1012, 58, 1007) — lobby/arena center\nlocal ARENA_CENTER = Vector3.new(1012, 62, 1007)\nlocal ARENA_RADIUS = 40  -- studs from center, keeps pickups on the floor\n\n-- ── RemoteEvents setup ────────────────────────────────────────────────────────\n\nlocal function ensureFolder(parent, name)\n\tlocal f = parent:FindFirstChild(name)\n\tif not f then\n\t\tf = Instance.new(\"Folder\")\n\t\tf.Name = name\n\t\tf.Parent = parent\n\tend\n\treturn f\nend\n\nlocal omcFolder   = ensureFolder(ReplicatedStorage, \"OMC\")\nlocal eventsFolder = ensureFolder(omcFolder, \"Events\")\n\nlocal function getOrCreateRemote(name, class)\n\tlocal existing = eventsFolder:FindFirstChild(name)\n\tif existing then return existing end\n\tlocal r = Instance.new(class)\n\tr.Name   = name\n\tr.Parent = eventsFolder\n\treturn r\nend\n\nlocal InventoryUpdate  = getOrCreateRemote(\"InventoryUpdate\",  \"RemoteEvent\")  -- server→client\nlocal UseItem          = getOrCreateRemote(\"UseItem\",          \"RemoteEvent\")  -- client→server\nlocal HealRequest      = getOrCreateRemote(\"HealRequest\",      \"RemoteEvent\")  -- client→server\nlocal HealEffect       = getOrCreateRemote(\"HealEffect\",       \"RemoteEvent\")  -- server→client\n\n-- ── Player inventory state ────────────────────────────────────────────────────\n\n-- inventory[player] = { [1]=item|nil, [2]=item|nil, [3]=item|nil }\nlocal inventory = {}\n\nlocal function getInventory(player)\n\tif not inventory[player] then\n\t\tinventory[player] = { nil, nil, nil }\n\tend\n\treturn inventory[player]\nend\n\nlocal function firstEmptySlot(player)\n\tlocal inv = getInventory(player)\n\tfor i = 1, INVENTORY_SIZE do\n\t\tif not inv[i] then return i end\n\tend\n\treturn nil\nend\n\nlocal function addItem(player, itemType)\n\tlocal slot = firstEmptySlot(player)\n\tif not slot then return false end\n\tgetInventory(player)[slot] = itemType\n\tInventoryUpdate:FireClient(player, getInventory(player))\n\treturn true\nend\n\nlocal function removeItem(player, slot)\n\tgetInventory(player)[slot] = nil\n\tInventoryUpdate:FireClient(player, getInventory(player))\nend\n\n-- ── Pickup spawning ───────────────────────────────────────────────────────────\n\nlocal pickupFolder = ensureFolder(workspace, \"PowerupPickups\")\n\nlocal function randomArenaPoint()\n\tlocal angle  = math.random() * math.pi * 2\n\tlocal radius = math.random() * ARENA_RADIUS\n\treturn Vector3.new(\n\t\tARENA_CENTER.X + math.cos(angle) * radius,\n\t\tARENA_CENTER.Y,\n\t\tARENA_CENTER.Z + math.sin(angle) * radius\n\t)\nend\n\nlocal function spawnPickup(itemType)\n\tlocal cfg = POWERUP_CFG[itemType]\n\n\tlocal part = Instance.new(\"Part\")\n\tpart.Name        = \"Pickup_\" .. itemType\n\tpart.Size        = Vector3.new(2, 2, 2)\n\tpart.Shape       = Enum.PartType.Ball\n\tpart.BrickColor  = cfg.color\n\tpart.Material    = Enum.Material.Neon\n\tpart.Anchored    = true\n\tpart.CanCollide  = false\n\tpart.CFrame      = CFrame.new(randomArenaPoint())\n\tpart.Parent      = pickupFolder\n\n\t-- Spin effect\n\tlocal spin = Instance.new(\"BodyAngularVelocity\")\n\tspin.AngularVelocity = Vector3.new(0, 2, 0)\n\tspin.MaxTorque       = Vector3.new(0, 1e4, 0)\n\tspin.Parent          = part\n\n\t-- Label\n\tlocal billboard = Instance.new(\"BillboardGui\")\n\tbillboard.Size        = UDim2.new(0, 80, 0, 30)\n\tbillboard.StudsOffset = Vector3.new(0, 2, 0)\n\tbillboard.AlwaysOnTop = false\n\tbillboard.Parent      = part\n\tlocal label = Instance.new(\"TextLabel\", billboard)\n\tlabel.Size            = UDim2.new(1, 0, 1, 0)\n\tlabel.BackgroundTransparency = 1\n\tlabel.Text            = itemType\n\tlabel.TextColor3      = Color3.new(1, 1, 1)\n\tlabel.TextScaled      = true\n\tlabel.Font            = Enum.Font.GothamBold\n\n\t-- Touch to collect\n\tpart.Touched:Connect(function(hit)\n\t\tlocal char = hit.Parent\n\t\tif not char then return end\n\t\tlocal player = Players:GetPlayerFromCharacter(char)\n\t\tif not player then return end\n\t\tif not part.Parent then return end  -- already collected\n\n\t\tlocal added = addItem(player, itemType)\n\t\tif added then\n\t\t\tpart:Destroy()\n\t\t\tprint(string.format(\"[INVENTORY] %s picked up %s\", player.Name, itemType))\n\t\t\t-- Respawn after delay\n\t\t\ttask.delay(cfg.respawnDelay, function()\n\t\t\t\tspawnPickup(itemType)\n\t\t\tend)\n\t\tend\n\tend)\n\n\treturn part\nend\n\n-- ── Initial spawn — one of each type at random points ────────────────────────\n\ntask.wait(2)  -- let world finish loading\n\nfor _, itemType in ipairs(POWERUP_TYPES) do\n\tspawnPickup(itemType)\nend\n\nprint(\"[INVENTORY] Power-up spawner active —\", #POWERUP_TYPES, \"pickups in world\")\n\n-- ── Use item handler ──────────────────────────────────────────────────────────\n\nUseItem.OnServerEvent:Connect(function(player, slot)\n\tlocal inv = getInventory(player)\n\tlocal item = inv[slot]\n\tif not item then return end\n\n\tlocal char = player.Character\n\tlocal hrp  = char and char:FindFirstChild(\"HumanoidRootPart\")\n\tlocal hum  = char and char:FindFirstChildOfClass(\"Humanoid\")\n\tif not (char and hrp and hum) then return end\n\n\tlocal cfg = POWERUP_CFG[item]\n\n\tprint(string.format(\"[INVENTORY] %s used %s (slot %d)\", player.Name, item, slot))\n\tremoveItem(player, slot)\n\n\tif item == \"JETPACK\" then\n\t\t-- Jetpack: apply upward BodyVelocity burst\n\t\t-- Teammate throw logic handled client-side via JetpackThrow RemoteEvent\n\t\tlocal bv = Instance.new(\"BodyVelocity\")\n\t\tbv.Velocity  = Vector3.new(0, 80, 0)\n\t\tbv.MaxForce  = Vector3.new(0, 1e5, 0)\n\t\tbv.Parent    = hrp\n\t\tgame:GetService(\"Debris\"):AddItem(bv, 0.4)\n\n\t\t-- Duration: keep jetpack active\n\t\tlocal active = true\n\t\ttask.delay(cfg.duration, function() active = false end)\n\n\t\t-- Hover assist while active\n\t\ttask.spawn(function()\n\t\t\tlocal startT = tick()\n\t\t\twhile active and tick() - startT < cfg.duration do\n\t\t\t\tif hrp and hrp.Parent then\n\t\t\t\t\tlocal vel = hrp.AssemblyLinearVelocity\n\t\t\t\t\tif vel.Y < -10 then\n\t\t\t\t\t\tlocal assist = Instance.new(\"BodyVelocity\")\n\t\t\t\t\t\tassist.Velocity = Vector3.new(vel.X, -5, vel.Z)\n\t\t\t\t\t\tassist.MaxForce = Vector3.new(0, 1e4, 0)\n\t\t\t\t\t\tassist.Parent   = hrp\n\t\t\t\t\t\tgame:GetService(\"Debris\"):AddItem(assist, 0.1)\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\t\ttask.wait(0.1)\n\t\t\tend\n\t\tend)\n\n\telseif item == \"CLOAK\" then\n\t\t-- Cloak: invisibility + invincibility\n\t\tfor _, part in ipairs(char:GetDescendants()) do\n\t\t\tif part:IsA(\"BasePart\") and part.Name ~= \"HumanoidRootPart\" then\n\t\t\t\tpart.Transparency = 0.85\n\t\t\tend\n\t\tend\n\t\thum:SetAttribute(\"OMC_Cloaked\", true)\n\n\t\ttask.delay(cfg.duration, function()\n\t\t\tif not char.Parent then return end\n\t\t\tfor _, part in ipairs(char:GetDescendants()) do\n\t\t\t\tif part:IsA(\"BasePart\") and part.Name ~= \"HumanoidRootPart\" then\n\t\t\t\t\tpart.Transparency = 0\n\t\t\t\tend\n\t\t\tend\n\t\t\thum:SetAttribute(\"OMC_Cloaked\", false)\n\t\t\tprint(string.format(\"[INVENTORY] %s cloak expired\", player.Name))\n\t\tend)\n\n\telseif item == \"SPITBALL\" then\n\t\t-- Spitball: grant 3 charges, handled via SpitballFire RemoteEvent\n\t\tlocal current = hum:GetAttribute(\"OMC_SpitballCharges\") or 0\n\t\thum:SetAttribute(\"OMC_SpitballCharges\", current + 3)\n\t\tprint(string.format(\"[INVENTORY] %s has %d spitball charges\", player.Name, current + 3))\n\tend\nend)\n\n-- ── Heal handler — player-to-player only ──────────────────────────────────────\n\nHealRequest.OnServerEvent:Connect(function(healer, targetPlayer)\n\tif healer == targetPlayer then return end\n\n\tlocal healerChar = healer.Character\n\tlocal healerHRP  = healerChar and healerChar:FindFirstChild(\"HumanoidRootPart\")\n\tlocal targetChar = targetPlayer and targetPlayer.Character\n\tlocal targetHRP  = targetChar and targetChar:FindFirstChild(\"HumanoidRootPart\")\n\tlocal targetHum  = targetChar and targetChar:FindFirstChildOfClass(\"Humanoid\")\n\n\tif not (healerHRP and targetHRP and targetHum) then return end\n\n\t-- Must be within 10 studs to heal\n\tlocal dist = (healerHRP.Position - targetHRP.Position).Magnitude\n\tif dist > 10 then\n\t\tprint(string.format(\"[INVENTORY] %s too far to heal %s (%.1f studs)\", healer.Name, targetPlayer.Name, dist))\n\t\treturn\n\tend\n\n\t-- Only heal if target is in danger zone (below 30% health)\n\tlocal pct = targetHum.Health / targetHum.MaxHealth\n\tif pct > 0.3 then\n\t\tprint(string.format(\"[INVENTORY] %s health not critical (%.0f%%)\", targetPlayer.Name, pct * 100))\n\t\treturn\n\tend\n\n\tlocal healAmount = targetHum.MaxHealth * 0.4  -- heal to ~70%\n\ttargetHum.Health = math.min(targetHum.MaxHealth, targetHum.Health + healAmount)\n\n\tHealEffect:FireClient(healer,    \"healer\", targetPlayer.Name)\n\tHealEffect:FireClient(targetPlayer, \"receiver\", healer.Name)\n\n\tprint(string.format(\"[INVENTORY] %s healed %s (+%.0f HP)\", healer.Name, targetPlayer.Name, healAmount))\nend)\n\n-- ── Cleanup on player leave ───────────────────────────────────────────────────\n\nPlayers.PlayerRemoving:Connect(function(player)\n\tinventory[player] = nil\nend)\n\nprint(\"[INVENTORY] Service initialized — 3-slot inventory, player-to-player healing only\")\n"}},"contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
{"timestamp":"2026-05-07T07:52:05.409Z","type":"write","direction":"forward","source":"studio","path":"game.ServerScriptService.InventoryService~3","details":"props","contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
{"timestamp":"2026-05-07T07:52:05.410Z","type":"write","direction":"forward","source":"studio","path":"game.ServerScriptService.InventoryService~3","details":"script:Script","diff":{"type":"script","scriptMeta":{"beforeLines":null,"afterLines":292},"scriptDiff":{"beforeSource":null,"afterSource":"-- =============================================================================\n-- InventoryService\n-- 3-slot inventory system. Power-ups spawn at randomized map points and\n-- respawn after use. Players pick up by touching. Server-authoritative.\n--\n-- Power-ups: JETPACK | CLOAK | SPITBALL | HEAL\n-- Healing is player-to-player only — no healing pickups exist.\n-- =============================================================================\n\nlocal Players         = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService      = game:GetService(\"RunService\")\n\n-- ── Config ────────────────────────────────────────────────────────────────────\n\nlocal POWERUP_TYPES = { \"JETPACK\", \"CLOAK\", \"SPITBALL\" }\n\nlocal POWERUP_CFG = {\n\tJETPACK  = { color = BrickColor.new(\"Bright orange\"),  duration = 20,  respawnDelay = 15 },\n\tCLOAK    = { color = BrickColor.new(\"Electric blue\"),  duration = 10,  respawnDelay = 20 },\n\tSPITBALL = { color = BrickColor.new(\"Bright green\"),   duration = 0,   respawnDelay = 10 }, -- duration=0 = uses charges\n}\n\nlocal INVENTORY_SIZE = 3\n\n-- Spawn zone: randomized points within the arena bounds\n-- Centered around (1012, 58, 1007) — lobby/arena center\nlocal ARENA_CENTER = Vector3.new(1012, 62, 1007)\nlocal ARENA_RADIUS = 40  -- studs from center, keeps pickups on the floor\n\n-- ── RemoteEvents setup ────────────────────────────────────────────────────────\n\nlocal function ensureFolder(parent, name)\n\tlocal f = parent:FindFirstChild(name)\n\tif not f then\n\t\tf = Instance.new(\"Folder\")\n\t\tf.Name = name\n\t\tf.Parent = parent\n\tend\n\treturn f\nend\n\nlocal omcFolder   = ensureFolder(ReplicatedStorage, \"OMC\")\nlocal eventsFolder = ensureFolder(omcFolder, \"Events\")\n\nlocal function getOrCreateRemote(name, class)\n\tlocal existing = eventsFolder:FindFirstChild(name)\n\tif existing then return existing end\n\tlocal r = Instance.new(class)\n\tr.Name   = name\n\tr.Parent = eventsFolder\n\treturn r\nend\n\nlocal InventoryUpdate  = getOrCreateRemote(\"InventoryUpdate\",  \"RemoteEvent\")  -- server→client\nlocal UseItem          = getOrCreateRemote(\"UseItem\",          \"RemoteEvent\")  -- client→server\nlocal HealRequest      = getOrCreateRemote(\"HealRequest\",      \"RemoteEvent\")  -- client→server\nlocal HealEffect       = getOrCreateRemote(\"HealEffect\",       \"RemoteEvent\")  -- server→client\n\n-- ── Player inventory state ────────────────────────────────────────────────────\n\n-- inventory[player] = { [1]=item|nil, [2]=item|nil, [3]=item|nil }\nlocal inventory = {}\n\nlocal function getInventory(player)\n\tif not inventory[player] then\n\t\tinventory[player] = { nil, nil, nil }\n\tend\n\treturn inventory[player]\nend\n\nlocal function firstEmptySlot(player)\n\tlocal inv = getInventory(player)\n\tfor i = 1, INVENTORY_SIZE do\n\t\tif not inv[i] then return i end\n\tend\n\treturn nil\nend\n\nlocal function addItem(player, itemType)\n\tlocal slot = firstEmptySlot(player)\n\tif not slot then return false end\n\tgetInventory(player)[slot] = itemType\n\tInventoryUpdate:FireClient(player, getInventory(player))\n\treturn true\nend\n\nlocal function removeItem(player, slot)\n\tgetInventory(player)[slot] = nil\n\tInventoryUpdate:FireClient(player, getInventory(player))\nend\n\n-- ── Pickup spawning ───────────────────────────────────────────────────────────\n\nlocal pickupFolder = ensureFolder(workspace, \"PowerupPickups\")\n\nlocal function randomArenaPoint()\n\tlocal angle  = math.random() * math.pi * 2\n\tlocal radius = math.random() * ARENA_RADIUS\n\treturn Vector3.new(\n\t\tARENA_CENTER.X + math.cos(angle) * radius,\n\t\tARENA_CENTER.Y,\n\t\tARENA_CENTER.Z + math.sin(angle) * radius\n\t)\nend\n\nlocal function spawnPickup(itemType)\n\tlocal cfg = POWERUP_CFG[itemType]\n\n\tlocal part = Instance.new(\"Part\")\n\tpart.Name        = \"Pickup_\" .. itemType\n\tpart.Size        = Vector3.new(2, 2, 2)\n\tpart.Shape       = Enum.PartType.Ball\n\tpart.BrickColor  = cfg.color\n\tpart.Material    = Enum.Material.Neon\n\tpart.Anchored    = true\n\tpart.CanCollide  = false\n\tpart.CFrame      = CFrame.new(randomArenaPoint())\n\tpart.Parent      = pickupFolder\n\n\t-- Spin effect\n\tlocal spin = Instance.new(\"BodyAngularVelocity\")\n\tspin.AngularVelocity = Vector3.new(0, 2, 0)\n\tspin.MaxTorque       = Vector3.new(0, 1e4, 0)\n\tspin.Parent          = part\n\n\t-- Label\n\tlocal billboard = Instance.new(\"BillboardGui\")\n\tbillboard.Size        = UDim2.new(0, 80, 0, 30)\n\tbillboard.StudsOffset = Vector3.new(0, 2, 0)\n\tbillboard.AlwaysOnTop = false\n\tbillboard.Parent      = part\n\tlocal label = Instance.new(\"TextLabel\", billboard)\n\tlabel.Size            = UDim2.new(1, 0, 1, 0)\n\tlabel.BackgroundTransparency = 1\n\tlabel.Text            = itemType\n\tlabel.TextColor3      = Color3.new(1, 1, 1)\n\tlabel.TextScaled      = true\n\tlabel.Font            = Enum.Font.GothamBold\n\n\t-- Touch to collect\n\tpart.Touched:Connect(function(hit)\n\t\tlocal char = hit.Parent\n\t\tif not char then return end\n\t\tlocal player = Players:GetPlayerFromCharacter(char)\n\t\tif not player then return end\n\t\tif not part.Parent then return end  -- already collected\n\n\t\tlocal added = addItem(player, itemType)\n\t\tif added then\n\t\t\tpart:Destroy()\n\t\t\tprint(string.format(\"[INVENTORY] %s picked up %s\", player.Name, itemType))\n\t\t\t-- Respawn after delay\n\t\t\ttask.delay(cfg.respawnDelay, function()\n\t\t\t\tspawnPickup(itemType)\n\t\t\tend)\n\t\tend\n\tend)\n\n\treturn part\nend\n\n-- ── Initial spawn — one of each type at random points ────────────────────────\n\ntask.wait(2)  -- let world finish loading\n\nfor _, itemType in ipairs(POWERUP_TYPES) do\n\tspawnPickup(itemType)\nend\n\nprint(\"[INVENTORY] Power-up spawner active —\", #POWERUP_TYPES, \"pickups in world\")\n\n-- ── Use item handler ──────────────────────────────────────────────────────────\n\nUseItem.OnServerEvent:Connect(function(player, slot)\n\tlocal inv = getInventory(player)\n\tlocal item = inv[slot]\n\tif not item then return end\n\n\tlocal char = player.Character\n\tlocal hrp  = char and char:FindFirstChild(\"HumanoidRootPart\")\n\tlocal hum  = char and char:FindFirstChildOfClass(\"Humanoid\")\n\tif not (char and hrp and hum) then return end\n\n\tlocal cfg = POWERUP_CFG[item]\n\n\tprint(string.format(\"[INVENTORY] %s used %s (slot %d)\", player.Name, item, slot))\n\tremoveItem(player, slot)\n\n\tif item == \"JETPACK\" then\n\t\t-- Jetpack: apply upward BodyVelocity burst\n\t\t-- Teammate throw logic handled client-side via JetpackThrow RemoteEvent\n\t\tlocal bv = Instance.new(\"BodyVelocity\")\n\t\tbv.Velocity  = Vector3.new(0, 80, 0)\n\t\tbv.MaxForce  = Vector3.new(0, 1e5, 0)\n\t\tbv.Parent    = hrp\n\t\tgame:GetService(\"Debris\"):AddItem(bv, 0.4)\n\n\t\t-- Duration: keep jetpack active\n\t\tlocal active = true\n\t\ttask.delay(cfg.duration, function() active = false end)\n\n\t\t-- Hover assist while active\n\t\ttask.spawn(function()\n\t\t\tlocal startT = tick()\n\t\t\twhile active and tick() - startT < cfg.duration do\n\t\t\t\tif hrp and hrp.Parent then\n\t\t\t\t\tlocal vel = hrp.AssemblyLinearVelocity\n\t\t\t\t\tif vel.Y < -10 then\n\t\t\t\t\t\tlocal assist = Instance.new(\"BodyVelocity\")\n\t\t\t\t\t\tassist.Velocity = Vector3.new(vel.X, -5, vel.Z)\n\t\t\t\t\t\tassist.MaxForce = Vector3.new(0, 1e4, 0)\n\t\t\t\t\t\tassist.Parent   = hrp\n\t\t\t\t\t\tgame:GetService(\"Debris\"):AddItem(assist, 0.1)\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\t\ttask.wait(0.1)\n\t\t\tend\n\t\tend)\n\n\telseif item == \"CLOAK\" then\n\t\t-- Cloak: invisibility + invincibility\n\t\tfor _, part in ipairs(char:GetDescendants()) do\n\t\t\tif part:IsA(\"BasePart\") and part.Name ~= \"HumanoidRootPart\" then\n\t\t\t\tpart.Transparency = 0.85\n\t\t\tend\n\t\tend\n\t\thum:SetAttribute(\"OMC_Cloaked\", true)\n\n\t\ttask.delay(cfg.duration, function()\n\t\t\tif not char.Parent then return end\n\t\t\tfor _, part in ipairs(char:GetDescendants()) do\n\t\t\t\tif part:IsA(\"BasePart\") and part.Name ~= \"HumanoidRootPart\" then\n\t\t\t\t\tpart.Transparency = 0\n\t\t\t\tend\n\t\t\tend\n\t\t\thum:SetAttribute(\"OMC_Cloaked\", false)\n\t\t\tprint(string.format(\"[INVENTORY] %s cloak expired\", player.Name))\n\t\tend)\n\n\telseif item == \"SPITBALL\" then\n\t\t-- Spitball: grant 3 charges, handled via SpitballFire RemoteEvent\n\t\tlocal current = hum:GetAttribute(\"OMC_SpitballCharges\") or 0\n\t\thum:SetAttribute(\"OMC_SpitballCharges\", current + 3)\n\t\tprint(string.format(\"[INVENTORY] %s has %d spitball charges\", player.Name, current + 3))\n\tend\nend)\n\n-- ── Heal handler — player-to-player only ──────────────────────────────────────\n\nHealRequest.OnServerEvent:Connect(function(healer, targetPlayer)\n\tif healer == targetPlayer then return end\n\n\tlocal healerChar = healer.Character\n\tlocal healerHRP  = healerChar and healerChar:FindFirstChild(\"HumanoidRootPart\")\n\tlocal targetChar = targetPlayer and targetPlayer.Character\n\tlocal targetHRP  = targetChar and targetChar:FindFirstChild(\"HumanoidRootPart\")\n\tlocal targetHum  = targetChar and targetChar:FindFirstChildOfClass(\"Humanoid\")\n\n\tif not (healerHRP and targetHRP and targetHum) then return end\n\n\t-- Must be within 10 studs to heal\n\tlocal dist = (healerHRP.Position - targetHRP.Position).Magnitude\n\tif dist > 10 then\n\t\tprint(string.format(\"[INVENTORY] %s too far to heal %s (%.1f studs)\", healer.Name, targetPlayer.Name, dist))\n\t\treturn\n\tend\n\n\t-- Only heal if target is in danger zone (below 30% health)\n\tlocal pct = targetHum.Health / targetHum.MaxHealth\n\tif pct > 0.3 then\n\t\tprint(string.format(\"[INVENTORY] %s health not critical (%.0f%%)\", targetPlayer.Name, pct * 100))\n\t\treturn\n\tend\n\n\tlocal healAmount = targetHum.MaxHealth * 0.4  -- heal to ~70%\n\ttargetHum.Health = math.min(targetHum.MaxHealth, targetHum.Health + healAmount)\n\n\tHealEffect:FireClient(healer,    \"healer\", targetPlayer.Name)\n\tHealEffect:FireClient(targetPlayer, \"receiver\", healer.Name)\n\n\tprint(string.format(\"[INVENTORY] %s healed %s (+%.0f HP)\", healer.Name, targetPlayer.Name, healAmount))\nend)\n\n-- ── Cleanup on player leave ───────────────────────────────────────────────────\n\nPlayers.PlayerRemoving:Connect(function(player)\n\tinventory[player] = nil\nend)\n\nprint(\"[INVENTORY] Service initialized — 3-slot inventory, player-to-player healing only\")\n"}},"contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
{"timestamp":"2026-05-07T07:52:05.411Z","type":"write","direction":"forward","source":"studio","path":"game.ServerScriptService.InventoryService~4","details":"props","contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
{"timestamp":"2026-05-07T07:52:05.412Z","type":"write","direction":"forward","source":"studio","path":"game.ServerScriptService.InventoryService~4","details":"script:Script","diff":{"type":"script","scriptMeta":{"beforeLines":null,"afterLines":292},"scriptDiff":{"beforeSource":null,"afterSource":"-- =============================================================================\n-- InventoryService\n-- 3-slot inventory system. Power-ups spawn at randomized map points and\n-- respawn after use. Players pick up by touching. Server-authoritative.\n--\n-- Power-ups: JETPACK | CLOAK | SPITBALL | HEAL\n-- Healing is player-to-player only — no healing pickups exist.\n-- =============================================================================\n\nlocal Players         = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService      = game:GetService(\"RunService\")\n\n-- ── Config ────────────────────────────────────────────────────────────────────\n\nlocal POWERUP_TYPES = { \"JETPACK\", \"CLOAK\", \"SPITBALL\" }\n\nlocal POWERUP_CFG = {\n\tJETPACK  = { color = BrickColor.new(\"Bright orange\"),  duration = 20,  respawnDelay = 15 },\n\tCLOAK    = { color = BrickColor.new(\"Electric blue\"),  duration = 10,  respawnDelay = 20 },\n\tSPITBALL = { color = BrickColor.new(\"Bright green\"),   duration = 0,   respawnDelay = 10 }, -- duration=0 = uses charges\n}\n\nlocal INVENTORY_SIZE = 3\n\n-- Spawn zone: randomized points within the arena bounds\n-- Centered around (1012, 58, 1007) — lobby/arena center\nlocal ARENA_CENTER = Vector3.new(1012, 62, 1007)\nlocal ARENA_RADIUS = 40  -- studs from center, keeps pickups on the floor\n\n-- ── RemoteEvents setup ────────────────────────────────────────────────────────\n\nlocal function ensureFolder(parent, name)\n\tlocal f = parent:FindFirstChild(name)\n\tif not f then\n\t\tf = Instance.new(\"Folder\")\n\t\tf.Name = name\n\t\tf.Parent = parent\n\tend\n\treturn f\nend\n\nlocal omcFolder   = ensureFolder(ReplicatedStorage, \"OMC\")\nlocal eventsFolder = ensureFolder(omcFolder, \"Events\")\n\nlocal function getOrCreateRemote(name, class)\n\tlocal existing = eventsFolder:FindFirstChild(name)\n\tif existing then return existing end\n\tlocal r = Instance.new(class)\n\tr.Name   = name\n\tr.Parent = eventsFolder\n\treturn r\nend\n\nlocal InventoryUpdate  = getOrCreateRemote(\"InventoryUpdate\",  \"RemoteEvent\")  -- server→client\nlocal UseItem          = getOrCreateRemote(\"UseItem\",          \"RemoteEvent\")  -- client→server\nlocal HealRequest      = getOrCreateRemote(\"HealRequest\",      \"RemoteEvent\")  -- client→server\nlocal HealEffect       = getOrCreateRemote(\"HealEffect\",       \"RemoteEvent\")  -- server→client\n\n-- ── Player inventory state ────────────────────────────────────────────────────\n\n-- inventory[player] = { [1]=item|nil, [2]=item|nil, [3]=item|nil }\nlocal inventory = {}\n\nlocal function getInventory(player)\n\tif not inventory[player] then\n\t\tinventory[player] = { nil, nil, nil }\n\tend\n\treturn inventory[player]\nend\n\nlocal function firstEmptySlot(player)\n\tlocal inv = getInventory(player)\n\tfor i = 1, INVENTORY_SIZE do\n\t\tif not inv[i] then return i end\n\tend\n\treturn nil\nend\n\nlocal function addItem(player, itemType)\n\tlocal slot = firstEmptySlot(player)\n\tif not slot then return false end\n\tgetInventory(player)[slot] = itemType\n\tInventoryUpdate:FireClient(player, getInventory(player))\n\treturn true\nend\n\nlocal function removeItem(player, slot)\n\tgetInventory(player)[slot] = nil\n\tInventoryUpdate:FireClient(player, getInventory(player))\nend\n\n-- ── Pickup spawning ───────────────────────────────────────────────────────────\n\nlocal pickupFolder = ensureFolder(workspace, \"PowerupPickups\")\n\nlocal function randomArenaPoint()\n\tlocal angle  = math.random() * math.pi * 2\n\tlocal radius = math.random() * ARENA_RADIUS\n\treturn Vector3.new(\n\t\tARENA_CENTER.X + math.cos(angle) * radius,\n\t\tARENA_CENTER.Y,\n\t\tARENA_CENTER.Z + math.sin(angle) * radius\n\t)\nend\n\nlocal function spawnPickup(itemType)\n\tlocal cfg = POWERUP_CFG[itemType]\n\n\tlocal part = Instance.new(\"Part\")\n\tpart.Name        = \"Pickup_\" .. itemType\n\tpart.Size        = Vector3.new(2, 2, 2)\n\tpart.Shape       = Enum.PartType.Ball\n\tpart.BrickColor  = cfg.color\n\tpart.Material    = Enum.Material.Neon\n\tpart.Anchored    = true\n\tpart.CanCollide  = false\n\tpart.CFrame      = CFrame.new(randomArenaPoint())\n\tpart.Parent      = pickupFolder\n\n\t-- Spin effect\n\tlocal spin = Instance.new(\"BodyAngularVelocity\")\n\tspin.AngularVelocity = Vector3.new(0, 2, 0)\n\tspin.MaxTorque       = Vector3.new(0, 1e4, 0)\n\tspin.Parent          = part\n\n\t-- Label\n\tlocal billboard = Instance.new(\"BillboardGui\")\n\tbillboard.Size        = UDim2.new(0, 80, 0, 30)\n\tbillboard.StudsOffset = Vector3.new(0, 2, 0)\n\tbillboard.AlwaysOnTop = false\n\tbillboard.Parent      = part\n\tlocal label = Instance.new(\"TextLabel\", billboard)\n\tlabel.Size            = UDim2.new(1, 0, 1, 0)\n\tlabel.BackgroundTransparency = 1\n\tlabel.Text            = itemType\n\tlabel.TextColor3      = Color3.new(1, 1, 1)\n\tlabel.TextScaled      = true\n\tlabel.Font            = Enum.Font.GothamBold\n\n\t-- Touch to collect\n\tpart.Touched:Connect(function(hit)\n\t\tlocal char = hit.Parent\n\t\tif not char then return end\n\t\tlocal player = Players:GetPlayerFromCharacter(char)\n\t\tif not player then return end\n\t\tif not part.Parent then return end  -- already collected\n\n\t\tlocal added = addItem(player, itemType)\n\t\tif added then\n\t\t\tpart:Destroy()\n\t\t\tprint(string.format(\"[INVENTORY] %s picked up %s\", player.Name, itemType))\n\t\t\t-- Respawn after delay\n\t\t\ttask.delay(cfg.respawnDelay, function()\n\t\t\t\tspawnPickup(itemType)\n\t\t\tend)\n\t\tend\n\tend)\n\n\treturn part\nend\n\n-- ── Initial spawn — one of each type at random points ────────────────────────\n\ntask.wait(2)  -- let world finish loading\n\nfor _, itemType in ipairs(POWERUP_TYPES) do\n\tspawnPickup(itemType)\nend\n\nprint(\"[INVENTORY] Power-up spawner active —\", #POWERUP_TYPES, \"pickups in world\")\n\n-- ── Use item handler ──────────────────────────────────────────────────────────\n\nUseItem.OnServerEvent:Connect(function(player, slot)\n\tlocal inv = getInventory(player)\n\tlocal item = inv[slot]\n\tif not item then return end\n\n\tlocal char = player.Character\n\tlocal hrp  = char and char:FindFirstChild(\"HumanoidRootPart\")\n\tlocal hum  = char and char:FindFirstChildOfClass(\"Humanoid\")\n\tif not (char and hrp and hum) then return end\n\n\tlocal cfg = POWERUP_CFG[item]\n\n\tprint(string.format(\"[INVENTORY] %s used %s (slot %d)\", player.Name, item, slot))\n\tremoveItem(player, slot)\n\n\tif item == \"JETPACK\" then\n\t\t-- Jetpack: apply upward BodyVelocity burst\n\t\t-- Teammate throw logic handled client-side via JetpackThrow RemoteEvent\n\t\tlocal bv = Instance.new(\"BodyVelocity\")\n\t\tbv.Velocity  = Vector3.new(0, 80, 0)\n\t\tbv.MaxForce  = Vector3.new(0, 1e5, 0)\n\t\tbv.Parent    = hrp\n\t\tgame:GetService(\"Debris\"):AddItem(bv, 0.4)\n\n\t\t-- Duration: keep jetpack active\n\t\tlocal active = true\n\t\ttask.delay(cfg.duration, function() active = false end)\n\n\t\t-- Hover assist while active\n\t\ttask.spawn(function()\n\t\t\tlocal startT = tick()\n\t\t\twhile active and tick() - startT < cfg.duration do\n\t\t\t\tif hrp and hrp.Parent then\n\t\t\t\t\tlocal vel = hrp.AssemblyLinearVelocity\n\t\t\t\t\tif vel.Y < -10 then\n\t\t\t\t\t\tlocal assist = Instance.new(\"BodyVelocity\")\n\t\t\t\t\t\tassist.Velocity = Vector3.new(vel.X, -5, vel.Z)\n\t\t\t\t\t\tassist.MaxForce = Vector3.new(0, 1e4, 0)\n\t\t\t\t\t\tassist.Parent   = hrp\n\t\t\t\t\t\tgame:GetService(\"Debris\"):AddItem(assist, 0.1)\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\t\ttask.wait(0.1)\n\t\t\tend\n\t\tend)\n\n\telseif item == \"CLOAK\" then\n\t\t-- Cloak: invisibility + invincibility\n\t\tfor _, part in ipairs(char:GetDescendants()) do\n\t\t\tif part:IsA(\"BasePart\") and part.Name ~= \"HumanoidRootPart\" then\n\t\t\t\tpart.Transparency = 0.85\n\t\t\tend\n\t\tend\n\t\thum:SetAttribute(\"OMC_Cloaked\", true)\n\n\t\ttask.delay(cfg.duration, function()\n\t\t\tif not char.Parent then return end\n\t\t\tfor _, part in ipairs(char:GetDescendants()) do\n\t\t\t\tif part:IsA(\"BasePart\") and part.Name ~= \"HumanoidRootPart\" then\n\t\t\t\t\tpart.Transparency = 0\n\t\t\t\tend\n\t\t\tend\n\t\t\thum:SetAttribute(\"OMC_Cloaked\", false)\n\t\t\tprint(string.format(\"[INVENTORY] %s cloak expired\", player.Name))\n\t\tend)\n\n\telseif item == \"SPITBALL\" then\n\t\t-- Spitball: grant 3 charges, handled via SpitballFire RemoteEvent\n\t\tlocal current = hum:GetAttribute(\"OMC_SpitballCharges\") or 0\n\t\thum:SetAttribute(\"OMC_SpitballCharges\", current + 3)\n\t\tprint(string.format(\"[INVENTORY] %s has %d spitball charges\", player.Name, current + 3))\n\tend\nend)\n\n-- ── Heal handler — player-to-player only ──────────────────────────────────────\n\nHealRequest.OnServerEvent:Connect(function(healer, targetPlayer)\n\tif healer == targetPlayer then return end\n\n\tlocal healerChar = healer.Character\n\tlocal healerHRP  = healerChar and healerChar:FindFirstChild(\"HumanoidRootPart\")\n\tlocal targetChar = targetPlayer and targetPlayer.Character\n\tlocal targetHRP  = targetChar and targetChar:FindFirstChild(\"HumanoidRootPart\")\n\tlocal targetHum  = targetChar and targetChar:FindFirstChildOfClass(\"Humanoid\")\n\n\tif not (healerHRP and targetHRP and targetHum) then return end\n\n\t-- Must be within 10 studs to heal\n\tlocal dist = (healerHRP.Position - targetHRP.Position).Magnitude\n\tif dist > 10 then\n\t\tprint(string.format(\"[INVENTORY] %s too far to heal %s (%.1f studs)\", healer.Name, targetPlayer.Name, dist))\n\t\treturn\n\tend\n\n\t-- Only heal if target is in danger zone (below 30% health)\n\tlocal pct = targetHum.Health / targetHum.MaxHealth\n\tif pct > 0.3 then\n\t\tprint(string.format(\"[INVENTORY] %s health not critical (%.0f%%)\", targetPlayer.Name, pct * 100))\n\t\treturn\n\tend\n\n\tlocal healAmount = targetHum.MaxHealth * 0.4  -- heal to ~70%\n\ttargetHum.Health = math.min(targetHum.MaxHealth, targetHum.Health + healAmount)\n\n\tHealEffect:FireClient(healer,    \"healer\", targetPlayer.Name)\n\tHealEffect:FireClient(targetPlayer, \"receiver\", healer.Name)\n\n\tprint(string.format(\"[INVENTORY] %s healed %s (+%.0f HP)\", healer.Name, targetPlayer.Name, healAmount))\nend)\n\n-- ── Cleanup on player leave ───────────────────────────────────────────────────\n\nPlayers.PlayerRemoving:Connect(function(player)\n\tinventory[player] = nil\nend)\n\nprint(\"[INVENTORY] Service initialized — 3-slot inventory, player-to-player healing only\")\n"}},"contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
{"timestamp":"2026-05-07T07:52:23.043Z","type":"write","direction":"forward","source":"studio","path":"game.ServerScriptService.SpitballService","details":"props","contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
{"timestamp":"2026-05-07T07:52:23.080Z","type":"write","direction":"forward","source":"studio","path":"game.ServerScriptService.SpitballService","details":"script:Script","diff":{"type":"script","scriptMeta":{"beforeLines":null,"afterLines":140},"scriptDiff":{"beforeSource":null,"afterSource":"-- =============================================================================\n-- SpitballService\n-- Handles spitball projectile firing. Arcing projectile, AOE on impact.\n-- Damages enemies only (no PvP). Consumes OMC_SpitballCharges attribute.\n-- =============================================================================\n\nlocal Players    = game:GetService(\"Players\")\nlocal Debris     = game:GetService(\"Debris\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal SPITBALL_CFG = {\n\tspeed      = 60,    -- studs/s launch speed\n\tgravity    = 35,    -- arc gravity\n\tradius     = 6,     -- AOE blast radius studs\n\tdamage     = 45,    -- damage per hit\n\tsize       = 1.2,   -- ball size\n\tlifetime   = 8,     -- seconds before cleanup\n}\n\nlocal function ensureRemote(name, class)\n\tlocal evts = ReplicatedStorage:FindFirstChild(\"OMC\")\n\t\tand ReplicatedStorage.OMC:FindFirstChild(\"Events\")\n\tif not evts then return end\n\tlocal r = evts:FindFirstChild(name)\n\tif r then return r end\n\tr = Instance.new(class)\n\tr.Name = name\n\tr.Parent = evts\n\treturn r\nend\n\n-- Wait for OMC events folder\nlocal eventsFolder\nlocal attempts = 0\nrepeat\n\ttask.wait(0.5)\n\tattempts += 1\n\tlocal omc = ReplicatedStorage:FindFirstChild(\"OMC\")\n\teventsFolder = omc and omc:FindFirstChild(\"Events\")\nuntil eventsFolder or attempts > 20\n\nif not eventsFolder then\n\twarn(\"[SPITBALL] Events folder not found — service aborted\")\n\treturn\nend\n\nlocal SpitballFire = Instance.new(\"RemoteEvent\")\nSpitballFire.Name   = \"SpitballFire\"\nSpitballFire.Parent = eventsFolder\n\nSpitballFire.OnServerEvent:Connect(function(player, origin, direction)\n\tlocal char = player.Character\n\tlocal hum  = char and char:FindFirstChildOfClass(\"Humanoid\")\n\tif not hum then return end\n\n\t-- Check charges\n\tlocal charges = hum:GetAttribute(\"OMC_SpitballCharges\") or 0\n\tif charges <= 0 then return end\n\thum:SetAttribute(\"OMC_SpitballCharges\", charges - 1)\n\n\t-- Create projectile\n\tlocal ball = Instance.new(\"Part\")\n\tball.Name        = \"Spitball\"\n\tball.Shape       = Enum.PartType.Ball\n\tball.Size        = Vector3.new(SPITBALL_CFG.size, SPITBALL_CFG.size, SPITBALL_CFG.size)\n\tball.BrickColor  = BrickColor.new(\"Bright green\")\n\tball.Material    = Enum.Material.Neon\n\tball.Transparency = 0.2\n\tball.CanCollide  = true\n\tball.Anchored    = false\n\tball.CFrame      = CFrame.new(origin)\n\tball.Parent      = workspace\n\n\tDebris:AddItem(ball, SPITBALL_CFG.lifetime)\n\n\t-- Launch with arc\n\tlocal bv = Instance.new(\"BodyVelocity\")\n\tbv.Velocity  = direction.Unit * SPITBALL_CFG.speed\n\tbv.MaxForce  = Vector3.new(1e4, 1e4, 1e4)\n\tbv.Parent    = ball\n\n\t-- Apply gravity arc\n\tlocal bg = Instance.new(\"BodyForce\")\n\tbg.Force  = Vector3.new(0, -workspace.Gravity * ball:GetMass() * (SPITBALL_CFG.gravity / workspace.Gravity), 0)\n\tbg.Parent = ball\n\n\tlocal hit = false\n\tball.Touched:Connect(function(other)\n\t\tif hit then return end\n\t\t-- Ignore the shooter\n\t\tif other:IsDescendantOf(char) then return end\n\t\t-- Ignore other players\n\t\tlocal otherPlayer = Players:GetPlayerFromCharacter(other.Parent)\n\t\tif otherPlayer then return end\n\n\t\thit = true\n\t\tball:Destroy()\n\n\t\t-- AOE blast — damage all enemies within radius\n\t\tlocal blastPos = ball.Position\n\t\tfor _, obj in ipairs(workspace:GetDescendants()) do\n\t\t\tif obj:IsA(\"Humanoid\") and obj.Health > 0 then\n\t\t\t\tlocal rootPart = obj.Parent and obj.Parent:FindFirstChild(\"HumanoidRootPart\")\n\t\t\t\tif rootPart then\n\t\t\t\t\tlocal dist = (rootPart.Position - blastPos).Magnitude\n\t\t\t\t\tif dist <= SPITBALL_CFG.radius then\n\t\t\t\t\t\t-- Don't damage players\n\t\t\t\t\t\tlocal isPlayer = false\n\t\t\t\t\t\tfor _, p in ipairs(Players:GetPlayers()) do\n\t\t\t\t\t\t\tif p.Character == obj.Parent then\n\t\t\t\t\t\t\t\tisPlayer = true\n\t\t\t\t\t\t\t\tbreak\n\t\t\t\t\t\t\tend\n\t\t\t\t\t\tend\n\t\t\t\t\t\tif not isPlayer then\n\t\t\t\t\t\t\tobj:TakeDamage(SPITBALL_CFG.damage)\n\t\t\t\t\t\t\tprint(string.format(\"[SPITBALL] Hit %s for %d damage\", obj.Parent.Name, SPITBALL_CFG.damage))\n\t\t\t\t\t\tend\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\n\t\t-- Visual blast effect\n\t\tlocal blast = Instance.new(\"Part\")\n\t\tblast.Shape       = Enum.PartType.Ball\n\t\tblast.Size        = Vector3.new(SPITBALL_CFG.radius * 2, SPITBALL_CFG.radius * 2, SPITBALL_CFG.radius * 2)\n\t\tblast.Anchored    = true\n\t\tblast.CanCollide  = false\n\t\tblast.Material    = Enum.Material.Neon\n\t\tblast.BrickColor  = BrickColor.new(\"Bright green\")\n\t\tblast.Transparency = 0.5\n\t\tblast.CFrame      = CFrame.new(blastPos)\n\t\tblast.Parent      = workspace\n\t\tDebris:AddItem(blast, 0.3)\n\tend)\nend)\n\nprint(\"[SPITBALL] Service initialized\")\n"}},"contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
{"timestamp":"2026-05-07T07:52:26.663Z","type":"write","direction":"forward","source":"studio","path":"game.ServerScriptService.SpitballService~2","details":"props","contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
{"timestamp":"2026-05-07T07:52:26.664Z","type":"write","direction":"forward","source":"studio","path":"game.ServerScriptService.SpitballService~2","details":"script:Script","diff":{"type":"script","scriptMeta":{"beforeLines":null,"afterLines":140},"scriptDiff":{"beforeSource":null,"afterSource":"-- =============================================================================\n-- SpitballService\n-- Handles spitball projectile firing. Arcing projectile, AOE on impact.\n-- Damages enemies only (no PvP). Consumes OMC_SpitballCharges attribute.\n-- =============================================================================\n\nlocal Players    = game:GetService(\"Players\")\nlocal Debris     = game:GetService(\"Debris\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal SPITBALL_CFG = {\n\tspeed      = 60,    -- studs/s launch speed\n\tgravity    = 35,    -- arc gravity\n\tradius     = 6,     -- AOE blast radius studs\n\tdamage     = 45,    -- damage per hit\n\tsize       = 1.2,   -- ball size\n\tlifetime   = 8,     -- seconds before cleanup\n}\n\nlocal function ensureRemote(name, class)\n\tlocal evts = ReplicatedStorage:FindFirstChild(\"OMC\")\n\t\tand ReplicatedStorage.OMC:FindFirstChild(\"Events\")\n\tif not evts then return end\n\tlocal r = evts:FindFirstChild(name)\n\tif r then return r end\n\tr = Instance.new(class)\n\tr.Name = name\n\tr.Parent = evts\n\treturn r\nend\n\n-- Wait for OMC events folder\nlocal eventsFolder\nlocal attempts = 0\nrepeat\n\ttask.wait(0.5)\n\tattempts += 1\n\tlocal omc = ReplicatedStorage:FindFirstChild(\"OMC\")\n\teventsFolder = omc and omc:FindFirstChild(\"Events\")\nuntil eventsFolder or attempts > 20\n\nif not eventsFolder then\n\twarn(\"[SPITBALL] Events folder not found — service aborted\")\n\treturn\nend\n\nlocal SpitballFire = Instance.new(\"RemoteEvent\")\nSpitballFire.Name   = \"SpitballFire\"\nSpitballFire.Parent = eventsFolder\n\nSpitballFire.OnServerEvent:Connect(function(player, origin, direction)\n\tlocal char = player.Character\n\tlocal hum  = char and char:FindFirstChildOfClass(\"Humanoid\")\n\tif not hum then return end\n\n\t-- Check charges\n\tlocal charges = hum:GetAttribute(\"OMC_SpitballCharges\") or 0\n\tif charges <= 0 then return end\n\thum:SetAttribute(\"OMC_SpitballCharges\", charges - 1)\n\n\t-- Create projectile\n\tlocal ball = Instance.new(\"Part\")\n\tball.Name        = \"Spitball\"\n\tball.Shape       = Enum.PartType.Ball\n\tball.Size        = Vector3.new(SPITBALL_CFG.size, SPITBALL_CFG.size, SPITBALL_CFG.size)\n\tball.BrickColor  = BrickColor.new(\"Bright green\")\n\tball.Material    = Enum.Material.Neon\n\tball.Transparency = 0.2\n\tball.CanCollide  = true\n\tball.Anchored    = false\n\tball.CFrame      = CFrame.new(origin)\n\tball.Parent      = workspace\n\n\tDebris:AddItem(ball, SPITBALL_CFG.lifetime)\n\n\t-- Launch with arc\n\tlocal bv = Instance.new(\"BodyVelocity\")\n\tbv.Velocity  = direction.Unit * SPITBALL_CFG.speed\n\tbv.MaxForce  = Vector3.new(1e4, 1e4, 1e4)\n\tbv.Parent    = ball\n\n\t-- Apply gravity arc\n\tlocal bg = Instance.new(\"BodyForce\")\n\tbg.Force  = Vector3.new(0, -workspace.Gravity * ball:GetMass() * (SPITBALL_CFG.gravity / workspace.Gravity), 0)\n\tbg.Parent = ball\n\n\tlocal hit = false\n\tball.Touched:Connect(function(other)\n\t\tif hit then return end\n\t\t-- Ignore the shooter\n\t\tif other:IsDescendantOf(char) then return end\n\t\t-- Ignore other players\n\t\tlocal otherPlayer = Players:GetPlayerFromCharacter(other.Parent)\n\t\tif otherPlayer then return end\n\n\t\thit = true\n\t\tball:Destroy()\n\n\t\t-- AOE blast — damage all enemies within radius\n\t\tlocal blastPos = ball.Position\n\t\tfor _, obj in ipairs(workspace:GetDescendants()) do\n\t\t\tif obj:IsA(\"Humanoid\") and obj.Health > 0 then\n\t\t\t\tlocal rootPart = obj.Parent and obj.Parent:FindFirstChild(\"HumanoidRootPart\")\n\t\t\t\tif rootPart then\n\t\t\t\t\tlocal dist = (rootPart.Position - blastPos).Magnitude\n\t\t\t\t\tif dist <= SPITBALL_CFG.radius then\n\t\t\t\t\t\t-- Don't damage players\n\t\t\t\t\t\tlocal isPlayer = false\n\t\t\t\t\t\tfor _, p in ipairs(Players:GetPlayers()) do\n\t\t\t\t\t\t\tif p.Character == obj.Parent then\n\t\t\t\t\t\t\t\tisPlayer = true\n\t\t\t\t\t\t\t\tbreak\n\t\t\t\t\t\t\tend\n\t\t\t\t\t\tend\n\t\t\t\t\t\tif not isPlayer then\n\t\t\t\t\t\t\tobj:TakeDamage(SPITBALL_CFG.damage)\n\t\t\t\t\t\t\tprint(string.format(\"[SPITBALL] Hit %s for %d damage\", obj.Parent.Name, SPITBALL_CFG.damage))\n\t\t\t\t\t\tend\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\n\t\t-- Visual blast effect\n\t\tlocal blast = Instance.new(\"Part\")\n\t\tblast.Shape       = Enum.PartType.Ball\n\t\tblast.Size        = Vector3.new(SPITBALL_CFG.radius * 2, SPITBALL_CFG.radius * 2, SPITBALL_CFG.radius * 2)\n\t\tblast.Anchored    = true\n\t\tblast.CanCollide  = false\n\t\tblast.Material    = Enum.Material.Neon\n\t\tblast.BrickColor  = BrickColor.new(\"Bright green\")\n\t\tblast.Transparency = 0.5\n\t\tblast.CFrame      = CFrame.new(blastPos)\n\t\tblast.Parent      = workspace\n\t\tDebris:AddItem(blast, 0.3)\n\tend)\nend)\n\nprint(\"[SPITBALL] Service initialized\")\n"}},"contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
{"timestamp":"2026-05-07T07:52:29.674Z","type":"write","direction":"forward","source":"studio","path":"game.ServerScriptService.SpitballService~3","details":"props","contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
{"timestamp":"2026-05-07T07:52:29.675Z","type":"write","direction":"forward","source":"studio","path":"game.ServerScriptService.SpitballService~3","details":"script:Script","diff":{"type":"script","scriptMeta":{"beforeLines":null,"afterLines":140},"scriptDiff":{"beforeSource":null,"afterSource":"-- =============================================================================\n-- SpitballService\n-- Handles spitball projectile firing. Arcing projectile, AOE on impact.\n-- Damages enemies only (no PvP). Consumes OMC_SpitballCharges attribute.\n-- =============================================================================\n\nlocal Players    = game:GetService(\"Players\")\nlocal Debris     = game:GetService(\"Debris\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal SPITBALL_CFG = {\n\tspeed      = 60,    -- studs/s launch speed\n\tgravity    = 35,    -- arc gravity\n\tradius     = 6,     -- AOE blast radius studs\n\tdamage     = 45,    -- damage per hit\n\tsize       = 1.2,   -- ball size\n\tlifetime   = 8,     -- seconds before cleanup\n}\n\nlocal function ensureRemote(name, class)\n\tlocal evts = ReplicatedStorage:FindFirstChild(\"OMC\")\n\t\tand ReplicatedStorage.OMC:FindFirstChild(\"Events\")\n\tif not evts then return end\n\tlocal r = evts:FindFirstChild(name)\n\tif r then return r end\n\tr = Instance.new(class)\n\tr.Name = name\n\tr.Parent = evts\n\treturn r\nend\n\n-- Wait for OMC events folder\nlocal eventsFolder\nlocal attempts = 0\nrepeat\n\ttask.wait(0.5)\n\tattempts += 1\n\tlocal omc = ReplicatedStorage:FindFirstChild(\"OMC\")\n\teventsFolder = omc and omc:FindFirstChild(\"Events\")\nuntil eventsFolder or attempts > 20\n\nif not eventsFolder then\n\twarn(\"[SPITBALL] Events folder not found — service aborted\")\n\treturn\nend\n\nlocal SpitballFire = Instance.new(\"RemoteEvent\")\nSpitballFire.Name   = \"SpitballFire\"\nSpitballFire.Parent = eventsFolder\n\nSpitballFire.OnServerEvent:Connect(function(player, origin, direction)\n\tlocal char = player.Character\n\tlocal hum  = char and char:FindFirstChildOfClass(\"Humanoid\")\n\tif not hum then return end\n\n\t-- Check charges\n\tlocal charges = hum:GetAttribute(\"OMC_SpitballCharges\") or 0\n\tif charges <= 0 then return end\n\thum:SetAttribute(\"OMC_SpitballCharges\", charges - 1)\n\n\t-- Create projectile\n\tlocal ball = Instance.new(\"Part\")\n\tball.Name        = \"Spitball\"\n\tball.Shape       = Enum.PartType.Ball\n\tball.Size        = Vector3.new(SPITBALL_CFG.size, SPITBALL_CFG.size, SPITBALL_CFG.size)\n\tball.BrickColor  = BrickColor.new(\"Bright green\")\n\tball.Material    = Enum.Material.Neon\n\tball.Transparency = 0.2\n\tball.CanCollide  = true\n\tball.Anchored    = false\n\tball.CFrame      = CFrame.new(origin)\n\tball.Parent      = workspace\n\n\tDebris:AddItem(ball, SPITBALL_CFG.lifetime)\n\n\t-- Launch with arc\n\tlocal bv = Instance.new(\"BodyVelocity\")\n\tbv.Velocity  = direction.Unit * SPITBALL_CFG.speed\n\tbv.MaxForce  = Vector3.new(1e4, 1e4, 1e4)\n\tbv.Parent    = ball\n\n\t-- Apply gravity arc\n\tlocal bg = Instance.new(\"BodyForce\")\n\tbg.Force  = Vector3.new(0, -workspace.Gravity * ball:GetMass() * (SPITBALL_CFG.gravity / workspace.Gravity), 0)\n\tbg.Parent = ball\n\n\tlocal hit = false\n\tball.Touched:Connect(function(other)\n\t\tif hit then return end\n\t\t-- Ignore the shooter\n\t\tif other:IsDescendantOf(char) then return end\n\t\t-- Ignore other players\n\t\tlocal otherPlayer = Players:GetPlayerFromCharacter(other.Parent)\n\t\tif otherPlayer then return end\n\n\t\thit = true\n\t\tball:Destroy()\n\n\t\t-- AOE blast — damage all enemies within radius\n\t\tlocal blastPos = ball.Position\n\t\tfor _, obj in ipairs(workspace:GetDescendants()) do\n\t\t\tif obj:IsA(\"Humanoid\") and obj.Health > 0 then\n\t\t\t\tlocal rootPart = obj.Parent and obj.Parent:FindFirstChild(\"HumanoidRootPart\")\n\t\t\t\tif rootPart then\n\t\t\t\t\tlocal dist = (rootPart.Position - blastPos).Magnitude\n\t\t\t\t\tif dist <= SPITBALL_CFG.radius then\n\t\t\t\t\t\t-- Don't damage players\n\t\t\t\t\t\tlocal isPlayer = false\n\t\t\t\t\t\tfor _, p in ipairs(Players:GetPlayers()) do\n\t\t\t\t\t\t\tif p.Character == obj.Parent then\n\t\t\t\t\t\t\t\tisPlayer = true\n\t\t\t\t\t\t\t\tbreak\n\t\t\t\t\t\t\tend\n\t\t\t\t\t\tend\n\t\t\t\t\t\tif not isPlayer then\n\t\t\t\t\t\t\tobj:TakeDamage(SPITBALL_CFG.damage)\n\t\t\t\t\t\t\tprint(string.format(\"[SPITBALL] Hit %s for %d damage\", obj.Parent.Name, SPITBALL_CFG.damage))\n\t\t\t\t\t\tend\n\t\t\t\t\tend\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\n\t\t-- Visual blast effect\n\t\tlocal blast = Instance.new(\"Part\")\n\t\tblast.Shape       = Enum.PartType.Ball\n\t\tblast.Size        = Vector3.new(SPITBALL_CFG.radius * 2, SPITBALL_CFG.radius * 2, SPITBALL_CFG.radius * 2)\n\t\tblast.Anchored    = true\n\t\tblast.CanCollide  = false\n\t\tblast.Material    = Enum.Material.Neon\n\t\tblast.BrickColor  = BrickColor.new(\"Bright green\")\n\t\tblast.Transparency = 0.5\n\t\tblast.CFrame      = CFrame.new(blastPos)\n\t\tblast.Parent      = workspace\n\t\tDebris:AddItem(blast, 0.3)\n\tend)\nend)\n\nprint(\"[SPITBALL] Service initialized\")\n"}},"contextId":"ctx_c4971d6c6c9d4e6a8341d82dee6f38be"}
