_408785"},{"siblingIndex":1,"path":"game.VisualizationModeService.Pathfinding.PathfindingLinks","name":"PathfindingLinks","className":"VisualizationMode","parent":"game.VisualizationModeService.Pathfinding","sessionDebugId":"0_408786"},{"siblingIndex":1,"path":"game.MeshContentProvider","name":"MeshContentProvider","className":"MeshContentProvider","parent":"game","sessionDebugId":"0_404160"},{"siblingIndex":1,"path":"game.Lighting","name":"Lighting","className":"Lighting","parent":"game","sessionDebugId":"0_404161"},{"siblingIndex":1,"path":"game.SolidModelContentProvider","name":"SolidModelContentProvider","className":"SolidModelContentProvider","parent":"game","sessionDebugId":"0_404163"},{"siblingIndex":1,"path":"game.HSRDataContentProvider","name":"HSRDataContentProvider","className":"HSRDataContentProvider","parent":"game","sessionDebugId":"0_404164"},{"siblingIndex":1,"path":"game.VideoService","name":"VideoService","className":"VideoService","parent":"game","sessionDebugId":"0_404165"},{"siblingIndex":1,"path":"game.HapticService","name":"HapticService","className":"HapticService","parent":"game","sessionDebugId":"0_404215"},{"siblingIndex":1,"path":"game.GamepadService","name":"GamepadService","className":"GamepadService","parent":"game","sessionDebugId":"0_404774"},{"siblingIndex":1,"path":"game.UIDragDetectorService","name":"UIDragDetectorService","className":"UIDragDetectorService","parent":"game","sessionDebugId":"0_404922"},{"siblingIndex":1,"path":"game.TextBoxService","name":"TextBoxService","className":"TextBoxService","parent":"game","sessionDebugId":"0_404934"},{"siblingIndex":1,"path":"game.ControllerService","name":"ControllerService","className":"ControllerService","parent":"game","sessionDebugId":"0_404935"},{"siblingIndex":1,"path":"game.ControllerService.Instance","name":"Instance","className":"HumanoidController","parent":"game.ControllerService","sessionDebugId":"0_404936"},{"siblingIndex":1,"path":"game.UGCValidationService","name":"UGCValidationService","className":"UGCValidationService","parent":"game","sessionDebugId":"0_405385"},{"siblingIndex":1,"path":"game.ProximityPromptService","name":"ProximityPromptService","className":"ProximityPromptService","parent":"game","sessionDebugId":"0_405564"},{"siblingIndex":1,"path":"game.GroupService","name":"GroupService","className":"GroupService","parent":"game","sessionDebugId":"0_405566"},{"siblingIndex":1,"path":"game.SerializationService","name":"SerializationService","className":"SerializationService","parent":"game","sessionDebugId":"0_405578"},{"siblingIndex":5,"path":"game.FilteredSelection","name":"FilteredSelection","className":"","parent":"game","sessionDebugId":"0_417311"}],"proFallback":{"executedCommand":"query_instances_children","requestedCommand":"workspace_state_snapshot","alternatives":["query_instances_children"]},"outcomeStatus":"fallback","requestedCommand":"workspace_state_snapshot","executedCommand":"query_instances_children","alternatives":["query_instances_children"]},"executionTimeMs":102}
{"id":"29110490-bb5b-4b52-8f5f-e1da01f1a6fa","sessionId":"B1B1-42FB","placeId":0,"placeName":"WeppyRobloxMCP.rbxm","timestamp":"2026-05-07T06:38:10.332Z","sequenceNumber":5,"tool":"manage_scripts","command":"manage_scripts_get_source","tier":"basic","parameters":{"path":"game.ServerScriptService.SOVEREIGN_MANIFEST.high_fid_lizard_enemy"},"result":{"lineCount":83,"source":"-- Metadata for Audit\nlocal ASSET_HASH = \"k9j8h7g6f5e4d3c2b1a0\"  -- SHA-256 placeholder (hash this script to verify)\nprint(\"Generated High-Fid 3D Lizard Enemy. Audit hash: \" .. ASSET_HASH)\n\n-- Create model\nlocal model = Instance.new(\"Model\")\nmodel.Name = \"HighFidJackedLizard\"\nmodel.Parent = workspace\n\n-- Colors\nlocal skinColor = Color3.fromRGB(0, 100, 0)  -- Green skin\nlocal eyeColor = Color3.fromRGB(255, 0, 0)   -- Red eyes\nlocal clawColor = Color3.fromRGB(255, 255, 255)  -- White claws\nlocal muscleColor = Color3.fromRGB(0, 80, 0)  -- Darker green for muscle definition\n\n-- Helper to create part\nlocal function createPart(name, size, position, color, parent, shape)\n    local part = Instance.new(\"Part\")\n    part.Name = name\n    part.Size = size\n    part.Position = position\n    part.Color = color\n    part.Anchored = true\n    part.Shape = shape or Enum.PartType.Block\n    part.Parent = parent\n    return part\nend\n\n-- Helper to weld\nlocal function weld(part1, part2)\n    local weld = Instance.new(\"WeldConstraint\")\n    weld.Part0 = part1\n    weld.Part1 = part2\n    weld.Parent = part1\nend\n\n-- Torso (cylinder for bulk)\nlocal torso = createPart(\"Torso\", Vector3.new(4, 6, 3), Vector3.new(0, 6, 0), skinColor, model, Enum.PartType.Cylinder)\n\n-- Head (block with ball for jaw)\nlocal head = createPart(\"Head\", Vector3.new(3, 2, 2.5), Vector3.new(0, 9, 0), skinColor, model)\nlocal jaw = createPart(\"Jaw\", Vector3.new(2.5, 1, 2), Vector3.new(0, 8, 1), skinColor, head, Enum.PartType.Ball)\nweld(head, jaw)\n\n-- Eyes (small balls)\nlocal leftEye = createPart(\"LeftEye\", Vector3.new(0.5, 0.5, 0.5), Vector3.new(-1, 9.5, 0.5), eyeColor, head, Enum.PartType.Ball)\nlocal rightEye = createPart(\"RightEye\", Vector3.new(0.5, 0.5, 0.5), Vector3.new(1, 9.5, 0.5), eyeColor, head, Enum.PartType.Ball)\nweld(head, leftEye)\nweld(head, rightEye)\n\n-- Muscular Arms (cylinders for biceps, blocks for forearms)\nlocal leftBicep = createPart(\"LeftBicep\", Vector3.new(2, 2, 2), Vector3.new(-3, 7, 0), muscleColor, model, Enum.PartType.Cylinder)\nlocal leftForearm = createPart(\"LeftForearm\", Vector3.new(1.5, 4, 1.5), Vector3.new(-4, 4, 0), skinColor, leftBicep)\nweld(torso, leftBicep)\nweld(leftBicep, leftForearm)\n\nlocal rightBicep = createPart(\"RightBicep\", Vector3.new(2, 2, 2), Vector3.new(3, 7, 0), muscleColor, model, Enum.PartType.Cylinder)\nlocal rightForearm = createPart(\"RightForearm\", Vector3.new(1.5, 4, 1.5), Vector3.new(4, 4, 0), skinColor, rightBicep)\nweld(torso, rightBicep)\nweld(rightBicep, rightForearm)\n\n-- Claws (wedges for sharp look)\nlocal leftClaw = createPart(\"LeftClaw\", Vector3.new(0.5, 1, 0.5), Vector3.new(-4, 0, 0), clawColor, leftForearm, Enum.PartType.Wedge)\nlocal rightClaw = createPart(\"RightClaw\", Vector3.new(0.5, 1, 0.5), Vector3.new(4, 0, 0), clawColor, rightForearm, Enum.PartType.Wedge)\nweld(leftForearm, leftClaw)\nweld(rightForearm, rightClaw)\n\n-- Muscular Legs (cylinders for thighs, blocks for calves)\nlocal leftThigh = createPart(\"LeftThigh\", Vector3.new(2.5, 3, 2), Vector3.new(-1.5, 3.5, 0), muscleColor, model, Enum.PartType.Cylinder)\nlocal leftCalf = createPart(\"LeftCalf\", Vector3.new(2, 3, 2), Vector3.new(-1.5, 0.5, 0), skinColor, leftThigh)\nweld(torso, leftThigh)\nweld(leftThigh, leftCalf)\n\nlocal rightThigh = createPart(\"RightThigh\", Vector3.new(2.5, 3, 2), Vector3.new(1.5, 3.5, 0), muscleColor, model, Enum.PartType.Cylinder)\nlocal rightCalf = createPart(\"RightCalf\", Vector3.new(2, 3, 2), Vector3.new(1.5, 0.5, 0), skinColor, rightThigh)\nweld(torso, rightThigh)\nweld(rightThigh, rightCalf)\n\n-- Foot Claws (wedges)\nlocal leftFootClaw = createPart(\"LeftFootClaw\", Vector3.new(0.8, 1.5, 0.8), Vector3.new(-1.5, -1, 0), clawColor, leftCalf, Enum.PartType.Wedge)\nlocal rightFootClaw = createPart(\"RightFootClaw\", Vector3.new(0.8, 1.5, 0.8), Vector3.new(1.5, -1, 0), clawColor, rightCalf, Enum.PartType.Wedge)\nweld(leftCalf, leftFootClaw)\nweld(rightCalf, rightFootClaw)\n\n-- Tail (tapered cylinders)\nlocal tailBase = createPart(\"TailBase\", Vector3.new(1.5, 4, 1.5), Vector3.new(0, 2, -1), skinColor, model, Enum.PartType.Cylinder)\ntailBase.Orientation = Vector3.new(0, 0, -30)\nlocal tailTip = createPart(\"TailTip\", Vector3.new(1, 3, 1), Vector3.new(0, -1, -2), skinColor, tailBase, Enum.PartType.Cylinder)\ntailTip.Orientation = Vector3.new(0, 0, -45)\nweld(torso, tailBase)\nweld(tailBase, tailTip)\n\n-- Procedural Scales (small balls dotted on body)\nfor i = 1, 100 do\n    local scale = createPart(\"Scale\" .. i, Vector3.new(0.2, 0.2, 0.1), Vector3.new(math.random(-2, 2), math.random(0, 10), math.random(-1, 1)), Color3.fromRGB(0, 77, 0), torso, Enum.PartType.Ball)\n    weld(torso, scale)\nend\n\nprint(\"High-Fid 3D Jacked Lizard Enemy spawned at (0,6,0). Muscular Komodo anthro with scales, claws, tail, and procedural details.\")\n","scriptType":"Script"},"executionTimeMs":2}
{"id":"f4c26d0b-aa7a-477c-bd80-b044e92495c6","sessionId":"B1B1-42FB","placeId":0,"placeName":"WeppyRobloxMCP.rbxm","timestamp":"2026-05-07T06:38:10.917Z","sequenceNumber":6,"tool":"manage_scripts","command":"manage_scripts_get_source","tier":"basic","parameters":{"path":"game.ServerScriptService.CreateCrawlerTitanMonster"},"result":{"lineCount":88,"source":"-- Runs once at server start.\n-- Finds character models from Workspace and ServerStorage/bitebynitecharacters,\n-- clones them into ServerStorage/MonsterTemplates for VictimService.\n\nlocal ENABLE_TEMPLATE_IMPORT_ON_BOOT = false\nif not ENABLE_TEMPLATE_IMPORT_ON_BOOT then\n\treturn\nend\n\nlocal ServerStorage = game:GetService(\"ServerStorage\")\nlocal Workspace = game:GetService(\"Workspace\")\n\ntask.wait(1) -- let Workspace finish populating\n\nlocal function ensureFolder(parent, name)\n\tlocal f = parent:FindFirstChild(name)\n\tif f and f:IsA(\"Folder\") then return f end\n\tf = Instance.new(\"Folder\")\n\tf.Name = name\n\tf.Parent = parent\n\treturn f\nend\n\nlocal function looksLikeCharacter(model)\n\tif not model:IsA(\"Model\") then return false end\n\treturn model:FindFirstChildOfClass(\"Humanoid\") ~= nil\n\t\tor model:FindFirstChild(\"HumanoidRootPart\") ~= nil\n\t\tor model:FindFirstChild(\"Head\") ~= nil\nend\n\nlocal candidates = {}\n\nlocal function addCandidate(model)\n\tif not looksLikeCharacter(model) then\n\t\treturn\n\tend\n\tfor _, existing in ipairs(candidates) do\n\t\tif existing == model then\n\t\t\treturn\n\t\tend\n\tend\n\ttable.insert(candidates, model)\nend\n\n-- 1. Pull models from Workspace.\nfor _, child in ipairs(Workspace:GetChildren()) do\n\tif child:IsA(\"Model\") and (child.Name == \"Model\" or child.Name == \"Models\") then\n\t\taddCandidate(child)\n\tend\n\n\tif child:IsA(\"Folder\") and child.Name:lower() == \"models\" then\n\t\tfor _, sub in ipairs(child:GetDescendants()) do\n\t\t\tif sub:IsA(\"Model\") then\n\t\t\t\taddCandidate(sub)\n\t\t\tend\n\t\tend\n\tend\nend\nprint(string.format(\"[MONSTERS] Found %d workspace model candidate(s).\", #candidates))\n\n-- 2. Fallback: pull numbered sub-models from ServerStorage.bitebynitecharacters\nif #candidates == 0 then\n\tlocal source = ServerStorage:FindFirstChild(\"bitebynitecharacters\")\n\tif source then\n\t\tfor _, child in ipairs(source:GetChildren()) do\n\t\t\taddCandidate(child)\n\t\tend\n\tend\n\tprint(string.format(\"[MONSTERS] Fallback: found %d model(s) in bitebynitecharacters.\", #candidates))\nend\n\nif #candidates == 0 then\n\twarn(\"[MONSTERS] No character models found. Blocky fallback will be used.\")\n\treturn\nend\n\n-- 3. Populate MonsterTemplates\nlocal templates = ensureFolder(ServerStorage, \"MonsterTemplates\")\nfor _, child in ipairs(templates:GetChildren()) do\n\tchild:Destroy()\nend\n\nfor i, model in ipairs(candidates) do\n\tlocal clone = model:Clone()\n\tclone.Name = \"BiteBynite_\" .. i\n\t-- Ensure Humanoid present\n\tif not clone:FindFirstChildOfClass(\"Humanoid\") then\n\t\tlocal hum = Instance.new(\"Humanoid\")\n\t\thum.MaxHealth = 260\n\t\thum.Health = 260\n\t\thum.Parent = clone\n\tend\n\t-- Ensure PrimaryPart is set to HumanoidRootPart if present\n\tlocal hrp = clone:FindFirstChild(\"HumanoidRootPart\")\n\tif hrp then\n\t\tclone.PrimaryPart = hrp\n\tend\n\tclone.Parent = templates\n\tprint(string.format(\"[MONSTERS] Template %d loaded from Workspace.\", i))\nend\n\nprint(string.format(\"[MONSTERS] %d template(s) ready in MonsterTemplates.\", #candidates))\n","scriptType":"Script"},"executionTimeMs":2}
{"id":"151317f7-1632-4283-aa12-565aa59cecc2","sessionId":"B1B1-42FB","placeId":0,"placeName":"WeppyRobloxMCP.rbxm","timestamp":"2026-05-07T06:40:14.109Z","sequenceNumber":7,"tool":"manage_scripts","command":"manage_scripts_create","contextId":"ctx_0319ba43ecb94324b08945ae48a15a42","tier":"basic","parameters":{"name":"Primer_R6EnemyChassis","parent":"game.ServerScriptService.SOVEREIGN_MANIFEST","scriptType":"Script","source":"-- =============================================================================\n-- Primer_R6EnemyChassis\n-- Rebuilds the R6 enemy rig primer from free Marketplace assets.\n-- Pulls a humanoid R6 rig, configures it as a combat-ready enemy chassis,\n-- and registers it in ServerStorage.MonsterTemplates for VictimService.\n--\n-- AERIAL_HAWK_PRESET note:\n--   Set ARCHETYPE = \"aerial\" to apply wing physics offsets and disable\n--   Humanoid.WalkSpeed (aerial enemies use BodyVelocity instead).\n-- =============================================================================\n\nlocal ENABLE_ON_BOOT = false   -- flip to true when you want it to run\nif not ENABLE_ON_BOOT then return end\n\n-- ── Config ────────────────────────────────────────────────────────────────────\n\nlocal ARCHETYPES = {\n\tground = {\n\t\tname               = \"Primer_Ground_R6\",\n\t\tmaxHealth          = 200,\n\t\twalkSpeed          = 16,\n\t\tuseBodyVelocity    = false,\n\t\tmarketplaceAssetId = 0,   -- 0 = blocky fallback\n\t},\n\taerial = {\n\t\tname               = \"Primer_Aerial_R6\",\n\t\tmaxHealth          = 120,\n\t\twalkSpeed          = 0,   -- BodyVelocity drives movement, NOT WalkSpeed\n\t\tuseBodyVelocity    = true,\n\t\tmarketplaceAssetId = 0,   -- fill with real asset ID once sourced\n\t\thoverHeight        = 18,\n\t\tdiveSpeed          = 60,\n\t},\n}\n\nlocal ARCHETYPE = \"aerial\"   -- swap to \"ground\" for ground chassis\n\n-- ── Services ──────────────────────────────────────────────────────────────────\n\nlocal InsertService = game:GetService(\"InsertService\")\nlocal ServerStorage = game:GetService(\"ServerStorage\")\n\n-- ── Helpers ───────────────────────────────────────────────────────────────────\n\nlocal function ensureFolder(parent, name)\n\tlocal f = parent:FindFirstChild(name)\n\tif f and f:IsA(\"Folder\") then return f end\n\tf = Instance.new(\"Folder\")\n\tf.Name = name\n\tf.Parent = parent\n\treturn f\nend\n\nlocal function buildBlockyR6Fallback(cfg)\n\tlocal model = Instance.new(\"Model\")\n\tmodel.Name  = cfg.name\n\n\tlocal function part(name, size, cframe, color)\n\t\tlocal p = Instance.new(\"Part\")\n\t\tp.Name       = name\n\t\tp.Size       = size\n\t\tp.CFrame     = cframe\n\t\tp.BrickColor = BrickColor.new(color or \"Medium stone grey\")\n\t\tp.Anchored   = false\n\t\tp.CanCollide = true\n\t\tp.Parent     = model\n\t\treturn p\n\tend\n\n\tlocal function weld(p0, p1)\n\t\tlocal w = Instance.new(\"WeldConstraint\")\n\t\tw.Part0  = p0\n\t\tw.Part1  = p1\n\t\tw.Parent = p0\n\tend\n\n\tlocal root  = part(\"HumanoidRootPart\", Vector3.new(2,2,1), CFrame.new(0,5,0), \"Bright blue\")\n\tlocal torso = part(\"Torso\",            Vector3.new(2,2,1), CFrame.new(0,5,0))\n\tlocal head  = part(\"Head\",             Vector3.new(2,1,1), CFrame.new(0,6.5,0))\n\tlocal lArm  = part(\"Left Arm\",         Vector3.new(1,2,1), CFrame.new(-1.5,5,0))\n\tlocal rArm  = part(\"Right Arm\",        Vector3.new(1,2,1), CFrame.new(1.5,5,0))\n\tlocal lLeg  = part(\"Left Leg\",         Vector3.new(1,2,1), CFrame.new(-0.5,3,0))\n\tlocal rLeg  = part(\"Right Leg\",        Vector3.new(1,2,1), CFrame.new(0.5,3,0))\n\n\tweld(root, torso); weld(torso, head)\n\tweld(torso, lArm); weld(torso, rArm)\n\tweld(torso, lLeg); weld(torso, rLeg)\n\n\tif cfg.useBodyVelocity then\n\t\tlocal lWing = part(\"Wing_L\", Vector3.new(4,0.3,2), CFrame.new(-3,5,0), \"Bright yellow\")\n\t\tlocal rWing = part(\"Wing_R\", Vector3.new(4,0.3,2), CFrame.new(3,5,0),  \"Bright yellow\")\n\t\tlWing.Transparency = 0.4\n\t\trWing.Transparency = 0.4\n\t\tweld(torso, lWing)\n\t\tweld(torso, rWing)\n\n\t\t-- BodyVelocity: aerial drive (WalkSpeed is NOT used for aerial enemies)\n\t\tlocal bv = Instance.new(\"BodyVelocity\")\n\t\tbv.Name     = \"AerialDrive\"\n\t\tbv.Velocity = Vector3.new(0,0,0)\n\t\tbv.MaxForce = Vector3.new(1e4,1e4,1e4)\n\t\tbv.Parent   = root\n\n\t\t-- BodyGyro: holds orientation during flight\n\t\tlocal bg = Instance.new(\"BodyGyro\")\n\t\tbg.Name      = \"AerialGyro\"\n\t\tbg.MaxTorque = Vector3.new(1e5,1e5,1e5)\n\t\tbg.D         = 100\n\t\tbg.Parent    = root\n\tend\n\n\tlocal hum = Instance.new(\"Humanoid\")\n\thum.RigType   = Enum.HumanoidRigType.R6\n\thum.MaxHealth = cfg.maxHealth\n\thum.Health    = cfg.maxHealth\n\thum.WalkSpeed = cfg.walkSpeed\n\thum.Parent    = model\n\n\tmodel.PrimaryPart = root\n\treturn model\nend\n\nlocal function buildFromMarketplace(assetId, cfg)\n\tlocal ok, result = pcall(function()\n\t\treturn InsertService:LoadAsset(assetId)\n\tend)\n\tif not ok then\n\t\twarn(string.format(\"[PRIMER] Marketplace load failed (assetId=%d): %s\", assetId, tostring(result)))\n\t\treturn nil\n\tend\n\tlocal rig = result:FindFirstChildOfClass(\"Model\")\n\tif rig then rig.Parent = nil end\n\tresult:Destroy()\n\tif not rig then\n\t\twarn(\"[PRIMER] No Model inside Marketplace asset — falling back\")\n\t\treturn nil\n\tend\n\n\tlocal hum = rig:FindFirstChildOfClass(\"Humanoid\") or Instance.new(\"Humanoid\", rig)\n\thum.MaxHealth = cfg.maxHealth\n\thum.Health    = cfg.maxHealth\n\thum.WalkSpeed = cfg.walkSpeed\n\thum.RigType   = Enum.HumanoidRigType.R6\n\n\tlocal hrp = rig:FindFirstChild(\"HumanoidRootPart\")\n\tif hrp then\n\t\trig.PrimaryPart = hrp\n\t\tif cfg.useBodyVelocity then\n\t\t\tif not hrp:FindFirstChild(\"AerialDrive\") then\n\t\t\t\tlocal bv = Instance.new(\"BodyVelocity\")\n\t\t\t\tbv.Name = \"AerialDrive\"\n\t\t\t\tbv.Velocity = Vector3.new(0,0,0)\n\t\t\t\tbv.MaxForce = Vector3.new(1e4,1e4,1e4)\n\t\t\t\tbv.Parent = hrp\n\t\t\tend\n\t\t\tif not hrp:FindFirstChild(\"AerialGyro\") then\n\t\t\t\tlocal bg = Instance.new(\"BodyGyro\")\n\t\t\t\tbg.Name = \"AerialGyro\"\n\t\t\t\tbg.MaxTorque = Vector3.new(1e5,1e5,1e5)\n\t\t\t\tbg.D = 100\n\t\t\t\tbg.Parent = hrp\n\t\t\tend\n\t\tend\n\tend\n\n\trig.Name = cfg.name\n\treturn rig\nend\n\n-- ── Main ──────────────────────────────────────────────────────────────────────\n\ntask.wait(1)\n\nlocal cfg = ARCHETYPES[ARCHETYPE]\nassert(cfg, \"[PRIMER] Unknown ARCHETYPE: \" .. tostring(ARCHETYPE))\n\nprint(string.format(\"[PRIMER] Building %s chassis (assetId=%d)…\", cfg.name, cfg.marketplaceAssetId))\n\nlocal rig\nif cfg.marketplaceAssetId and cfg.marketplaceAssetId > 0 then\n\trig = buildFromMarketplace(cfg.marketplaceAssetId, cfg)\nend\nrig = rig or buildBlockyR6Fallback(cfg)\n\nlocal templates = ensureFolder(ServerStorage, \"MonsterTemplates\")\nlocal existing  = templates:FindFirstChild(cfg.name)\nif existing then existing:Destroy() end\nrig.Parent = templates\n\n-- Stamp OMC attributes so VictimService/director can read archetype without parsing script\nrig:SetAttribute(\"OMC_Archetype\",          ARCHETYPE)\nrig:SetAttribute(\"OMC_MaxHealth\",          cfg.maxHealth)\nrig:SetAttribute(\"OMC_UseBodyVelocity\",    cfg.useBodyVelocity or false)\nif cfg.useBodyVelocity then\n\trig:SetAttribute(\"OMC_HoverHeight\", cfg.hoverHeight or 18)\n\trig:SetAttribute(\"OMC_DiveSpeed\",   cfg.diveSpeed   or 60)\nend\nrig:SetAttribute(\"OMC_MarketplaceAssetId\", cfg.marketplaceAssetId or 0)\nrig:SetAttribute(\"OMC_PrimerVersion\",      \"1.0.0\")\n\nprint(string.format(\"[PRIMER] ✓ %s ready in ServerStorage.MonsterTemplates\", cfg.name))\nprint(string.format(\"[PRIMER]   Archetype=%s | Health=%d | BodyVelocity=%s | HoverHeight=%s\",\n\tARCHETYPE, cfg.maxHealth, tostring(cfg.useBodyVelocity),\n\ttostring(cfg.useBodyVelocity and cfg.hoverHeight or \"n/a\")))\n","contextId":"ctx_0319ba43ecb94324b08945ae48a15a42"},"result":{"siblingIndex":1,"path":"game.ServerScriptService.SOVEREIGN_MANIFEST.Primer_R6EnemyChassis","lineCount":174,"className":"Script","sessionDebugId":"0_417904","name":"Primer_R6EnemyChassis","scriptType":"Script"},"executionTimeMs":4}
