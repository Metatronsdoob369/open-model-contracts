{
  "$id": "https://open-model-contracts.dev/schemas/omc.v3.eve-v2.schema.json",
  "$ref": "#/definitions/omc.v3.eve-v2",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "omc.v3.eve-v2": {
      "additionalProperties": false,
      "properties": {
        "auditTrail": {
          "additionalProperties": false,
          "properties": {
            "intentSignature": {
              "description": "Mathematical 3072-D unit vector for cognitive verification.",
              "items": {
                "type": "number"
              },
              "maxItems": 3072,
              "minItems": 3072,
              "type": "array"
            },
            "normStability": {
              "default": 1,
              "description": "L2-normalization check (Survival Requirement).",
              "type": "number"
            },
            "provenanceHash": {
              "description": "Original Domicile Archive reference.",
              "type": "string"
            }
          },
          "required": [
            "intentSignature",
            "provenanceHash"
          ],
          "type": "object"
        },
        "circadianPruning": {
          "additionalProperties": false,
          "properties": {
            "dreamCycleInterval": {
              "default": "3 AM",
              "type": "string"
            },
            "enabled": {
              "default": true,
              "type": "boolean"
            },
            "pruningThreshold": {
              "default": 0.3,
              "description": "Global baseline for pruning.",
              "maximum": 0.5,
              "minimum": 0.1,
              "type": "number"
            },
            "sectorWeights": {
              "additionalProperties": {
                "type": "number"
              },
              "default": {
                "Client_Visual": 0.4,
                "Mock_TestLayer": 0.7,
                "OMC_DataStore_Queue": 0.9,
                "OMC_Governance": 0.98,
                "OMC_Threading": 0.95
              },
              "description": "Domain-specific weights for outcome evaluation (flaw significance).",
              "type": "object"
            },
            "successMetric": {
              "enum": [
                "profit_margin",
                "user_satisfaction",
                "deployment_stability",
                "performance_overhead"
              ],
              "type": "string"
            }
          },
          "required": [
            "successMetric"
          ],
          "type": "object"
        },
        "id": {
          "description": "Stable identifier for the Eve_v2 brain instance.",
          "type": "string"
        },
        "robloxAdmission": {
          "additionalProperties": false,
          "properties": {
            "disallowGlobals": {
              "default": [
                "_G",
                "shared",
                "getfenv",
                "setfenv"
              ],
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "enforceMemorySafety": {
              "default": true,
              "type": "boolean"
            },
            "environment": {
              "const": "ROBLOX_LUAU",
              "type": "string"
            },
            "maxCFrameIterations": {
              "default": 1000,
              "description": "Prevention of infinite orientation loops.",
              "type": "integer"
            },
            "spatialAnchors": {
              "default": [
                "ROOM-01",
                "ROOM-02"
              ],
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "environment"
          ],
          "type": "object"
        },
        "spectralConfig": {
          "additionalProperties": false,
          "properties": {
            "heat_tau": {
              "default": 0.1,
              "description": "Heat kernel spectral filtering constant.",
              "maximum": 0.2,
              "minimum": 0.01,
              "type": "number"
            },
            "hessian_trace_limit": {
              "default": 3,
              "description": "Maximum allowed gradient entropy before SAFE gate halt.",
              "maximum": 5,
              "type": "number"
            },
            "low_k": {
              "default": 12,
              "description": "Number of low-frequency eigenvalues for spectral injection.",
              "maximum": 32,
              "minimum": 5,
              "type": "integer"
            },
            "tau": {
              "default": 0.85,
              "description": "Graph attention dropout threshold.",
              "maximum": 1,
              "minimum": 0.5,
              "type": "number"
            }
          },
          "type": "object"
        },
        "version": {
          "default": "2.1.0",
          "type": "string"
        }
      },
      "required": [
        "id",
        "spectralConfig",
        "robloxAdmission",
        "circadianPruning",
        "auditTrail"
      ],
      "type": "object"
    }
  },
  "description": "Canonical schema for the Eve_v2 SpectralGAT brain. Governs spectral thresholds, Roblox Luau admission rules, and Circadian pruning cycles.",
  "title": "omc.v3.eve-v2",
  "x-omc-capabilities": [
    "read",
    "validate",
    "learn",
    "prune"
  ],
  "x-omc-version": "2.0.0"
}
