{
  "specification": {
    "name": "Roblox Spatial-Relational Constraint Library",
    "version": "1.0.0",
    "author": "Manus AI | Orchestrated by Antigravity",
    "classification": "Diamond-Stable Architecture"
  },
  "constraints": [
    {
      "constraint_id": "SPAWN_FLOOR_SNAP",
      "target_class": "SpawnLocation",
      "reference_class": "BasePart",
      "reference_tags": ["Floor", "Terrain"],
      "constraint_type": "SURFACE_SNAP",
      "parameters": {
        "target_face": "Bottom",
        "reference_face": "Top",
        "humanoid_offset_studs": 3,
        "calculation": "Reference.CFrame * CFrame.new(0, Reference.Size.Y/2 + Target.Size.Y/2 + 3, 0)",
        "raycast": {
          "direction": [0, -1, 0],
          "filter_type": "Exclude"
        }
      },
      "resolution_strategy": "RAYCAST_DOWN_AND_TRANSLATE"
    },
    {
      "constraint_id": "FOLIAGE_TERRAIN_SNAP",
      "target_class": "Model",
      "target_tags": ["Foliage", "Tree", "Bush"],
      "reference_class": "Terrain",
      "constraint_type": "SURFACE_SNAP",
      "parameters": {
        "target_face": "Bottom",
        "reference_face": "Top",
        "tolerance": 0.5,
        "align_to_normal": true
      },
      "resolution_strategy": "RAYCAST_DOWN_AND_ALIGN"
    },
    {
      "constraint_id": "WINDOW_WALL_INSET",
      "target_class": "Model",
      "target_tags": ["Window"],
      "reference_class": "BasePart",
      "reference_tags": ["Wall"],
      "constraint_type": "STRUCTURAL_INSET",
      "parameters": {
        "required_boolean_op": "UnionAsync",
        "negative_part_source": "CloneBoundingBox",
        "destructive_op": true,
        "pre_op_check": "GetExtentsSize"
      },
      "resolution_strategy": "UNION_ASYNC_NEGATION"
    },
    {
      "constraint_id": "FOLIAGE_TERRAIN_SNAP",
      "target_class": "Model",
      "target_tags": ["Foliage", "Tree", "Bush"],
      "reference_class": "Terrain",
      "constraint_type": "SURFACE_SNAP",
      "parameters": {
        "target_face": "Bottom",
        "reference_face": "Top",
        "align_to_normal": true,
        "calculation": "Raycast(Target.Position, Vector3.new(0, -1, 0)) -> translate Target.Y to Hit.Position.Y"
      },
      "resolution_strategy": "RAYCAST_DOWN_AND_ALIGN"
    },
    {
      "constraint_id": "WALL_EDGE_SEAM",
      "target_class": "BasePart",
      "target_tags": ["Wall"],
      "reference_class": "BasePart",
      "reference_tags": ["Wall"],
      "constraint_type": "EDGE_ALIGN",
      "parameters": {
        "max_gap": 0.1,
        "snap_mode": "VertexSnapping",
        "force_extension": true
      },
      "resolution_strategy": "SNAP_CLOSEST_VERTICES"
    }
  ]
}
