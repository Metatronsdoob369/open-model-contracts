{
  "$id": "https://open-model-contracts.dev/schemas/omc.v3.execution-authorization.schema.json",
  "$ref": "#/definitions/omc.v3.execution-authorization",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "omc.v3.execution-authorization": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "description": "Authorization / contract name"
            },
            "gate": {
              "type": "string",
              "const": "SAFE",
              "description": "SAFE observation gate"
            },
            "actionId": {
              "type": "string",
              "minLength": 1,
              "description": "Exact action id being observed"
            },
            "resourceRef": {
              "type": "object",
              "properties": {
                "resourceType": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Exact resource type identifier"
                },
                "resourceId": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Exact resource instance identifier"
                }
              },
              "required": [
                "resourceType",
                "resourceId"
              ],
              "additionalProperties": false,
              "description": "Exact resource under observation"
            },
            "input": {
              "type": "object",
              "additionalProperties": {},
              "default": {},
              "description": "Execution input payload"
            }
          },
          "required": [
            "name",
            "gate",
            "actionId",
            "resourceRef"
          ],
          "additionalProperties": false,
          "description": "SAFE mediated execution authorization"
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "description": "Authorization / contract name"
            },
            "gate": {
              "type": "string",
              "const": "ARMED",
              "description": "ARMED execution gate"
            },
            "actionId": {
              "type": "string",
              "minLength": 1,
              "description": "Exact action id permitted when ARMED"
            },
            "resourceRef": {
              "type": "object",
              "properties": {
                "resourceType": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Exact resource type identifier"
                },
                "resourceId": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Exact resource instance identifier"
                }
              },
              "required": [
                "resourceType",
                "resourceId"
              ],
              "additionalProperties": false,
              "description": "Exact resource permitted when ARMED"
            },
            "expiry": {
              "type": "string",
              "format": "date-time",
              "description": "ISO-8601 expiry; must be in the future at evaluation"
            },
            "owner": {
              "type": "string",
              "minLength": 1,
              "description": "Accountable owner"
            },
            "approval": {
              "type": "object",
              "properties": {
                "approvedBy": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Human or authority identity string"
                },
                "approvedAt": {
                  "type": "string",
                  "format": "date-time",
                  "description": "ISO-8601 approval timestamp"
                },
                "approvalId": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Opaque approval identifier"
                }
              },
              "required": [
                "approvedBy",
                "approvedAt",
                "approvalId"
              ],
              "additionalProperties": false,
              "description": "Structured human approval metadata (not cryptographic identity)"
            },
            "input": {
              "type": "object",
              "additionalProperties": {},
              "default": {},
              "description": "Execution input payload"
            }
          },
          "required": [
            "name",
            "gate",
            "actionId",
            "resourceRef",
            "expiry",
            "owner",
            "approval"
          ],
          "additionalProperties": false,
          "description": "ARMED mediated execution authorization"
        }
      ],
      "description": "OMC mediated execution authorization envelope (v3.1.0)"
    }
  },
  "description": "Canonical SAFE/ARMED authorization envelope (v3.1.0). Discriminated strict forms: both require actionId + exact resourceRef; ARMED structurally requires expiry, owner, and structured approval. Effect facts are not on this envelope — they come from catalog lookup.",
  "title": "omc.v3.execution-authorization",
  "x-omc-capabilities": [
    "read",
    "validate",
    "execute"
  ],
  "x-omc-version": "3.1.0"
}
